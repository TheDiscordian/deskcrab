# DeskCrab configuration
# Copy to ~/.config/deskcrab/deskcrab.conf and edit.

# Required: path to piper-tts voice model (.onnx)
PIPER_VOICE="$HOME/.local/share/piper/en_US-lessac-medium.onnx"

# Optional: piper length scale — controls speech speed.
# 1.0 = default. Lower = faster (e.g. 0.9 ≈ 10% faster). Higher = slower.
# PIPER_LENGTH_SCALE="0.9"

# Optional: piper speaker index — only used for multi-speaker models like libritts.
# Integer index (0-based) into the model's speaker map. Single-speaker models ignore this.
# PIPER_SPEAKER="79"

# Required: path to whisper.cpp model
WHISPER_MODEL="/usr/share/whisper.cpp-model-small.en/ggml-small.en.bin"

# Optional: Claude model and effort level
# CLAUDE_MODEL="opus"
# CLAUDE_EFFORT="low"

# Optional: project directory (Claude runs from here, gets project memory)
# PROJECT_DIR="$HOME"

# Optional: conversation archive directory
# ARCHIVE_DIR="$HOME/.local/share/deskcrab/archive"

# Optional: conversation timeout in seconds before archiving (default: 300 = 5 min)
# CONVO_TIMEOUT=300

# Optional: sliding-window history to keep long conversations cheap.
# Once the live convo exceeds CONVO_MAX_TURNS user/assistant pairs, the oldest
# CONVO_SUMMARIZE_TURNS pairs are folded into a running summary (kept above the
# recent turns) using CONVO_SUMMARY_MODEL. Recent turns stay verbatim.
# CONVO_MAX_TURNS=20
# CONVO_SUMMARIZE_TURNS=10
# CONVO_SUMMARY_MODEL="haiku"

# Optional: custom system prompt file — appended to the core prompt
# Use this for project-specific context, custom instructions, etc.
# CUSTOM_PROMPT="$HOME/.config/deskcrab/custom-prompt.md"

# Optional: whisper transcription fixes (sed expressions applied to transcribed text)
# Useful for proper nouns that whisper consistently gets wrong.
# Example: WHISPER_FIXES='s/mycool app/MyCoolApp/gi; s/\bhy plant\b/Hyprland/gi'
# WHISPER_FIXES=''

# Optional: additional files to include in system prompt context
# Space-separated list of file paths. Their contents are appended to the prompt.
# CONTEXT_FILES="$HOME/project/CLAUDE.md $HOME/project/notes.md"

# Optional: assistant persona name (default: Crab)
# The name the assistant sees in its system prompt: "You are <name>, a desktop
# voice assistant...". Set this to rename the assistant (e.g. "Beatrice",
# "Jarvis", etc). Also used as the notification/display title unless
# NOTIFY_NAME is set separately.
# ASSISTANT_NAME="Beatrice"

# Optional: assistant display name (default: ASSISTANT_NAME if set, else DeskCrab)
# Used as the notification title AND the title bar of the markdown display window.
# NOTIFY_NAME="DeskCrab"
