#!/usr/bin/env python3
"""Live viewer for DeskCrab's stream-json debug logs.

EVERY reply she produces has to show up here, in full, as it is produced.
There is no single file that holds them all, and following only the shared one
is how this view came to be missing whole turns:

  desk turn / autonomous wake  -> $STATE_PREFIX-debug.log   (shared, TRUNCATED
                                  at the start of every turn)
  phone turn under `crab serve` -> /tmp/deskcrab-turn-<uuid>.log  (private to
                                  the turn, deleted when it ends)
  `crab remote` with no server  -> $STATE_PREFIX-remote-<pid>.log (same)

The remote logs are private on purpose — a phone turn must never truncate the
log a desk turn's TTS streamer is tailing — so this viewer follows all of them
at once instead. Three things a naive tail gets wrong, all of which silently
ate replies:

  * the shared log is truncated in place at each turn, which strands a read
    cursor past EOF: every following turn is either invisible or resumes
    mid-line as garbage. A cursor beyond the file's size means rewind.
  * a phone turn's log never existed when the viewer started, so the glob is
    re-checked on every poll and new streams are picked up mid-turn.
  * readline() at EOF hands back a HALF-WRITTEN line, and the rest arrives as
    a separate "line" — neither half parses as JSON, so a long assistant block
    (exactly the thing worth watching) disappears. Whole lines only; the
    remainder is held until its newline lands.
"""

import glob
import json
import re
import sys
import time
import os
import textwrap

# Honours DESKCRAB_STATE_PREFIX so a scratch instance (and the test suite) can
# be watched without touching the live one, same as lib/common.sh.
PREFIX = os.environ.get("DESKCRAB_STATE_PREFIX", "/tmp/deskcrab")
LOG = f"{PREFIX}-debug.log"
CONVO = f"{PREFIX}-convo.txt"

# (glob, label) — every stream a reply can be produced into. The label is
# printed when the view switches streams, so it is never ambiguous whether
# what you are reading was said at the desk or to the phone.
SOURCES = [
    (LOG, "desk"),
    (f"{PREFIX}-turn-*.log", "phone"),
    (f"{PREFIX}-remote-*.log", "phone"),
]

# ANSI colors
DIM = "\033[2m"
BOLD = "\033[1m"
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
MAGENTA = "\033[35m"
RESET = "\033[0m"
WHITE = "\033[97m"

INDENT = "      "


def indent_text(s):
    """Indent all lines of a string."""
    return "\n".join(INDENT + line for line in s.splitlines())


def format_tool_input(name, inp):
    """Show the most relevant parts of a tool call's input."""
    if name == "Bash":
        return inp.get("command", "")
    elif name == "WebFetch":
        url = inp.get("url", "")
        prompt = inp.get("prompt", "")
        return f"{url}\n{prompt}" if prompt else url
    elif name == "Read":
        return inp.get("file_path", "")
    elif name == "Write":
        return inp.get("file_path", "")
    elif name == "Edit":
        return inp.get("file_path", "")
    elif name in ("Grep", "Glob"):
        return inp.get("pattern", "")
    elif name == "Agent":
        desc = inp.get("description", "")
        prompt = inp.get("prompt", "")
        return f"{desc}\n{prompt}" if prompt else desc
    elif name == "WebSearch":
        return inp.get("query", "")
    else:
        return json.dumps(inp, ensure_ascii=False, indent=2)


def format_event(line):
    try:
        d = json.loads(line)
    except json.JSONDecodeError:
        return None

    t = d.get("type", "")

    if t == "assistant" and "message" in d:
        msg = d["message"]
        parts = []
        for block in msg.get("content", []):
            if block.get("type") == "tool_use":
                name = block["name"]
                inp = block.get("input", {})
                detail = format_tool_input(name, inp).strip()
                indented = indent_text(detail)
                parts.append(f"  {CYAN}▶ {name}{RESET}\n{DIM}{indented}{RESET}")
            elif block.get("type") == "text":
                text = block["text"].strip()
                if text:
                    wrapped = textwrap.fill(text, width=78, initial_indent="  ", subsequent_indent="  ")
                    parts.append(f"  {WHITE}{wrapped}{RESET}")
        if parts:
            return "\n".join(parts)

    elif t == "tool" and "content" in d:
        content = d["content"]
        if isinstance(content, list):
            text = " ".join(b.get("text", "") for b in content if b.get("type") == "text")
        else:
            text = str(content)
        text = text.strip()
        if text:
            indented = indent_text(text)
            return f"  {DIM}← {RESET}\n{DIM}{indented}{RESET}"

    elif t == "result":
        result = d.get("result", "")
        duration = d.get("duration_ms", 0)
        secs = duration / 1000 if duration else 0
        cost = d.get("total_cost_usd", 0)
        return f"\n{GREEN}{BOLD}✓ Done{RESET} {DIM}({secs:.1f}s · ${cost:.4f}){RESET}\n{WHITE}{result}{RESET}"

    return None


class Stream:
    """One followed stream-json log, read whole-line at a time.

    Survives everything the writers do to a log under a reader's feet: the
    shared log truncated in place at the start of each turn (cursor past EOF —
    rewind), the same path replaced by a different file (inode changed —
    reopen), a private turn log unlinked while still being drained (keep the
    fd, read to EOF, then let it go), and a line still half-written when we
    reach it (hold the remainder until its newline arrives).
    """

    def __init__(self, path, label):
        self.path = path
        self.label = label
        self.fh = open(path, "r", errors="replace")
        self.ino = os.fstat(self.fh.fileno()).st_ino
        self.buf = ""
        self.gone = False   # unlinked or replaced: drain to EOF, then close

    def _check_path(self):
        """Has our path been unlinked, or replaced by a different file?"""
        try:
            st = os.stat(self.path)
        except OSError:
            self.gone = True
            return
        if st.st_ino != self.ino:
            self.gone = True

    def lines(self):
        """Every complete line written since the last call."""
        try:
            size = os.fstat(self.fh.fileno()).st_size
            if size < self.fh.tell():
                # Truncated in place — a new turn is writing from byte zero and
                # our cursor is stranded past the end of it.
                self.fh.seek(0)
                self.buf = ""
            data = self.fh.read()
        except OSError:
            self.gone = True
            return []
        self._check_path()
        if not data:
            return []
        self.buf += data
        *complete, self.buf = self.buf.split("\n")
        return complete

    def finished(self):
        """Closable: the file is gone and nothing is left buffered in it."""
        return self.gone and not self.buf

    def close(self):
        try:
            self.fh.close()
        except OSError:
            pass


def follow():
    """Yield (label, line) from every stream log, live, as they are written."""
    open_streams = {}   # path -> Stream
    while True:
        for pattern, label in SOURCES:
            for path in sorted(glob.glob(pattern)):
                if path in open_streams:
                    continue
                try:
                    open_streams[path] = Stream(path, label)
                except OSError:
                    continue   # vanished between glob and open — nothing to read
        moved_on = []
        for path, stream in list(open_streams.items()):
            for line in stream.lines():
                yield stream.label, line
            # A stream that is gone AND drained is done; a rewritten path is
            # reopened on the next poll by the glob above.
            if stream.finished():
                stream.close()
                moved_on.append(path)
        for path in moved_on:
            del open_streams[path]
        time.sleep(0.05)


def main():
    if not any(glob.glob(p) for p, _ in SOURCES):
        print(f"{DIM}Waiting for Crab...{RESET}")
        while not any(glob.glob(p) for p, _ in SOURCES):
            time.sleep(0.5)

    print(f"{BOLD}Crab Activity{RESET}")
    print(f"{DIM}{'─' * 40}{RESET}\n")

    # Show the last thing Crab heard
    if os.path.exists(CONVO):
        last_heard = ""
        # The header carries an optional local-time stamp ("User [2026-08-07
        # 12:01]: …"); older unstamped lines match the same pattern.
        user_hdr = re.compile(r"^User( \[[^\]]*\])?: ")
        with open(CONVO) as cf:
            for line in cf:
                m = user_hdr.match(line)
                if m:
                    last_heard = line[m.end():].strip()
        if last_heard:
            wrapped = textwrap.fill(last_heard, width=78, initial_indent="  ", subsequent_indent="  ")
            print(f"{YELLOW}{BOLD}Last heard:{RESET}\n{WHITE}{wrapped}{RESET}\n")

    current = None
    for label, line in follow():
        out = format_event(line.strip())
        if not out:
            continue
        if label != current:
            current = label
            print(f"\n{MAGENTA}{BOLD}── {label} ──{RESET}")
        print(out)
        sys.stdout.flush()


if __name__ == "__main__":
    main()
