#!/usr/bin/env python3
"""Live viewer for DeskCrab's stream-json debug logs, and for what was SAID to her.

Two halves, and for a long time only one of them existed.

The reply half. EVERY reply she produces has to show up here, in full, as it is
produced. There is no single file that holds them all, and following only the
shared one is how this view came to be missing whole turns:

  desk turn / autonomous wake  -> $STATE_PREFIX-debug-<pid>.log, with the
                                  well-known $STATE_PREFIX-debug.log as a
                                  SYMLINK to whichever session is talking now
  phone turn under `crab serve` -> $STATE_PREFIX-turn-<uuid>.log  (private to
                                  the turn, deleted when it ends)
  `crab remote` with no server  -> $STATE_PREFIX-remote-<pid>.log (same)

The private logs exist on purpose — a phone turn must never truncate the log a
desk turn's TTS streamer is tailing — so this viewer follows all of them at
once instead. Five things a naive tail gets wrong, all of which cost him words:

  * a phone turn's log never existed when the viewer started, so the globs are
    re-run twice a second and new streams are picked up mid-turn.
  * readline() at EOF hands back a HALF-WRITTEN line, and the rest arrives as
    a separate "line" — neither half parses as JSON, so a long assistant block
    (exactly the thing worth watching) disappears. Whole lines only; the
    remainder is held until its newline lands.
  * a private turn log is unlinked the moment its turn ends, taking the last
    words of the reply with it unless the fd is drained to EOF first.
  * every log that already existed at launch is OLD. Opening them at offset
    zero replayed 101 dead sessions — 3250 lines, 228 finished turns — into a
    2000-line scrollback in under six seconds, evicting the live turn before
    it could be read. Anything already on disk when the viewer starts is
    known at its full length and read no further: this window shows what
    happens FROM NOW ON. It is also not held open — a log nothing has written
    to for a while is watched by its size alone, and reopened at the byte it
    stopped at if it ever grows again. Following all 101 the other way cost
    5 % of a core, all day, to print nothing.
  * a stream is identified by its INODE, never by the path it was found under.
    The well-known name is a symlink and every new turn repoints it; keyed by
    path, the previous session's file was reopened at offset zero the instant
    the symlink moved and its whole turn printed a second time. Keyed by
    inode, the same file found under two names is one stream, and a session
    still writing after another has claimed the symlink keeps its cursor.

The other half is what HE said, and it had never been rendered at all. The
prompt reaches the CLI as argv; the CLI never echoes it, so no stream event
carries it and no branch here could ever have printed it. The one authoritative
record is the conversation file, which every turn path appends to before it
runs, so that file is followed too — its User blocks interleave with the stream
events in the order they arrive, which is the order they happened. It is
rewritten under the reader as well: compaction drops the oldest blocks and
`mv`s a new file into place, rotation carries the whole thing off to the
archive. Both change the file's identity, and neither is new speech, so a
generation change re-reads the file and prints only the blocks that have not
been printed before.
"""

import collections
import glob
import json
import re
import sys
import time
import os
import textwrap

# Honours DESKCRAB_STATE_PREFIX so a scratch instance (and the test suite) can
# be watched without touching the live one, same as lib/common.sh.
PREFIX = os.environ.get("DESKCRAB_STATE_PREFIX", "/tmp/deskcrab")
LOG = f"{PREFIX}-debug.log"
CONVO = f"{PREFIX}-convo.txt"
# session_register writes one file per live session here, named for the pid the
# stream log is also named for — which is how a wake is told from a desk turn.
SESSIONS_DIR = f"{PREFIX}-sessions"

# (glob, label) — every stream a reply can be produced into. The label is the
# fallback; the session registry gives the real one when it can. LOG is a
# symlink to the newest desk/wake session and is globbed anyway: a legacy
# instance still writing a plain file there must not be invisible, and the
# inode keying below makes following both names harmless.
SOURCES = [
    (LOG, "desk"),
    (f"{PREFIX}-debug-*.log", "desk"),
    (f"{PREFIX}-turn-*.log", "phone"),
    (f"{PREFIX}-remote-*.log", "phone"),
]

POLL = 0.05
# How long a stream may be silent before its fd is let go. Waking it costs one
# poll and loses nothing (follow() keeps the offset), so this only has to be
# longer than the gaps inside a live turn. Overridable so the test suite can
# drive the sleep/wake cycle without sitting through two minutes of it.
IDLE_SECS = float(os.environ.get("DESKCRAB_DEBUG_IDLE_SECS", "120"))
# How often the globs are re-run to find streams that did not exist a moment
# ago. Open streams are read every POLL; this is the cost of LOOKING, four
# patterns over a busy /tmp, and at 20 Hz it was most of what the process did.
# A turn that has just started is worth half a second of waiting to notice.
SCAN_EVERY = 0.5

# ANSI colors
DIM = "\033[2m"
BOLD = "\033[1m"
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
MAGENTA = "\033[35m"
RESET = "\033[0m"
WHITE = "\033[97m"

INDENT = "      "
WIDTH = 78

# The conversation block headers, matched with the stamp OPTIONAL — the same
# shape as CONVO_USER_RE / CONVO_BLOCK_RE in lib/common.sh. Every conversation
# written before stamps existed, and every archive of one, must keep parsing:
# a reader that quietly stops matching those loses turns without ever erroring.
USER_HDR_RE = re.compile(r"^User( \[[^\]]*\])?: ")
BLOCK_HDR_RE = re.compile(r"^(User|Assistant)( \[[^\]]*\])?: ")
# Not a block of its own — it introduces the Assistant block under it — but it
# does end a User block.
WAKE_MARK_RE = re.compile(r"^\[Autonomous wake")

# A desk/wake/serverless-remote log is named for the pid of the shell that
# registered the session, so the registry can say which KIND of session it is.
SESSION_PID_RE = re.compile(r"-(?:debug|remote)-(\d+)\.log$")
TURN_ID_RE = re.compile(r"-turn-([0-9A-Za-z]+)\.log$")
SESSION_LABELS = {
    "autonomous wake": "wake",
    "desktop turn": "desk",
    "phone turn": "phone",
}


def indent_text(s):
    """Indent all lines of a string."""
    return "\n".join(INDENT + line for line in s.splitlines())


def clip(text, max_lines=8, max_chars=600):
    """Enough of a tool result to recognise it, never enough to bury the reply."""
    lines = text.splitlines()
    cut = len(lines) > max_lines
    out = "\n".join(lines[:max_lines])
    if len(out) > max_chars:
        out = out[:max_chars]
        cut = True
    return out + (" …" if cut else "")


def format_tool_input(name, inp):
    """Show the most relevant parts of a tool call's input."""
    if name == "Bash":
        return inp.get("command", "")
    elif name == "WebFetch":
        url = inp.get("url", "")
        prompt = inp.get("prompt", "")
        return f"{url}\n{prompt}" if prompt else url
    elif name == "Read":
        return inp.get("file_path", "")
    elif name == "Write":
        return inp.get("file_path", "")
    elif name == "Edit":
        return inp.get("file_path", "")
    elif name in ("Grep", "Glob"):
        return inp.get("pattern", "")
    elif name == "Agent":
        desc = inp.get("description", "")
        prompt = inp.get("prompt", "")
        return f"{desc}\n{prompt}" if prompt else desc
    elif name == "WebSearch":
        return inp.get("query", "")
    else:
        return json.dumps(inp, ensure_ascii=False, indent=2)


def format_event(line):
    try:
        d = json.loads(line)
    except json.JSONDecodeError:
        # NOT nothing. The CLI runs with 2>&1 onto this same fd, so a run that
        # dies outside the JSON protocol — a bad flag, an auth failure, a
        # usage message — arrives here as plain text. Dropped silently, such a
        # turn rendered as a completely blank window, which reads exactly like
        # a turn that never started. 199 such lines were sitting in the live
        # logs, one of them an entire `Usage: claude …` block.
        raw = line.strip()
        if not raw:
            return None
        return f"  {YELLOW}!{RESET} {DIM}{clip(raw, max_lines=4, max_chars=300)}{RESET}"

    t = d.get("type", "")

    if t == "assistant" and "message" in d:
        msg = d["message"]
        parts = []
        for block in msg.get("content", []):
            if block.get("type") == "tool_use":
                name = block["name"]
                inp = block.get("input", {})
                detail = format_tool_input(name, inp).strip()
                indented = indent_text(detail)
                parts.append(f"  {CYAN}▶ {name}{RESET}\n{DIM}{indented}{RESET}")
            elif block.get("type") == "text":
                text = block["text"].strip()
                if text:
                    wrapped = textwrap.fill(text, width=WIDTH, initial_indent="  ", subsequent_indent="  ")
                    parts.append(f"{WHITE}{wrapped}{RESET}")
        if parts:
            return "\n".join(parts)

    elif t == "user" and "message" in d:
        # What came BACK from a tool. The old `t == "tool"` branch here was
        # dead code — the CLI has never emitted that type; every tool result
        # in 10,761 live events arrived as a `user` event, so nothing a tool
        # returned had ever been shown.
        parts = []
        for block in d["message"].get("content", []):
            if block.get("type") != "tool_result":
                continue
            content = block.get("content", "")
            if isinstance(content, list):
                text = "\n".join(b.get("text", "") for b in content if b.get("type") == "text")
            else:
                text = str(content)
            text = text.strip()
            if not text:
                continue
            mark = f"{YELLOW}←!{RESET}" if block.get("is_error") else f"{DIM}←{RESET}"
            parts.append(f"  {mark}\n{DIM}{indent_text(clip(text))}{RESET}")
        if parts:
            return "\n".join(parts)

    elif t == "result":
        result = d.get("result", "")
        duration = d.get("duration_ms", 0)
        secs = duration / 1000 if duration else 0
        cost = d.get("total_cost_usd", 0)
        return f"\n{GREEN}{BOLD}✓ Done{RESET} {DIM}({secs:.1f}s · ${cost:.4f}){RESET}\n{WHITE}{result}{RESET}"

    return None


def session_kind(path):
    """What KIND of session wrote this log, from the live session registry.

    lib/common.sh names a desk/wake log for the pid of the shell that called
    session_register, and that registration is a file of the same name holding
    the kind in its first field. Without this a wake and a desk turn are the
    same `── desk ──` header and there is no way to tell an answer to a
    question from something she decided to do on her own.
    """
    m = SESSION_PID_RE.search(os.path.basename(path))
    if not m:
        return None
    try:
        with open(os.path.join(SESSIONS_DIR, m.group(1)), errors="replace") as fh:
            kind = fh.readline().split("\t")[0].strip()
    except OSError:
        return None
    return SESSION_LABELS.get(kind)


def stream_tag(path):
    """Short identity of the session behind a log, for the source header."""
    base = os.path.basename(path)
    m = SESSION_PID_RE.search(base)
    if m:
        return m.group(1)
    m = TURN_ID_RE.search(base)
    if m:
        return m.group(1)[:6]
    return base


class Stream:
    """One followed stream-json log, read whole-line at a time.

    Survives everything the writers do to a log under a reader's feet: a log
    truncated in place at the start of a turn (cursor past EOF — rewind), the
    NAME it was found under repointed at another session's file (the fd is
    ours, and it is the file that matters, not the name), a private turn log
    unlinked while still being drained (keep the fd, read to EOF, then let it
    go), and a line still half-written when we reach it (hold the remainder
    until its newline arrives).
    """

    def __init__(self, path, label, start=0):
        # The FILE, not the name it was reached by: $PREFIX-debug.log is a
        # symlink that every new turn repoints, and a stream must not be
        # considered gone just because the well-known name now means somebody
        # else. Two sessions run at once often enough — a wake beside a desk
        # turn is the normal case — and both stay readable this way.
        self.path = os.path.realpath(path)
        self.fh = open(self.path, "r", errors="replace")
        st = os.fstat(self.fh.fileno())
        self.key = (st.st_dev, st.st_ino)
        if start:
            self.fh.seek(min(start, st.st_size))
        self.quiet_since = time.monotonic()
        self.buf = ""
        self.gone = False   # unlinked or replaced: drain to EOF, then close
        self.fallback = label
        kind = session_kind(self.path)
        self.label = kind or label
        # Only a pid-named log has a registration to wait for.
        self.resolved = kind is not None or SESSION_PID_RE.search(os.path.basename(self.path)) is None
        self.tag = stream_tag(self.path)

    def _relabel(self):
        """The registration can land microseconds after the log; keep looking."""
        if self.resolved:
            return
        kind = session_kind(self.path)
        if kind:
            self.label = kind
            self.resolved = True

    def _check_path(self):
        """Has our file been unlinked, or replaced by a different one?"""
        try:
            st = os.stat(self.path)
        except OSError:
            self.gone = True
            return
        if (st.st_dev, st.st_ino) != self.key:
            self.gone = True

    def lines(self):
        """Every complete line written since the last call."""
        try:
            size = os.fstat(self.fh.fileno()).st_size
            if size < self.fh.tell():
                # Truncated in place — a new turn is writing from byte zero and
                # our cursor is stranded past the end of it.
                self.fh.seek(0)
                self.buf = ""
            data = self.fh.read()
        except OSError:
            self.gone = True
            return []
        self._check_path()
        if not data:
            return []
        self.quiet_since = time.monotonic()
        self._relabel()
        self.buf += data
        *complete, self.buf = self.buf.split("\n")
        return complete

    def finished(self):
        """Closable: the file is gone and nothing is left buffered in it."""
        return self.gone and not self.buf

    def dozed_off(self):
        """Nothing for a long while, and nothing half-read: let the fd go.

        A finished session's log sits on disk until claim_debuglog reaps it at
        three hours, so a viewer left open all day ends up holding a hundred
        dead files and re-reading every one of them twenty times a second.
        Letting them go is lossless: follow() remembers where each one stood
        and reopens it there the moment its size changes, which is also how a
        long silent session — a build, a long tool call — resumes exactly where
        it left off.
        """
        return not self.gone and not self.buf \
            and time.monotonic() - self.quiet_since > IDLE_SECS

    def offset(self):
        """How far into the file we have read. Only meaningful with an empty buffer."""
        try:
            return self.fh.tell()
        except OSError:
            return 0

    def close(self):
        try:
            self.fh.close()
        except OSError:
            pass


class ConvoTail:
    """The user's own words, followed out of the conversation file.

    This is the only authoritative record of what was said to her: the prompt
    goes to the CLI as argv and comes back in no event, so the stream logs
    cannot carry it and never did. Every turn path — desk, phone, wake
    delivery — appends its blocks here through convo_append_user /
    convo_append_assistant, so following this file is following the exchange.

    The file is rewritten under the reader in two ways, neither of them new
    speech: compaction folds the oldest blocks into the summary and `mv`s the
    remainder into place (new inode, same tail), and rotation carries the whole
    file to the archive so the next turn starts a fresh one. A generation
    change therefore re-reads from the top and prints only blocks it has not
    printed before — which replays nothing after a compaction, and shows the
    first line of a brand new conversation exactly once.
    """

    def __init__(self, path):
        self.path = path
        self.fh = None
        self.key = None
        self.buf = ""
        self.in_user = False
        # The blocks already on screen, as raw lines. Bounded: compaction keeps
        # the live file to CONVO_MAX_TURNS blocks, so the window only has to be
        # deeper than the file can be.
        self.seen = collections.deque(maxlen=4000)

    def _open(self):
        try:
            fh = open(self.path, "r", errors="replace")
        except OSError:
            return False
        st = os.fstat(fh.fileno())
        if self.fh is not None:
            self.fh.close()
        self.fh = fh
        self.key = (st.st_dev, st.st_ino)
        self.buf = ""
        self.in_user = False
        return True

    def _walk(self, lines):
        """Annotate raw lines with the block they belong to.

        Yields (raw, kind, text) where kind is "head" for a User header, "cont"
        for a continuation line of one (the user's text can carry newlines),
        and None for anything belonging to somebody else.
        """
        for raw in lines:
            line = raw.rstrip("\r")
            m = USER_HDR_RE.match(line)
            if m:
                self.in_user = True
                yield line, "head", line[m.end():].strip()
                continue
            if BLOCK_HDR_RE.match(line) or WAKE_MARK_RE.match(line):
                self.in_user = False
                yield line, None, ""
                continue
            yield line, ("cont" if self.in_user else None), line.strip()

    def _take(self, lines, credit=None):
        """The blocks in `lines` that have not been shown yet."""
        out = []
        for raw, kind, text in self._walk(lines):
            if not kind or not text:
                continue
            if credit is not None and credit[raw] > 0:
                credit[raw] -= 1      # same words, already on screen: a rewrite
                continue
            self.seen.append(raw)
            out.append((kind, text))
        return out

    def _regenerate(self):
        """Re-read a file that was replaced or truncated, showing only what is new."""
        if not self._open():
            return []
        data = self.fh.read()
        *complete, self.buf = data.split("\n")
        return self._take(complete, collections.Counter(self.seen))

    def seed(self):
        """Startup: count everything already said as seen, and hand back the last of it."""
        last = None
        for kind, text in self._regenerate():
            if kind == "head":
                last = text
            elif last is not None:
                last = f"{last} {text}"
        return last

    def poll(self):
        """New user blocks since the last call."""
        if self.fh is None:
            # Nothing to follow yet, or the conversation was rotated away and a
            # fresh one has started.
            return self._regenerate() if os.path.exists(self.path) else []
        try:
            size = os.fstat(self.fh.fileno()).st_size
        except OSError:
            return self._regenerate() if os.path.exists(self.path) else []
        try:
            st = os.stat(self.path)
            replaced = (st.st_dev, st.st_ino) != self.key
        except OSError:
            # Rotated to the archive. The next conversation gets a new file,
            # and its first block is genuinely new speech.
            self.fh.close()
            self.fh = None
            return []
        if replaced or size < self.fh.tell():
            return self._regenerate()
        data = self.fh.read()
        if not data:
            return []
        self.buf += data
        *complete, self.buf = self.buf.split("\n")
        return self._take(complete)


def scan(streams, dormant, first_pass):
    """Find streams that were not open a moment ago, and open the ones with news.

    `streams` are being read every poll; `dormant` maps a file's identity to
    the number of bytes of it already accounted for — a log that was on disk
    before the viewer started (all of it: this window is what happens from NOW
    ON) or one that has been quiet long enough to be worth closing. A dormant
    file is watched by its size alone and reopened at that offset the moment it
    changes, which loses nothing and costs no fd.
    """
    alive = set()
    for pattern, label in SOURCES:
        for path in sorted(glob.glob(pattern)):
            try:
                st = os.stat(path)          # follows the symlink on purpose
            except OSError:
                continue                    # vanished between glob and stat
            key = (st.st_dev, st.st_ino)
            alive.add(key)
            if key in streams:
                continue
            if key in dormant:
                if st.st_size == dormant[key]:
                    continue                # still exactly as we left it
                # Grown: resume where we stopped. Shrunk: it was truncated for
                # a new turn, so the file starts again at byte zero.
                start = dormant.pop(key) if st.st_size > dormant[key] else 0
            elif first_pass:
                dormant[key] = st.st_size
                continue
            else:
                start = 0                   # a log created since we started
            try:
                stream = Stream(path, label, start=start)
            except OSError:
                continue                    # vanished between stat and open
            if stream.key in streams:       # raced with the line above
                stream.close()
                continue
            streams[stream.key] = stream
    # A dormant file that has been unlinked is not coming back; a later file
    # that inherits its inode number is a different stream and must be read
    # from the beginning.
    for key in [k for k in dormant if k not in alive]:
        del dormant[key]


def follow(convo):
    """Yield ("user", ...) and ("stream", ...) events, live, as they are written."""
    streams = {}       # (st_dev, st_ino) -> Stream, read every poll
    dormant = {}       # (st_dev, st_ino) -> bytes already accounted for
    first_pass = True
    next_scan = 0.0
    while True:
        now = time.monotonic()
        if now >= next_scan:
            next_scan = now + SCAN_EVERY
            scan(streams, dormant, first_pass)
            first_pass = False

        # His words first: he speaks, then she answers, and that is the order
        # the two sources produce them in.
        for kind, text in convo.poll():
            yield "user", (kind, text)

        for key, stream in list(streams.items()):
            for line in stream.lines():
                yield "stream", (stream, line)
            # A stream that is gone AND drained is done. Its inode is released
            # with it: nothing will glob that file again, and a later file that
            # inherits the number is a different stream and must be followed.
            if stream.finished():
                stream.close()
                del streams[key]
            elif stream.dozed_off():
                dormant[key] = stream.offset()
                stream.close()
                del streams[key]
        time.sleep(POLL)


def main():
    print(f"{BOLD}Crab Activity{RESET}")
    print(f"{DIM}{'─' * 40}{RESET}\n")

    convo = ConvoTail(CONVO)
    last_heard = convo.seed()
    if last_heard:
        wrapped = textwrap.fill(last_heard, width=WIDTH, initial_indent="  ", subsequent_indent="  ")
        print(f"{YELLOW}{BOLD}Last heard:{RESET}\n{WHITE}{wrapped}{RESET}")
    print(f"{DIM}  (watching from here — anything above this line already happened){RESET}\n")
    sys.stdout.flush()

    current = None
    for source, payload in follow(convo):
        if source == "user":
            kind, text = payload
            wrapped = textwrap.fill(text, width=WIDTH, initial_indent="  ", subsequent_indent="  ")
            if kind == "head":
                print(f"\n{YELLOW}{BOLD}❯ you said{RESET}")
            print(f"{YELLOW}{wrapped}{RESET}")
            # The next stream line reprints its own header, so it is never
            # ambiguous who answered.
            current = None
        else:
            stream, line = payload
            out = format_event(line.strip())
            if not out:
                continue
            if current != stream.key:
                current = stream.key
                print(f"\n{MAGENTA}{BOLD}── {stream.label} · {stream.tag} ──{RESET}")
            print(out)
        sys.stdout.flush()


if __name__ == "__main__":
    main()
