#!/bin/bash
# The sandbox's cocoon — specs/test-harness.md rule 3a. Namespaces do not nest
# on this machine: from inside a cocooned session the real bwrap dies at
# "setting up uid map" before it can exec, the stub CLI is never invoked, and
# a suite driving a turn or a wake convicts the account walk of a defect it
# does not have (measured 2026-08-11: test_prompt_profiles 81/4 inside a wrap,
# 85/0 outside, same tree). So the sandbox points COCOON_BWRAP here: strip the
# mount flags cocoon_wrap_build emits and exec the wrapped command. Nothing is
# lost — the CLI behind the wrap is already the spend-gate stub — and the wall
# itself stays proven by tests/test_cocoon_wrap.sh, which opts back into the
# real bubblewrap.
#
# Only the flags cocoon_wrap_build actually emits are understood, on purpose:
# a new flag added to the wrap must land here consciously, not be skipped by a
# glob that guesses its arity wrong and eats the command instead.
while [ $# -gt 0 ]; do
    case "$1" in
        --die-with-parent) shift ;;
        --ro-bind|--bind|--dev-bind) shift 3 ;;
        --*)
            echo "cocoon-passthru: unknown bwrap flag $1 — teach me its arity" >&2
            exit 64 ;;
        *) break ;;
    esac
done
[ $# -gt 0 ] || { echo "cocoon-passthru: nothing left to exec" >&2; exit 64; }
exec "$@"
