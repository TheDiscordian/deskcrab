[Unit]
Description=DeskCrab: notice new meeting transcripts

[Service]
Type=oneshot
ExecStart=%h/.local/lib/deskcrab/notice-newfiles transcriptions %h/Documents/Transcriptions "a new meeting transcript was just saved"
# The wake session runs inside this unit. Same last-resort ceiling as
# deskcrab-wake.service; the stall watchdog does the real reaping.
RuntimeMaxSec=2h
