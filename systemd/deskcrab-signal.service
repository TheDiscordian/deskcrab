[Unit]
Description=DeskCrab Signal daemon (signal-cli, JSON-RPC on a UNIX socket)
Documentation=https://github.com/TheDiscordian/deskcrab/blob/main/specs/signal.md
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Multi-account mode so it starts before any account exists, and manual
# receive so nothing is taken off Signal's servers until the bridge
# subscribes (specs/signal.md rule 1). The socket defaults to
# $XDG_RUNTIME_DIR/signal-cli/socket, which crab signal and the bridge read.
# signal-cli is a separate install, found on PATH (a package, or a build
# linked into ~/.local/bin). Until it exists the unit is skipped, not failed
# in a loop; `crab signal register` starts it (specs/signal.md rule 4b).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/bin/sh -c 'command -v signal-cli'
ExecStart=/usr/bin/env signal-cli daemon --socket --receive-mode manual --no-receive-stdout
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
