[Unit]
Description=DeskCrab: daily liveness check of the self-change watcher

[Timer]
# Late morning, not at boot: the point is to catch a watcher that died during
# ordinary use, and a check that only ever runs on a freshly started manager
# would find it healthy every time.
OnCalendar=11:20
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
