[Unit]
Description=DeskCrab: notice outside changes to the assistant's own files

[Service]
Type=oneshot
ExecStart=%h/.local/lib/deskcrab/notice-selfchange
# When a change survives attribution, the wake session runs inside this unit.
# Same last-resort ceiling as the other notice unit; the stall watchdog does
# the real reaping.
RuntimeMaxSec=2h
