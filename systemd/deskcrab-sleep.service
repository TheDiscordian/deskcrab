[Unit]
Description=DeskCrab nightly sleep — ingest the day into long-term memory

[Service]
Type=oneshot
ExecStart=%h/.local/lib/deskcrab/sleep-nightly run
# User units get a bare PATH, and the ingest shells out to claude (and the
# venv python re-exec) in ~/.local/bin — same reason deskcrab-serve sets it.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# TimeoutStartSec, not RuntimeMaxSec: this is a Type=oneshot service, and the
# journal has been answering RuntimeMaxSec with "has no effect in combination
# with Type=oneshot. Ignoring." A oneshot spends its whole life ACTIVATING, so
# the start timeout is the runtime bound that actually applies.
#
# Sized for the night's work (specs/nightly.md rules 54-61), which runs as
# the night's LAST phase — after the review and the promise sweep — and
# holds the sleep run open from the stamp until its cutoff, 08:00 by default
# against the 03:10 timer: sleeping is an active activity, and the night
# spends its hours on builders. Six hours leaves the whole default window
# plus headroom; raise this too if NIGHT_WORK_CUTOFF moves later, or the
# timeout kills the night's work mid-round (the stamp, the review and the
# sweep are already done by then — the night's work is all a timeout can
# cost).
TimeoutStartSec=21600
# The night-work knobs, all defaulted (lib/night-work's header is the list).
# Set them here or in deskcrab.conf — this script sources lib/common.sh, so
# the conf reaches it either way.
# Environment=NIGHT_WORK_CUTOFF=08:00
# Environment=NIGHT_WORK_CAP=2
