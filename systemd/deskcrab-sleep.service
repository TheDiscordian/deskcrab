[Unit]
Description=DeskCrab nightly sleep — ingest the day into long-term memory

[Service]
Type=oneshot
ExecStart=%h/.local/lib/deskcrab/sleep-nightly run
# User units get a bare PATH, and the ingest shells out to claude (and the
# venv python re-exec) in ~/.local/bin — same reason deskcrab-serve sets it.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# TimeoutStartSec, not RuntimeMaxSec: this is a Type=oneshot service, and the
# journal has been answering RuntimeMaxSec with "has no effect in combination
# with Type=oneshot. Ignoring." A oneshot spends its whole life ACTIVATING, so
# the start timeout is the runtime bound that actually applies.
#
# Sized for the backlog drain (specs/nightly.md rules 54-61), which holds the
# sleep run open from the stamp until its cutoff — 04:00 by default against
# the 03:10 timer — before the promise sweep runs. Two hours leaves the whole
# default window plus headroom; raise this too if BACKLOG_DRAIN_CUTOFF moves
# later, or the timeout kills the night's tail mid-sweep.
TimeoutStartSec=7200
# The drain's knobs, all defaulted (lib/backlog-drain's header is the list).
# Set them here or in deskcrab.conf — this script sources lib/common.sh, so
# the conf reaches it either way.
# Environment=BACKLOG_DRAIN_CUTOFF=04:00
# Environment=BACKLOG_DRAIN_CAP=4
