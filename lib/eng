def cmd_touch(argv):
    if len(argv) < 2:
        die("usage: eng touch <id> <note>")
    rid, note = argv[0], " ".join(argv[1:])
    meta, body = load(rid)
    # The ending gate (rule 15) runs before the write: a note ending at a
    # chore for the user or at "I can't", with no job id attached, earns a
    # builder against this record, and the id lands on this very entry.
    gate_line, gate_job = ending_gate(rid, note)
    note += gate_line
    # One stamp for both writes: the entry's heading and last_touched are the
    # same instant by construction, never a second apart across a boundary.
    stamp = now()
    meta["last_touched"] = stamp
    write(rec_path(rid), meta, add_entry(body, note, stamp))
    print("%s touched %s" % (rid, stamp))
    if gate_line:
        print(gate_line.strip())
    if gate_job:
        # Rule 15b: this very write postdates the dispatch — stamp its epoch
        # on the sidecar so the runner's floor can discount it.
        try:
            epoch = int(time.mktime(time.strptime(stamp, TIMEFMT)))
        except (ValueError, OverflowError):
            epoch = int(time.time())
        _stamp_attach_epoch(gate_job, epoch)


def _close(rid, state, by, verb):
