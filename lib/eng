# --- the wants drawer (kind want, specs/wants.md) ---------------------------

def wants_shelf():
    return os.environ.get("DESKCRAB_WANTS_FILE") or ""


def _shelf_replace(shelf, text):
    """Atomic and declared, like every other write this tool makes."""
    tmp = "%s.tmp.%d" % (shelf, os.getpid())
    declare_write(shelf, tmp)
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, shelf)


def shelf_append(rid, title):
    """Rule 7: the one-line pointer, appended whole, in the shape the one
    shelf reader (wants_titles) already matches. A missing shelf is reported
    and never created — the shelf is hers; the want exists either way."""
    shelf = wants_shelf()
    if not shelf:
        print("no shelf is configured; the want has no shelf line yet")
        return
    if not os.path.isfile(shelf):
        print("the shelf at %s does not exist; not created — the want has "
              "no shelf line yet" % shelf)
        return
    try:
        with open(shelf, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError as e:
        print("could not read the shelf: %s" % e)
        return
    line = "- **%s** → %s.md" % (" ".join(title.split()), rid)
    if text and not text.endswith("\n"):
        text += "\n"
    _shelf_replace(shelf, text + line + "\n")
    print("shelved: %s" % line)


def shelf_remove(rid, title):
    """Rule 11: take the want's own entry line off the shelf — matched by its
    pointer or its bold title, at most ONE line, only an entry line — and hand
    the removed line back so the caller can preserve it verbatim. Returns None
    when there is no shelf or no matching line."""
    shelf = wants_shelf()
    if not shelf or not os.path.isfile(shelf):
        return None
    try:
        with open(shelf, encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines(True)
    except OSError:
        return None
    doc = "→ %s.md" % rid
    removed, kept = None, []
    for ln in lines:
        bare = ln.replace("`", "")
        if removed is None and ln.startswith("- ") and (
                bare.rstrip().endswith(doc) or (doc + " ") in bare
                or (title and "**%s**" % title in ln)):
            removed = ln.rstrip("\n")
            continue
        kept.append(ln)
    if removed is None:
        return None
    _shelf_replace(shelf, "".join(kept))
    return removed


def refuse_terminal(meta, rid):
    """Rule 4: a terminal state is final. Wanting it again is a new want."""
    if meta.get("state") in WANT_TERMINAL:
        die("%s is already %s (%s: %s) — a terminal state is final; wanting "
            "it again is a new want, linked to this one"
            % (rid, meta["state"], meta.get(CLOSED_AT) or "(undated)",
               meta.get(CLOSED_BY) or "(unrecorded)"))


def _shift_state(rid, state, note, verb):
    meta, body = load(rid)
    refuse_terminal(meta, rid)
    stamp = now()
    meta["state"] = state
    meta["last_touched"] = stamp
    write(rec_path(rid), meta, add_entry(body, "%s: %s" % (verb, note), stamp))
    print("%s %s %s" % (rid, state, stamp))


def cmd_dormant(argv):
    if not argv:
        die("usage: want dormant <id> [why]")
    _shift_state(argv[0], "dormant", " ".join(argv[1:]) or "resting", "Dormant")


def cmd_revive(argv):
