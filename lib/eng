                 "Live again")


def _close_want(rid, state, by, verb):
    """The terminal transitions: stamp, entry, and the honest way off the
    shelf — the removed line preserved verbatim so retirement loses no words
    (rule 11). The shelf edit happens first so the entry can carry the line;
    both writes are atomic and declared."""
    meta, body = load(rid)
    refuse_terminal(meta, rid)
    stamp = now()
    meta["state"] = state
    meta[CLOSED_AT] = stamp
    meta[CLOSED_BY] = by
    meta["last_touched"] = stamp
    note = "%s: %s" % (verb, by)
    removed = shelf_remove(rid, meta.get("title", ""))
    if removed is not None:
        note += "\n\nShelf line at closing, preserved: %s" % removed
    write(rec_path(rid), meta, add_entry(body, note, stamp))
    print("%s %s %s: %s" % (rid, state, stamp, by))
    if removed is not None:
        print("shelf line removed; preserved verbatim in the document")
    elif wants_shelf():
        print("no shelf line found to remove for %s — the state change stands"
              % rid)


