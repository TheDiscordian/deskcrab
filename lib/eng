#!/usr/bin/env python3
"""Engineering records: threads with STATE, not appended prose (specs/engineering-records.md).

One file per thread in $DESKCRAB_ENG_DIR (default ~/.local/share/deskcrab/
engineering/records/): YAML frontmatter carrying id, title, opened,
last_touched, state (open|settled|dead), settled_at, settled_by, summary;
below it free prose, newest entries first, each headed with its own datetime.
State moves ONLY through this tool, and every write that adds an entry bumps
last_touched in the same motion — that pairing is what the job hook trusts.

    eng new <title> [--summary <line>] [--body <text>] [--opened <datetime>]
    eng list [--state open|review|settled|dead|all]
    eng show <id>
    eng touch <id> <note...>
    eng review <id> <claim...>          submit completed work: open -> review;
                                        the record is NOT settled by this
    eng accept <id> <verified...>       the review's yes: review -> settled
    eng reject <id> <missing...>        the review's no: review -> open, the
                                        missing requirements preserved and
                                        redispatched through the job door
    eng settle <id> <what-settled-it...>
    eng kill <id> [reason...]
    eng search <words...>
    eng field <id> <key>
    eng touched-since <id> <epoch>     exit 0 iff last_touched is newer
    eng prompt                          the shelves-layer block, or nothing
    eng migrate <prose file>            one record per ## entry or index
                                        bullet of the old prose, once

Inside a builder session (lib/job-runner exports DESKCRAB_ENG_ROLE=builder)
settle, kill, accept and reject are refused — a builder submits with `review`
and the completion review judges the claim (rules 16-16d).

Why this exists: an engineering note used to be undated prose with no state,
so a worry written before a question was settled kept reading as present-tense
fact — and twice on 2026-08-10 it was announced as a live code flaw that did
not exist. A settled thing must read as settled at a glance. Stdlib only,
like job-status: this must run on an offline machine with nothing installed.

This file is also the SPINE of the wants drawer (specs/wants.md): the same
parser, atomic writer, write declaration and search, parameterized by kind —
`--kind want` ahead of the verb, which is what `crab want` passes. One
substrate in code, two drawers on disk; kind `eng` is byte-for-byte the
behaviour documented above.
"""

import os
import re
import subprocess
import sys
import time

FIELDS = ["id", "title", "opened", "last_touched", "state",
          "settled_at", "settled_by", "summary"]
STATES = ("open", "review", "settled", "dead")
TIMEFMT = "%Y-%m-%d %H:%M:%S"

# The kind table — the whole of what differs between the two drawers is data
# (specs/wants.md, the substrate decision). KIND is set once in main() and the
# vocabulary globals below are re-pointed with it; every function reads them.
KIND = "eng"
WANT_FIELDS = ["id", "title", "opened", "last_touched", "state",
               "retired_at", "retired_by", "links", "summary"]
WANT_STATES = ("live", "dormant", "grown-into-me", "retired")
WANT_TERMINAL = ("grown-into-me", "retired")
OPEN_STATE = "open"          # want: "live"
CLOSED_AT = "settled_at"     # want: "retired_at"
CLOSED_BY = "settled_by"     # want: "retired_by"
CLOSED_STATES = ("settled", "dead")   # want: WANT_TERMINAL

WANT_USAGE = """Wants: the record spine of `eng` under kind `want` (specs/wants.md).

    want new <title> [--summary <line>] [--body <text>] [--opened <datetime>]
    want list [--state live|dormant|grown-into-me|retired|all]
    want show <id>
    want touch <id> <note...>           appends at the END: a want document
                                        is a journal, newest last
    want dormant <id> [why...]          resting on purpose, not gone
    want revive <id> [note...]          back to live
    want grown <id> <how...>            terminal: it became part of her
    want retire <id> <reason...>        terminal: put down honestly; the
                                        reason is required
    want link <id> <job:<id>|eng:<id>>...
    want search <words...>
    want field <id> <key>
    want touched-since <id> <epoch>
    want migrate [<shelf file>]         frontmatter onto the drawer, once;
                                        bodies byte-for-byte untouched
"""


def kind_dir(kind):
    """The drawer for a kind, from the environment or the data home."""
    env = {"eng": "DESKCRAB_ENG_DIR", "want": "DESKCRAB_WANTS_DIR"}[kind]
    sub = {"eng": os.path.join("engineering", "records"), "want": "wants"}[kind]
    d = os.environ.get(env)
    if not d:
        data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
        d = os.path.join(data, "deskcrab", sub)
    return d


def eng_dir():
    return kind_dir(KIND)


def now():
    return time.strftime(TIMEFMT)


def die(msg):
    print("eng: %s" % msg, file=sys.stderr)
    sys.exit(2)


def slugify(title):
    s = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    return s[:48].rstrip("-") or "untitled"


def rec_path(rid):
    return os.path.join(eng_dir(), rid + ".md")


def quote(v):
    """One line, quoted only when YAML would misread it bare."""
    v = " ".join(str(v).split())
    if v and (":" in v or v[0] in "-?[]{}#&*!|>'\"%@`"):
        return '"%s"' % v.replace("\\", "\\\\").replace('"', '\\"')
    return v


def unquote(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == '"' and v[-1] == '"':
        return v[1:-1].replace('\\"', '"').replace("\\\\", "\\")
    return v


def parse(path):
    """-> (meta dict, body str) or None if the file is not a record."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---\n", 4)
    if end < 0:
        return None
    meta = {}
    for line in text[4:end].splitlines():
        if ":" not in line:
            continue
        k, _, v = line.partition(":")
        meta[k.strip()] = unquote(v)
    body = text[end + 5:].lstrip("\n")
    if "id" not in meta:
        return None
    return meta, body


def declare_write(*paths):
    """Tell the self-change watcher these paths are about to move by my hand.

    The records directory is in lib/notice-selfchange's watch set, and an
    undeclared write there is reported back as an intruder's change to her
    own files. On 2026-08-11 at 11:22 a `crab eng touch` made from a live
    wake did exactly that: at 11:23 the watcher booked a wake about the very
    record this tool had just written. So every write goes out declared
    FIRST, through `crab touching` — the CLI face of touch_suppress in
    lib/common.sh, the same door every other writing hand of hers uses —
    with the same short window the day journal's declaration takes
    (day_journal_append, lib/common.sh). The watcher itself stays untouched:
    a genuinely external edit to the same file still surfaces.

    Best-effort, like every existing caller's `2>/dev/null`: a missing or
    failing crab must never cost the record write itself.
    """
    crab = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                        os.pardir, "crab")
    if not os.access(crab, os.X_OK):
        return
    try:
        subprocess.run(
            [crab, "touching", "-w", "300"]
            + [os.path.abspath(p) for p in paths],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=20)
    except (OSError, subprocess.SubprocessError):
        pass


def write(path, meta, body):
    """Atomic, like job-status: a concurrent prompt build never reads half."""
    lines = ["---"]
    for k in FIELDS:
        lines.append("%s: %s" % (k, quote(meta.get(k, ""))))
    lines.append("---")
    text = "\n".join(lines) + "\n\n" + body.rstrip("\n") + "\n"
    tmp = "%s.tmp.%d" % (path, os.getpid())
    # Every path this write moves — the record and the temporary it is
    # atomically replaced from — declared before a byte lands (rule 10a).
    declare_write(path, tmp)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def load(rid):
    got = parse(rec_path(rid))
    if got is None:
        die("no record '%s' in %s (ids: crab eng list)" % (rid, eng_dir()))
    return got


def all_records():
    d = eng_dir()
    out = []
    if os.path.isdir(d):
        for name in sorted(os.listdir(d)):
            if not name.endswith(".md"):
                continue
            got = parse(os.path.join(d, name))
            if got is not None:
                out.append(got)
    return out


def touched_epoch(meta):
    for key in ("last_touched", "opened"):
        v = (meta.get(key) or "").strip()
        for fmt in (TIMEFMT, "%Y-%m-%d %H:%M", "%Y-%m-%d"):
            try:
                return int(time.mktime(time.strptime(v, fmt)))
            except ValueError:
                continue
    return 0


def add_entry(body, note, stamp=None):
    """Records read newest FIRST: the fresh entry goes above whatever is
    already there. A want document is a journal and reads newest LAST
    (specs/wants.md rule 3), so kind want appends instead — the tool follows
    the shape every existing document already has."""
    entry = "## %s\n\n%s\n" % (stamp or now(), note.strip())
    if KIND == "want":
        return (body.rstrip("\n") + "\n\n" + entry) if body.strip() else entry
    return entry + ("\n" + body if body.strip() else "")


# --- the ending gate (specs/engineering-records.md rules 15-15c) ------------
# A record must not END at "I cannot do this", nor at a chore for the user.
# The origin (2026-08-25 04:38): the stale-tidy-unit record was closed for
# the night with two command lines for the user to run — one of them, "Also
# unset: TIDY_CLAIMS_ROOTS", a statement phrased so it READ as an instruction
# — and he woke at 09:51 to a chore his own machine could have run. So a
# touch whose note ends that way, with no job id attached, dispatches a
# builder against this record through the job door and lands the id on the
# very entry, in the same write. Kind `eng` only; settle and kill are
# decisions about a thread and stay out of it.

JOB_ID_RE = re.compile(r"\b\d{8}-\d{6}-\d+\b")


def _lib_path(name):
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), name)


def _scan(mode, text):
    """lib/chore-scan's verdict — the ONE detector, shared with the delivery
    gate — or None when the scanner cannot answer (then the gate stands
    down: fail open, never a lost write)."""
    scan = _lib_path("chore-scan")
    if not os.access(scan, os.X_OK):
        return None
    try:
        r = subprocess.run([scan, mode], input=text.encode("utf-8"),
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.returncode == 0


def _job_against(rid):
    """A queued, dispatched or running job already standing against this
    record (rule 15a): its id, or ''. This is what ends the chain — the
    builder such a job runs can write its own inability onto the record
    without dispatching a successor for itself."""
    import json
    d = jobs_dir()
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return ""
    for n in names:
        if not n.endswith(".json"):
            continue
        try:
            with open(os.path.join(d, n), encoding="utf-8") as f:
                j = json.load(f)
        except (OSError, ValueError):
            continue
        if (j.get("record") == rid
                and j.get("state") in ("queued", "dispatched", "running")):
            return j.get("id") or n[:-5]
    return ""


def _stamp_attach_epoch(jid, epoch):
    """Rule 15b: the attach write postdates the dispatch, which is exactly
    the shape the job hook trusts — stamp its epoch on the sidecar so the
    runner's rule-27 floor can discount this tool's own hand. Best-effort,
    like the write declaration: a failure costs the floor, never the
    record."""
    status = _lib_path("job-status")
    sidecar = os.path.join(jobs_dir(), jid + ".json")
    if not (os.access(status, os.X_OK) and os.path.exists(sidecar)):
        return
    try:
        subprocess.run([status, "set", sidecar,
                        "record_attached_epoch=%d" % epoch],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=20)
    except (OSError, subprocess.SubprocessError):
        pass


def ending_gate(rid, note):
    """-> (line to append to the entry or '', dispatched job id or '')."""
    if KIND != "eng" or os.environ.get("DESKCRAB_ENG_ENDING_GATE", "1") != "1":
        return "", ""
    if JOB_ID_RE.search(note):
        return "", ""    # a job id is attached; the ending is answered
    if _scan("ends-chore", note):
        ending = "a chore for the user"
    elif _scan("inability", note):
        ending = "inability"
    else:
        return "", ""
    live = _job_against(rid)
    if live:
        return ("\n\n(ending gate: job %s already stands against this "
                "record — the ending above is its brief, not the user's)"
                % live), ""
    crab = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                        os.pardir, "crab")
    out = ""
    if os.access(crab, os.X_OK):
        task = ("Engineering record '%s' just ended at %s with nothing "
                "dispatched. Do the work its latest entry names — from this "
                "machine, never as advice for the user — verify it, and "
                "write the outcome onto the record: %s"
                % (rid, ending, " ".join(note.split())[:600]))
        try:
            r = subprocess.run([crab, "job", "--record", rid, task],
                               stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, timeout=90)
            out = r.stdout.decode("utf-8", "replace")
        except (OSError, subprocess.SubprocessError):
            out = ""
    m = re.search(r"^Job (\S+) (QUEUED|dispatched)", out, re.M)
    if m:
        how = ("queued for the night" if m.group(2) == "QUEUED"
               else "dispatched")
        return ("\n\n(ending gate: this entry ended at %s, so job %s now "
                "carries the work — %s)" % (ending, m.group(1), how)), \
            m.group(1)
    # Fail open, loudly, ON the record (rule 15c): the write is never lost
    # to the gate, and the record never ends at "I can't" silently.
    first = (out.strip().splitlines()[0] if out.strip()
             else "the door produced nothing")
    return ("\n\n(ending gate: a job was owed here — the entry ends at %s — "
            "and the dispatch did not land: %s)" % (ending, first)), ""


# --- the completion review (specs/engineering-records.md rules 16-16d) ------
# A builder never settles the ask it was dispatched against. The origin
# (2026-08-26, record the-chess-table-maintains-a-second-conversation): the
# ask was the chess table as a thin client of the phone's VISIBLE conversation
# interface; the builder delivered shared audio plumbing — a clip-queue module
# both pages load — and settled the record on it as "shared-primitive parity".
# Narrowed work that settles its own ask reads as the ask delivered, and
# nobody is ever brought back to the gap. So completed work is SUBMITTED
# (state `review`), the completion wake is the review, and the verdict verbs
# — accept, reject — belong to the review alone.

def builder_role():
    """Rule 16d: the gate is the ROLE marker, exported by lib/job-runner and
    by nothing else. Without it every hand keeps every verb."""
    return os.environ.get("DESKCRAB_ENG_ROLE", "") == "builder"


def refuse_builder(verb, rid):
    if KIND == "eng" and builder_role():
        die("a builder does not %s the ask it was dispatched against "
            "(specs/engineering-records.md rule 16). Submit the work for "
            "review instead: crab eng review %s '<what you delivered and "
            "how you verified it>' — the review that wakes on your "
            "completion accepts or rejects it. An honest inability is also "
            "a submission." % (verb, rid))


def _record_workdir(rid):
    """Rule 16b: the redispatch is PLACED where the originating build ran.
    Every dispatch records its workdir on the sidecar (jobs.md rule 7a),
    and the sidecar carries the record it was dispatched against — so the
    newest sidecar against this record whose directory still exists names
    the repository that owns the artefact. The reviewing session's own cwd
    is a different project (live 2026-08-26: a rejected deskcrab build was
    redispatched into the reviewer's project directory), and each `-C`
    lands on the new sidecar in turn, so the placement survives a chain of
    rejections. -> the directory, or '' when no sidecar offers a live
    one."""
    import json
    d = jobs_dir()
    try:
        names = os.listdir(d)
    except OSError:
        return ""
    found = []
    for n in names:
        if not n.endswith(".json"):
            continue
        try:
            with open(os.path.join(d, n), encoding="utf-8") as f:
                j = json.load(f)
        except (OSError, ValueError):
            continue
        if j.get("record") != rid or not j.get("workdir"):
            continue
        stamp = j.get("started_epoch") or j.get("queued_epoch") or 0
        found.append((stamp, n, j["workdir"]))
    for _, _, wd in sorted(found, reverse=True):
        if os.path.isdir(wd):
            return wd
    return ""


def reject_dispatch(rid, missing):
    """Rule 16b: the missing requirements ride the new brief VERBATIM,
    through the job door with the reviewer's own deliberate force (jobs.md
    rule 31) — work already chosen once does not queue behind the night a
    second time — and placed with -C in the originating job's workdir when
    a sidecar against the record still names one that exists.
    -> (job id or '', the door's own line)."""
    crab = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                        os.pardir, "crab")
    if not os.access(crab, os.X_OK):
        return "", "no job door (crab is not executable here)"
    task = ("Engineering record '%s' went through its completion review and "
            "was REJECTED: the submitted work did not deliver the full ask. "
            "Missing, per the review: %s. Read the record first (crab eng "
            "show %s) — its opening entry is the original ask and the "
            "acceptance criteria. Deliver what is missing, verify it with "
            "real tests or greps, and submit again: crab eng review %s "
            "'<what you delivered and how you verified it>'."
            % (rid, " ".join(missing.split()), rid, rid))
    wd = _record_workdir(rid)
    cmd = [crab, "job", "-f", "--record", rid]
    if wd:
        cmd += ["-C", wd]
    cmd.append(task)
    try:
        r = subprocess.run(cmd,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=90)
        out = r.stdout.decode("utf-8", "replace")
    except (OSError, subprocess.SubprocessError) as e:
        return "", "the door raised: %s" % e
    m = re.search(r"^Job (\S+) (QUEUED|dispatched)", out, re.M)
    if m:
        line = ("queued for the night" if m.group(2) == "QUEUED"
                else "dispatched")
        if wd:
            line += ", in the originating workdir %s" % wd
        return m.group(1), line
    first = (out.strip().splitlines()[0] if out.strip()
             else "the door produced nothing")
    return "", first


def cmd_review(argv):
    """Submit completed work (rule 16): open -> review, the claim on the
    entry, last_touched bumped in the same write. The record is NOT settled
    by this — it reads, at a glance, as work claimed and not yet judged."""
    if len(argv) < 2:
        die("usage: eng review <id> <claim — what was delivered, how it was "
            "verified>")
    rid, claim = argv[0], " ".join(argv[1:])
    meta, body = load(rid)
    if meta.get("state") in CLOSED_STATES:
        die("%s is already %s — a terminal state refuses a new submission; "
            "a new ask is a new record" % (rid, meta["state"]))
    stamp = now()
    meta["state"] = "review"
    meta["last_touched"] = stamp
    write(rec_path(rid), meta,
          add_entry(body, "Submitted for review: %s" % claim, stamp))
    print("%s in review %s — the record is NOT settled; the completion "
          "review accepts or rejects the claim" % (rid, stamp))


def cmd_accept(argv):
    """The review's yes (rule 16a): only a submitted record, never a
    builder's own hand. settled_by carries the verdict."""
    if len(argv) < 2:
        die("usage: eng accept <id> <what the review verified>")
    refuse_builder("accept", argv[0])
    meta, _ = load(argv[0])
    if meta.get("state") != "review":
        die("%s is %s, not in review — accept judges a submission "
            "(crab eng review first; settle is the door for everything else)"
            % (argv[0], meta.get("state") or "?"))
    _close(argv[0], "settled", "review accepted: %s" % " ".join(argv[1:]),
           "Settled")


def cmd_reject(argv):
    """The review's no (rules 16a-16b): back to open, the missing
    requirements preserved verbatim on the entry AND redispatched at once —
    in that order. The rejection is ON DISK, open, before the job door is
    opened, because the dispatch runs a builder against this very record: a
    forced redispatch can have its builder touching — or submitting — within
    seconds, and the old shape (load, dispatch, then write the pre-dispatch
    body back) erased whatever landed in that window. The job id and the
    door's outcome are added afterwards by RE-READING the record, so every
    concurrent entry, the current state, and the current last_touched
    survive. A dispatch the door refuses is named the same way and the
    reopen stands from the first write — the rejection is never lost to its
    own dispatch."""
    if len(argv) < 2:
        die("usage: eng reject <id> <the missing requirements>")
    refuse_builder("reject", argv[0])
    rid, missing = argv[0], " ".join(argv[1:])
    meta, body = load(rid)
    if meta.get("state") != "review":
        die("%s is %s, not in review — reject judges a submission"
            % (rid, meta.get("state") or "?"))
    # First write, BEFORE the dispatch: the reopen and the missing
    # requirements, verbatim. The builder the dispatch starts reads an open
    # record already carrying what it owes.
    note = ("Review rejected — the full ask was not delivered. Missing: %s"
            % missing)
    stamp = now()
    meta["state"] = "open"
    meta["last_touched"] = stamp
    write(rec_path(rid), meta, add_entry(body, note, stamp))
    jid, doorline = reject_dispatch(rid, missing)
    if jid:
        outcome = ("(review: job %s now carries the missing requirements "
                   "— %s)" % (jid, doorline))
    else:
        outcome = ("(review: the redispatch did not land — %s. The "
                   "rejection stands, the record is OPEN again, and the "
                   "next hand owes the dispatch.)" % doorline)
    # Second write, AFTER the dispatch: re-read and annotate. The entry is
    # located by the exact text the first write put down; the outcome lands
    # inside it without touching state or last_touched, so a fast builder's
    # concurrent touch or submission stands whole. Only when the entry
    # cannot be found (a concurrent hand rewrote it) does the outcome fall
    # back to a fresh dated entry — and only THAT write, which postdates the
    # dispatch and bumps last_touched, needs its epoch stamped for the
    # runner's floor (rule 15b's discipline); the first write predates the
    # dispatch, which is the floor already.
    meta2, body2 = load(rid)
    # add_entry strips the note on the way in; the anchor must match what
    # was actually written, not what was handed over.
    anchor = "## %s\n\n%s" % (stamp, note.strip())
    attach = stamp
    if anchor in body2:
        write(rec_path(rid), meta2,
              body2.replace(anchor, anchor + "\n\n" + outcome, 1))
    else:
        attach = now()
        meta2["last_touched"] = attach
        write(rec_path(rid), meta2, add_entry(body2, outcome, attach))
    print("%s rejected, open again %s" % (rid, stamp))
    print("missing, preserved on the record: %s" % missing)
    if jid:
        print("redispatched as job %s (%s)" % (jid, doorline))
        try:
            epoch = int(time.mktime(time.strptime(attach, TIMEFMT)))
        except (ValueError, OverflowError):
            epoch = int(time.time())
        _stamp_attach_epoch(jid, epoch)
    else:
        print("redispatch did not land: %s" % doorline)


# --- the commands ----------------------------------------------------------

def cmd_new(argv):
    title, summary, body, opened = None, "", "", ""
    args = list(argv)
    rest = []
    while args:
        a = args.pop(0)
        if a == "--summary" and args:
            summary = args.pop(0)
        elif a == "--body" and args:
            body = args.pop(0)
        elif a == "--opened" and args:
            opened = args.pop(0)
        else:
            rest.append(a)
    title = " ".join(rest).strip()
    if not title:
        die("usage: eng new <title> [--summary <line>] [--body <text>]")
    rid = slugify(title)
    n = 2
    while os.path.exists(rec_path(rid)):
        rid = "%s-%d" % (slugify(title), n)
        n += 1
    stamp = opened or now()
    meta = {k: "" for k in FIELDS}
    meta.update({"id": rid, "title": title, "opened": stamp,
                 "last_touched": stamp, "state": OPEN_STATE,
                 "summary": summary})
    write(rec_path(rid), meta, add_entry("", body or "Opened.", stamp))
    if KIND == "want":
        shelf_append(rid, title)
    print(rid)


def one_line(meta):
    state = meta.get("state", OPEN_STATE)
    if state in CLOSED_STATES:
        return "%s [%s] — %s %s: %s" % (
            meta.get("title", "?"), meta["id"], state,
            meta.get(CLOSED_AT) or "(undated)",
            meta.get(CLOSED_BY) or "(unrecorded)")
    line = "%s [%s] — opened %s, last touched %s" % (
        meta.get("title", "?"), meta["id"],
        meta.get("opened") or "(undated)",
        meta.get("last_touched") or "(undated)")
    if state == "review":
        # Rule 16c: a completion claim awaiting judgement is live, and must
        # never read as settled. The review verbs are named right here.
        line += (" (in review — completion claimed, NOT settled: inspect "
                 "the artefact against the original ask, then crab eng "
                 "accept or reject)")
    return line


def state_rank(meta):
    """List order: the pursued before the resting before the closed."""
    s = meta.get("state", "")
    if KIND == "want":
        return {"live": 0, "dormant": 1}.get(s, 2)
    return 0 if s in ("open", "review") else 1


def cmd_list(argv):
    want = "all"
    if "--state" in argv:
        i = argv.index("--state")
        want = argv[i + 1] if i + 1 < len(argv) else "all"
    recs = [m for m, _ in all_records()]
    if want != "all":
        recs = [m for m in recs if m.get("state") == want]
    recs.sort(key=lambda m: (state_rank(m), -touched_epoch(m)))
    for m in recs:
        print("%-7s  %s" % (m.get("state", "?"), one_line(m)))


