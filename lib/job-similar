#!/usr/bin/env python3
"""Name the live work a new brief resembles (specs/jobs.md rule 7i).

Four builders went out in eight minutes against one Firemaking sequence on
2026-09-02, and two of them spent an account each only to find the others
already mid-implementation in the same shared checkouts. Nothing in the
dispatch path looked at what was already running.

So this: given a brief on the command line, print the `running` and `queued`
jobs whose descriptions come close to it. A WARNING and never a refusal —
the thresholds do not separate cleanly (rule 7i records the measurement),
and a refusal that is wrong costs real work silently. Exit is always 0; the
caller dispatches regardless.

    job-similar [--skip <job-id>] <jobs-dir> <description...>

`--skip` drops one job from the comparison: a requeue and a block retry are
deliberate redoes of a recorded brief, so their own original is a twin by
construction and naming it would be noise, not news.
"""

import collections
import glob
import json
import math
import os
import re
import sys

# Words with no discriminating power of their own. Everything else earns its
# weight from the corpus below rather than from a list anybody has to keep.
STOP = set("""this that with from into over when what which their there they
have been will must than then them the and for are but not you your a an of
to in on it is as at by be or if so no do its was were what while into""".split())

# The measure is the idf-weighted OVERLAP COEFFICIENT — shared weight over
# the lighter of the two briefs — not Jaccard. Jaccard was tried first and
# is unusable here: a short brief against a long sibling scored 0.21 where
# the same pair, both written out in full, scored 0.40, so the floor moved
# with how much anybody happened to type. On the overlap coefficient
# tonight's four duplicates sit at 0.67-0.86, a DIFFERENT gap wearing the
# same brief template at 0.57-0.68, and every unrelated pair at 0.03-0.37.
# Hence a floor below the template cousins, and hence a warning: the two
# upper bands cannot be told apart by a number.
FLOOR = 0.45
# Sidecars read for the idf corpus, newest first. The ids are timestamps, so
# a reverse sort is chronological, and dispatch never pays for a whole year.
CORPUS_CAP = 400


def tokens(text):
    return {w for w in re.findall(r"[a-z0-9']{4,}", (text or "").lower())
            if w not in STOP}


def main(argv):
    argv = list(argv)
    skip = ""
    if len(argv) > 2 and argv[1] == "--skip":
        skip = argv[2]
        del argv[1:3]
    if len(argv) < 3:
        return 0
    jobs_dir, brief = argv[1], " ".join(argv[2:])
    mine = tokens(brief)
    if not mine:
        return 0

    docs = {}
    try:
        paths = sorted(glob.glob(os.path.join(jobs_dir, "*.json")),
                       reverse=True)[:CORPUS_CAP]
    except OSError:
        return 0
    for p in paths:
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                job = json.load(f)
        except (OSError, ValueError):
            continue
        desc = job.get("description") or ""
        if desc:
            docs[os.path.basename(p)[:-5]] = (job.get("state", "?"), desc)

    if not docs:
        return 0
    df = collections.Counter()
    for _, desc in docs.values():
        for w in tokens(desc):
            df[w] += 1
    n = len(docs)

    def idf(w):
        # The +1 floor is not decoration. Unsmoothed, a word appearing in
        # every sidecar weighs exactly nothing, so on a small corpus — a
        # fresh install, or the first job of a day — every weight collapsed
        # to zero and the comparison became 0/0 for briefs that were plainly
        # twins. A rare word still outweighs a common one; a common one is
        # no longer worthless.
        return 1.0 + math.log((n + 1.0) / (df.get(w, 0) + 1.0))

    hits = []
    for jid, (state, desc) in docs.items():
        if state not in ("running", "queued") or jid == skip:
            continue
        theirs = tokens(desc)
        lighter = min(sum(idf(w) for w in mine), sum(idf(w) for w in theirs))
        if lighter <= 0:
            continue
        score = sum(idf(w) for w in mine & theirs) / lighter
        if score >= FLOOR:
            hits.append((score, jid, state, desc))
    if not hits:
        return 0

    hits.sort(reverse=True)
    print("  Work already in flight that this brief resembles "
          "(jobs.md rule 7i) — dispatching anyway:")
    for score, jid, state, desc in hits[:5]:
        line = " ".join(desc.split())
        if len(line) > 92:
            line = line[:92] + "…"
        print("    %s (%s): %s" % (jid, state, line))
    print("    Read one before spending an account on it: crab job log <id>")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
