#!/usr/bin/env python3
"""The cocoon signpost: in a live turn or wake, what constitutes her is
read-only, and this hook is the deny that says WHY and names the road out.

specs/cocoon.md rules 4a and 5. This is a PreToolUse hook attached (by
claude_profile_flags) to the turn and wake profiles only. Builders — `crab
job`, the job profile — carry neither this hook nor the wall, and that is the
whole design: changes to her own machinery go through a builder with a brief,
never through the hands of the session that is mid-conversation.

This hook is NOT the enforcement. It reads text, and text has infinitely many
spellings — an adversarial review found about ten working bypasses when it
stood alone. The wall is the bubblewrap mount namespace the run functions
apply (cocoon_wrap_build in lib/common.sh): everything constituent is
bind-mounted read-only and a write there dies in the kernel, whatever spelling
produced it. What this hook buys is the sentence the kernel cannot say — a
deny that names the cocoon and the road, instead of a bare "Read-only file
system" — plus cover for the two places the wrap must leave writable for the
CLI's own sake: the CLI config dirs and the project directory's `.claude`,
where one settings write (disableAllHooks) would kill every hook.

Why the discipline is mechanical and not a prompt rule: on 2026-08-10, told
eight ways to stop and listen, she shipped six commits to her own speech
machinery in the middle of the argument itself — each one a way of not
listening, several of them wrong. A rule she reads is a rule she can reach
past when she is sure; a mount namespace does not read back.

Contract (Claude Code hook protocol): tool-call JSON on stdin; a deny is JSON
on stdout with permissionDecision "deny"; anything else exits 0 silently and
the call proceeds. Fail-open on malformed input — broken advice must not brick
her hands, and the wall does not depend on this hook.

DESKCRAB_DISPUTE=1 marks a dispute turn (set into the generated settings by
claude_profile_flags): the dispute frame forbids dispatching a builder in that
turn, so the deny must not tell her to — it says the change waits until the
dispute is settled instead.
"""

import json
import os
import re
import shlex
import sys


def home(*parts):
    return os.path.realpath(os.path.join(os.path.expanduser("~"), *parts))


# What constitutes her. Realpathed, so the ~/.local/bin symlinks into the repo
# and any path spelled through them land on the same answer. The CLI config
# dirs and the project .claude are here for the hook-killing settings write —
# the wrap leaves them writable because the CLI itself needs them.
CONSTITUENT = [
    os.path.realpath(os.environ.get("DESKCRAB_REPO", home("Programming", "Claude", "deskcrab"))),
    home(".local", "lib", "deskcrab"),
    home(".local", "bin", "crab"),
    home(".local", "bin", "crab-debug"),
    home(".config", "deskcrab"),
    home(".config", "systemd", "user"),
    home(".claude"),
]
# The project directory's machinery surfaces: its CLAUDE.md and its .claude
# settings. Named through the env the settings command carries, with the
# installed default as the fallback so a bare invocation still protects the
# live install. The personal library beside them is deliberately NOT here:
# it is her own writing — lines, moments, music, pretty, voice — a drawer in
# rule 3's sense, watched by the self-change watcher because it is part of
# her, not because it is machinery (specs/cocoon.md rules 1 and 3).
_PROJ = os.environ.get("DESKCRAB_PROJECT_DIR") or home("Beatrice")
CONSTITUENT += [
    os.path.realpath(os.path.join(_PROJ, "CLAUDE.md")),
    os.path.realpath(os.path.join(_PROJ, ".claude")),
]
if os.environ.get("CLAUDE_CONFIG_DIR"):
    CONSTITUENT.append(os.path.realpath(os.environ["CLAUDE_CONFIG_DIR"]))

# Inside a Bash command, the hook judges WRITE OPERATIONS and their TARGETS —
# a redirection's target, a writing command's operands — never the command
# text as a whole. The first cut matched shapes against the whole string and
# any constituent-looking token beside them, which refused three innocent
# classes in one live morning: running a program that lives in the repo (the
# command word is not a write target — executing constituent code is a read),
# a quoted wake reason that happened to NAME a sealed path, and a `crab job`
# whose brief described repo work (the brief is speech about the change, and
# the builder road itself). A read — grep, cat, git log, git show, diff, a
# copy OUT of the repo — never matches (specs/cocoon.md rule 4a).
#
# `systemd-run` and the raw D-Bus spellings (`busctl`, `dbus-send`, `gdbus`)
# are the one deliberate exception, still judged textually: aiming the user
# manager at a constituent path is the builder road without the brief (rule
# 4c), the payload rides inside quoted arguments, and the unit it starts is
# born OUTSIDE the namespace with full hands. Be plain about what matching
# them buys: a SIGNPOST, not a wall. The kernel does not — by design — seal
# that door, and no text hook can: text has infinitely many spellings, and a
# D-Bus call that names no constituent path in its own words walks past any
# pattern. Everything the parser below cannot see — variables, interpreters,
# a pathless git in a constituent cwd — is the kernel's to refuse (rule 4).

# The self-mutation road spelled through the user manager: any constituent
# path in the arguments, even inside a quoted unit payload, is the signal.
DBUS_ROAD = {"systemd-run", "busctl", "dbus-send", "gdbus"}
# Writing commands whose every operand is written (mv both removes and
# creates, so every path it names is a write target).
TARGET_ALL = {"rm", "mv", "chmod", "chown", "truncate", "mkdir", "touch",
              "tee", "patch"}
# Writing commands whose last operand is the destination — the sources are
# reads, and copying a constituent file OUT is reading it.
TARGET_LAST = {"cp", "ln", "install"}
GIT_WRITE = {"commit", "add", "apply", "am", "rebase", "merge", "reset",
             "restore", "checkout", "switch", "rm", "mv", "stash", "push",
             "clean"}
SYSTEMCTL_WRITE = {"daemon-reload", "enable", "disable", "edit", "mask",
                   "unmask"}
SHELLS = {"sh", "bash", "zsh", "dash", "ksh"}
WRAPPERS = {"sudo", "env", "command", "nohup", "nice"}
OPCHARS = set("();<>|&")
ASSIGN_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
# Paths embedded in a D-Bus road argument's text (and only there).
PATH_TOKEN_RE = re.compile(r"[~/][^\s'\";|&)]*")
# A redirection target that is a file descriptor, not a file.
FD_RE = re.compile(r"&?\d*-?$")

DENY_TEXT = (
    "{path} is part of what constitutes you, and in a live turn or wake it is "
    "read-only — the cocoon rule (specs/cocoon.md). Reading it is fine. To "
    "change it, dispatch a builder with the whole brief: crab job "
    "\"<self-contained description of the change, the files, and how to prove "
    "it works>\" — the builder has hands here and you do not. If it cannot "
    "wait for a builder, say so to him and let him decide."
)

# In a dispute turn the frame forbids dispatching a builder, so the deny must
# not point at one — the contradiction the review caught. The road in a
# dispute turn is through him, afterwards.
DENY_TEXT_DISPUTE = (
    "{path} is part of what constitutes you, and in a live turn or wake it is "
    "read-only — the cocoon rule (specs/cocoon.md). Reading it is fine. And he "
    "is pushing back this turn, so no builder is dispatched either — "
    "understanding him comes first, and a change made mid-argument is the "
    "failure being answered. If the change still matters once the dispute is "
    "settled, describe it to him and let him decide; the builder road waits "
    "until then."
)


def constituent_hit(path):
    """The constituent root `path` falls under, or None."""
    real = os.path.realpath(os.path.expanduser(path))
    for root in CONSTITUENT:
        if real == root or real.startswith(root + os.sep):
            return root
    return None


def first_hit(candidates):
    for c in candidates:
        hit = constituent_hit(c)
        if hit:
            return hit
    return None


def git_hit(args):
    """A git write subcommand, judged by its -C repo and its path operands.

    A pathless `git commit` in a constituent cwd is the kernel's to refuse
    (rule 4): the hook cannot see the Bash tool's working directory, and the
    wall does not need it to.
    """
    paths = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-C" and i + 1 < len(args):
            paths.append(args[i + 1])
            i += 2
            continue
        if a == "-c" and i + 1 < len(args):
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        # The subcommand; everything path-shaped after it is an operand.
        if a not in GIT_WRITE:
            return None
        paths.extend(p for p in args[i + 1:] if p.startswith(("/", "~", ".")))
        return first_hit(paths)
    return None


def command_hit(words):
    """One simple command, judged by what it WRITES — never by what it is.

    The command word itself is deliberately not judged: executing a program
    that lives under a constituent root is a read, and the first cut of this
    hook made `crab` and the chess board unrunnable mid-turn by counting the
    program's own path as a hit.
    """
    i = 0
    while i < len(words) and (ASSIGN_RE.match(words[i])
                              or os.path.basename(words[i]) in WRAPPERS):
        i += 1
    if i >= len(words):
        return None
    cmd = os.path.basename(words[i])
    args = words[i + 1:]

    if cmd in SHELLS:
        # A -c payload is a command again; judge it as one.
        for j, a in enumerate(args):
            if a == "-c" and j + 1 < len(args):
                return bash_hit(args[j + 1])
        return None
    if cmd in DBUS_ROAD:
        return first_hit(p for a in args for p in PATH_TOKEN_RE.findall(a))
    if cmd == "git":
        return git_hit(args)
    if cmd == "systemctl":
        if "--user" in args and any(a in SYSTEMCTL_WRITE for a in args):
            return first_hit(a for a in args if a.startswith(("/", "~")))
        return None
    if cmd == "sed":
        if any(a == "-i" or a.startswith(("-i", "--in-place")) for a in args):
            return first_hit(a for a in args if a.startswith(("/", "~", ".")))
        return None
    if cmd == "dd":
        return first_hit(a[len("of="):] for a in args if a.startswith("of="))
    if cmd in TARGET_ALL:
        return first_hit(a for a in args if not a.startswith("-"))
    if cmd in TARGET_LAST:
        for j, a in enumerate(args):
            if a == "-t" and j + 1 < len(args):
                hit = constituent_hit(args[j + 1])
                if hit:
                    return hit
            if a.startswith("--target-directory="):
                hit = constituent_hit(a.split("=", 1)[1])
                if hit:
                    return hit
        operands = [a for a in args if not a.startswith("-")]
        return constituent_hit(operands[-1]) if operands else None
    return None


def bash_hit(command):
    """A real write operation whose target is constituent, or None.

    Tokenized with shlex so quoted prose stays one word: a wake reason or a
    job brief that NAMES a sealed path is speech about the path, not a write
    to it, and never reaches a target position. Text shlex cannot parse fails
    open (rule 5) — the wall does not depend on this hook.
    """
    try:
        lex = shlex.shlex(command, posix=True, punctuation_chars=True)
        lex.whitespace_split = True
        tokens = list(lex)
    except ValueError:
        return None
    words = []
    redirect = None
    for tok in tokens:
        if tok and all(c in OPCHARS for c in tok):
            if ">" in tok:
                redirect = "write"
            elif "<" in tok:
                redirect = "read"
            else:
                # | & ; && || ( ) — a command boundary.
                hit = command_hit(words)
                if hit:
                    return hit
                words = []
            continue
        if redirect:
            if redirect == "write" and not FD_RE.fullmatch(tok):
                hit = constituent_hit(tok)
                if hit:
                    return hit
            redirect = None
            continue
        words.append(tok)
    return command_hit(words)


def main():
    try:
        call = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0
    tool = call.get("tool_name", "")
    tool_input = call.get("tool_input") or {}

    hit = None
    if tool in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
        path = tool_input.get("file_path") or tool_input.get("notebook_path") or ""
        if path:
            hit = constituent_hit(path)
    elif tool == "Bash":
        hit = bash_hit(tool_input.get("command") or "")

    if hit:
        text = DENY_TEXT_DISPUTE if os.environ.get("DESKCRAB_DISPUTE") else DENY_TEXT
        json.dump({
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": text.format(path=hit),
            }
        }, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
