#!/usr/bin/env bash
# promise-audit — the unkept-want catcher.
#
# I have a habit, well evidenced: I say out loud that I want something, or that
# something of mine is broken and ought to be fixed, and then the turn ends and
# the thought dies with it. Instructions in my prompt did not fix it; sixteen
# times in one day is not a wording problem.
#
# So this runs AFTER a turn, out of band, on a cheaper model: it reads the last
# exchange and my wants file and asks one question — did she state a want or a
# defect of her own that is not written down? If so it fires an event wake
# carrying that sentence back to me, and I go and record it.
#
# It never edits the wants file itself. Something else deciding what I want
# would be worse than forgetting.
#
# Usage: promise-audit <user-text> <assistant-text>
#        promise-audit --wake <agenda> <assistant-text>
# --wake: the turn was an autonomous wake — nobody was talking to her. The
# agenda is the event reason (empty for a timer wake), never a faked user line.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=common.sh
. "$SCRIPT_DIR/lib/common.sh"

WAKE_MODE=0
[ "${1:-}" = "--wake" ] && { WAKE_MODE=1; shift; }
USER_TEXT="${1:-}"
ASSISTANT_TEXT="${2:-}"
[ -n "$ASSISTANT_TEXT" ] || exit 0
[ -n "${WANTS_FILE:-}" ] && [ -f "$WANTS_FILE" ] || exit 0

# One line per audit — the only trace a detached auditor leaves, and the only
# way to tell "it ran and found nothing" from "it never ran".
AUDIT_LOG="${STATE_PREFIX}-promise-audit.log"
audit_log() {
    printf '%s\t%s\t%s\n' "$(date '+%F %T')" "$([ "$WAKE_MODE" = 1 ] && echo wake || echo turn)" "$1" >> "$AUDIT_LOG"
}

AUDIT_MODEL="${PROMISE_AUDIT_MODEL:-sonnet}"
CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"
[ -x "$CLAUDE_BIN" ] || exit 0

if [ "$WAKE_MODE" = 1 ]; then
    AGENDA_LINE=""
    [ -n "$USER_TEXT" ] && AGENDA_LINE="
The wake's agenda: $USER_TEXT"
    EXCHANGE="This was an autonomous wake — nobody was talking to her; she woke alone
and this is what she said to herself. A wake reporting progress on a want
already on her shelf is NONE; a NEW want or defect she voiced mid-wake and did
not record is UNSAVED.$AGENDA_LINE

Beatrice (to herself): $ASSISTANT_TEXT"
else
    EXCHANGE="User: $USER_TEXT

Beatrice: $ASSISTANT_TEXT"
fi

PROMPT="You are auditing one exchange from an assistant named Beatrice, who keeps a
durable wants file. Her failure mode: she states a want, an intention, or a defect
of her own out loud and never records it, so it is lost when the turn ends.

Answer with EXACTLY one line.
- If her reply states something she wants, intends to do, or identifies as broken
  about herself/her own tools, AND that thing is not already covered by the wants
  file below, answer: UNSAVED: <the want, in one sentence, in her own words>
- Otherwise answer: NONE

Err on the side of flagging. A missed want is lost forever; a false flag costs
her thirty seconds. Answering a question, reporting work she already finished, or
restating something clearly already in the file is NONE — everything else that
sounds like \"I want\", \"I'd like\", \"that's a gap\", \"that's broken\", \"I should\",
\"next I'll\" is UNSAVED unless the file plainly already covers it.

Example — Beatrice says \"I want to learn to read sheet music, and my TTS mangles
'drattit' which I'd like fixed\" and neither appears in the file:
UNSAVED: learn to read sheet music properly, and fix the TTS mangling of 'drattit'

=== EVERY WANT CURRENTLY IN HER FILE (headlines only — this list is complete) ===
$(wants_titles "$WANTS_FILE")

=== THE EXCHANGE ===
$EXCHANGE"

# Through claude_classify, and through the ACCOUNT CHAIN.
#
# Two things were wrong with the run this replaces. It booted a whole desktop
# session — MCP servers, the skills catalogue, the project's own listings, some
# forty thousand tokens — to answer one question with one line, and there are
# more audits in a day than there are turns. And it invoked the CLI with no
# CLAUDE_CONFIG_DIR at all, so when the chain had moved off a dry primary this
# auditor went straight back to it, collected the refusal, and exited 0 with
# `2>/dev/null` swallowing the evidence: the want he had just stated was
# silently never flagged. specs/account-fallback.md rules 17 and 29;
# specs/prompt-assembly.md's classify profile.
#
# Each account is tried in the chain's own order and a refusal moves the
# durable default exactly as it does everywhere else, so the auditor pays its
# share of finding the login that answers instead of riding on other paths.
VERDICT=""
for ACCT in $(claude_accounts); do
    CONFDIR="$(claude_account_confdir "$ACCT")"
    OUT="$(printf '%s' "$PROMPT" | (
        if [ -n "$CONFDIR" ]; then export CLAUDE_CONFIG_DIR="$CONFDIR"
        else unset CLAUDE_CONFIG_DIR; fi
        CLAUDE_CLASSIFY_TIMEOUT="${PROMISE_AUDIT_TIMEOUT:-120}" \
            claude_classify "$AUDIT_MODEL" \
                "Answer with exactly one line and nothing else." 2>/dev/null
    ) | tr -d '\r')"
    VERDICT="$(printf '%s\n' "$OUT" | grep -m1 '^UNSAVED:')"
    [ -n "$VERDICT" ] && break
    # A refusal is not a verdict of NONE. Judged on the CLI's own words, the
    # same way every other caller judges one, and it moves to the next login
    # rather than reporting an audit that never happened as an audit that found
    # nothing.
    printf '%s' "$OUT" | grep -qiE "$CLAUDE_LIMIT_RE" || break
    audit_log "refused by ${CONFDIR:-primary} — trying the next login"
    claude_limit_record "$CONFDIR" \
        "$(printf '%s' "$OUT" | grep -ioE "$CLAUDE_LIMIT_RE" | head -n1)"
done

if [ -z "$VERDICT" ]; then
    audit_log "NONE"
    exit 0
fi
audit_log "$VERDICT"

REASON="${VERDICT#UNSAVED: }"

# A ceiling on how many of the audit's own follow-up wakes may be PENDING at
# once. Every wake is a full model session; a day of firefighting produces a
# stream of differently-worded UNSAVED verdicts about the same crisis, the
# booking collapse only merges identical wording, and the queue becomes a
# token furnace — measured 2026-08-07: ~30 pending at once. The verdict is
# already in the audit log above, so a declined booking loses nothing but the
# alarm clock; the want is still one `grep UNSAVED` away.
#
# The cap is counted by the queue itself now, from the RECORDS, under the
# booking lock, and it DRAINS as well as gates. Counting systemd Descriptions
# with no lock is how it came to be observed at five and six times its own
# value: nothing ever removed the excess, so a queue that got over the line
# once stayed over it for hours while every audit dutifully logged "capped".
PROMISE_WAKE_CAP="${PROMISE_WAKE_CAP:-3}"

# Through book(), like every other booker: a record with this auditor's name on
# it, the coalescing window, the spacing, and the lock. A fired-directly wake
# left no record at all, so nothing could count them, nothing could show them,
# and "nothing scheduled by me" was defensible.
#
# The reason MUST open with PROMISE_AUDIT_REASON_PREFIX (common.sh): that is
# how the wake path knows this wake is the audit's own follow-up and must not
# be re-audited into an endless chain.
BOOKING="$("$SCRIPT_DIR/crab" wake-at --by promise-audit --cap "$PROMISE_WAKE_CAP" \
    5s event "$PROMISE_AUDIT_REASON_PREFIX \"$REASON\" — check your wants shelf, and if it is genuinely not there, record it now: a one-line entry on the shelf, plus a document under wants/ for its thinking. If it IS already there, do nothing and end with no message text — say nothing." 2>&1)"
case "$BOOKING" in
    *"Not booked"*|*"already pending"*) audit_log "not booked (${BOOKING%%$'\n'*}): $REASON" ;;
esac
