#!/bin/bash
# Detached job worker. Runs ONE claude builder session under the systemd user
# manager, not under the turn that asked for it.
#
# Why this exists: a subagent dispatched from inside a turn is a child of that
# turn's claude process. When the turn ends the child dies, so every "an agent
# is working on it in the background" was false the moment the reply finished —
# and worse, while the turn was alive it held the session open, so the next
# push-to-talk had nothing to talk to. Both halves of that are the same bug:
# work was welded to a conversation. Here systemd owns the process; the turn
# that started it can end a second later and the work carries on.
#
# Silent by contract: nothing here speaks, notifies, or opens windows. The
# job's outputs are its log, its JSON status sidecar, and (when wants are
# configured) one event wake so the assistant hears that it finished.
#
# Usage (called by `crab job`, not by hand):
#   job-runner <id> <workdir>

set -u
ID="$1"; WORKDIR="$2"
START=$(date +%s)

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

mkdir -p "$JOBS_DIR"
LOG="$JOBS_DIR/$ID.log"
STATUS="$JOBS_DIR/$ID.json"
# The stream the live viewer follows. A job used to run with no stream format at
# all, writing plain text to a log outside every glob the viewer looks at, so
# the longest-running and least supervised work in the system was the one piece
# of it nobody could watch. It writes here in the stream format, under the
# prefix crab-debug globs, and $LOG stays exactly what it has always been: the
# human report, which is what the completion wake tells her to read and what the
# day journal keeps.
STREAMLOG="${DESKCRAB_STATE_PREFIX:-/tmp/deskcrab}-debug-job-$ID.log"
: > "$STREAMLOG"
# ...and the job streams are reaped HERE rather than by claim_debuglog's
# three-hour sweep, which is what a desk turn runs. That sweep's rule — three
# quiet hours means a dead session — is true of turns and false of builders: a
# job can sit inside one compile for longer than that without writing a byte,
# and having its live stream unlinked underneath it emptied the attempt slice,
# blinded the limit test, and left a blocked run with nothing to record. A job
# stream is dropped when its JOB has ended, which is a question only this side
# can ask.
for _s in "${DESKCRAB_STATE_PREFIX:-/tmp/deskcrab}"-debug-job-*.log; do
    [ -e "$_s" ] || continue
    [ "$_s" = "$STREAMLOG" ] && continue
    _sid="${_s##*-debug-job-}"; _sid="${_sid%.log}"
    case "$("$LIB_DIR/job-status" get "$JOBS_DIR/$_sid.json" state 2>/dev/null)" in
        running) continue ;;
    esac
    find "$_s" -mmin +180 -delete 2>/dev/null
done
unset _s _sid
TASK="$("$LIB_DIR/job-status" get "$STATUS" description)"
[ -n "$TASK" ] || { echo "job-runner: no status file (or empty task) for $ID" >> "$LOG"; exit 1; }
# The engineering record this build was dispatched against, if any (jobs.md
# rules 7b and 27-29, specs/engineering-records.md). Success is gated below on
# the record having been touched after dispatch — the sidecar's started_epoch
# is the dispatch time, written before this worker existed.
RECORD="$("$LIB_DIR/job-status" get "$STATUS" record 2>/dev/null)"
DISPATCH_EPOCH="$("$LIB_DIR/job-status" get "$STATUS" started_epoch 2>/dev/null)"
ENG_DIR="$(deskcrab_home)/engineering/records"

# The pid and its start time let `crab jobs` tell a hard-killed job from a
# running one — a SIGKILLed worker never gets to write its own outcome.
"$LIB_DIR/job-status" set "$STATUS" pid=$$ pidstart="$(_proc_starttime $$)" stream="$STREAMLOG"
# systemctl stop TERMs the whole unit: claude dies first, then this trap runs.
# Without it a deliberately stopped job would look identical to a crashed one.
# The day journal gets the stop too, with whatever log the job managed to write.
trap '"$LIB_DIR/job-status" set "$STATUS" state=stopped finished=now; day_journal_append job "$START" "$(( $(date +%s) - START ))" "$$" "$TASK" "$(cat "$LOG" 2>/dev/null)" "stopped"; exit 143' TERM

CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"

# A builder writes freely in its workdir and this runner writes the job log —
# declare both for the self-change watcher, for as long as a job may run, so
# a build in her own repo never reads as an intruder's hand. Renewed after the
# run to cover the report and any trailing writes.
touch_suppress -w "${JOB_TOUCH_WINDOW:-14400}" "$WORKDIR" "$JOBS_DIR" 2>/dev/null

# A builder, not a persona. It reports back to the assistant, and it is told
# plainly that unproven work must be reported as unproven — the failure this
# whole mechanism exists to end is a confident "done" behind which nothing ran.
SYS="You are a detached build agent working for $ASSISTANT_NAME on her own machine.
Nobody is watching this run and nothing you output is spoken or shown: work
silently — never use TTS, notify-send, or windows; file output only. Your final
message is a report she will read later in $LOG, so make it concrete — what you
changed, file:line, what you ran, and what the output was.

Hard rules:
- Test what you claim. If you could not verify something, say so in plain words
  rather than implying it works. An unproven claim is worse than an admitted gap.
- Run long commands in the FOREGROUND and wait for them. Your session — and
  everything it left running in the background — is killed the moment your
  final message is written, so a backgrounded command is work that silently
  never happens. If something must outlive you, dispatch it with 'crab job'.
- If you commit, stage with an explicit \`git add -- <paths>\` (never \`git add -A\`;
  another hand may have files open in the same repo).
- Read the repo's CLAUDE.md before changing anything in it.
- If the task turns out to be wrong or impossible, stop and report why. Do not
  invent adjacent work to have something to show."

# A build against an engineering record owes that record its outcome
# (jobs.md rule 29). Said in the prompt, because the gate below is real: a
# builder that never hears about the obligation can only ever fail it.
if [ -n "$RECORD" ]; then
    SYS="$SYS

This job was dispatched against engineering record '$RECORD'. Before your
final message, write your outcome into that record:
  crab eng touch $RECORD '<what you did, what you ran, what it showed>'
This is a hard condition of success: the runner refuses to mark this job
finished unless the record has been touched since dispatch. Read it first
with 'crab eng show $RECORD' so your entry lands on the thread it answers."
fi

cd "$WORKDIR" 2>/dev/null || cd "$HOME"
# Deliberately NOT prefixed with $CLAUDE_NO_AUTO_MEMORY, unlike every other
# claude run in this project (see the comment on it in lib/common.sh). That
# switch exists to keep the WORKDIR's auto-memory out of HER prompt, because
# it is the user's coding agent's memory and she is not that agent. A builder
# is: it is a headless coding session working inside his project, and the
# project's own memory index is precisely the rules it should arrive knowing.
# A login refusing over a usage/session limit is not a dead job: the build moves
# to the next account and only a chain with nothing left in it blocks. Accounts
# known dry are skipped outright — paying a doomed CLI boot and refusal in front
# of every build buys nothing. Each refusal stamps its account, so the next job
# starts past it too.
#
# ATT_OFF marks where the current attempt's output begins: every judgement below
# reads only the final attempt's slice of the STREAM, so an earlier attempt's
# refusal kept as history can never masquerade as the last one's outcome.
ATT_OFF=$(wc -c < "$STREAMLOG" 2>/dev/null || echo 0)
RC=0
ATTEMPT=0
for ACCT in $(claude_accounts); do
    CONFDIR="$(claude_account_confdir "$ACCT")"
    ATTEMPT=$(( ATTEMPT + 1 ))
    if [ -n "$CONFDIR" ]; then
        if [ "$ATTEMPT" = 1 ]; then
            echo "job-runner: default login is CLAUDE_CONFIG_DIR=$CONFDIR — building there" >> "$LOG"
        else
            echo "job-runner: login refused (limit) — retrying via CLAUDE_CONFIG_DIR=$CONFDIR" >> "$LOG"
        fi
    fi
    ATT_OFF=$(wc -c < "$STREAMLOG" 2>/dev/null || echo 0)
    (
        # "The primary login" is the ABSENCE of the variable, not whatever the
        # environment arrived holding — and a job dispatched from a turn that
        # was already on a fallback inherits it (job_start forwards it on
        # purpose). Left standing, the chain's first slot re-ran the account
        # that had just refused and the true primary was never tried.
        if [ -n "$CONFDIR" ]; then export CLAUDE_CONFIG_DIR="$CONFDIR"
        else unset CLAUDE_CONFIG_DIR; fi
        # The job profile: no MCP servers and no skills catalogue, and
        # deliberately no --tools restriction — a builder needs whatever the
        # work needs. See claude_profile_flags; --tools without the empty MCP
        # config is the shape that TRIPLES the context.
        claude_profile_flags job
        # $LOG fills AS the builder writes, not at completion. This used to
        # exec straight into $STREAMLOG and turn the attempt's slice back into
        # prose only after the CLI exited, so for a running job `crab job log`
        # showed nothing, a stopped one kept nothing, and both were read, over
        # and over, as "the job produced nothing". The tee keeps $STREAMLOG
        # byte-identical for the viewer and the refusal slices below; the
        # filter (lib/job-log-stream) writes the human report event by event,
        # so a job killed mid-build leaves exactly what it had said by then.
        # The subshell's exit code must stay the CLI's own — tee and the
        # filter exit 0 whatever happened in front of them.
        "$CLAUDE_BIN" -p --dangerously-skip-permissions \
            --model "$JOB_MODEL" --effort "$JOB_EFFORT" \
            --verbose --output-format stream-json \
            "${CLAUDE_PROFILE_FLAGS[@]}" \
            --append-system-prompt "$SYS" \
            "$TASK" 2>&1 \
            | tee -a "$STREAMLOG" \
            | "$LIB_DIR/job-log-stream" >> "$LOG"
        exit "${PIPESTATUS[0]}"
    )
    RC=$?
    [ "$RC" -ne 0 ] || break
    # Judged on the CLI's OWN events in this attempt's slice, never on its raw
    # bytes. A stream carries every byte of every tool result, so grepping it
    # for the limit signature made a builder that merely READ a file
    # containing the wording — lib/common.sh, which holds the signature's own
    # patterns — and then exited non-zero for any reason look like an account
    # refusal: the durable default rotated and every further dispatch was held
    # for half an hour, on the strength of a file the builder opened.
    # claude_stream_refusal is the same judgement the turn and wake chains use
    # — and so is the mid-build CUT (specs/jobs.md rule 15a, account-fallback
    # rule 12a): a limit that stops a builder half-way through its work moves
    # the build to the next login at once, exactly as a refusal does, instead
    # of journalling the CLI's complaint as the builder's closing words. Four
    # builders died that way inside ten minutes on the night of 2026-08-11.
    # A final attempt that ends cut stays a real failure, never blocked — the
    # blocked judgement below still demands no genuine output at all.
    REFUSAL="$(claude_stream_refusal "$STREAMLOG" "$ATT_OFF")" \
        || REFUSAL="$(claude_stream_limit_cut "$STREAMLOG" "$ATT_OFF")" \
        || break
    claude_limit_record "$CONFDIR" "$REFUSAL"
done
trap - TERM

# Renewed: the status write, the day journal, and the completion wake below
# all still touch her files after a run that may have outlived the first
# declaration's window.
touch_suppress -w 900 "$WORKDIR" "$JOBS_DIR" 2>/dev/null

STATE=finished
[ "$RC" -eq 0 ] || STATE=failed
# The record hook (jobs.md rules 27-28): a build dispatched against an
# engineering record may not end successful unless that record's last_touched
# is newer than this job's dispatch — the builder wrote its outcome back to
# the thread it came from. The comparison is asked of the tool that owns the
# format, never re-implemented here; a record the drawer no longer holds
# fails the same way, because an untouchable record cannot pass. A run that
# failed on its own keeps its own reason, and a blocked run never began, so
# no record was owed.
RECORD_UNTOUCHED=""
if [ "$STATE" = finished ] && [ -n "$RECORD" ]; then
    if ! DESKCRAB_ENG_DIR="$ENG_DIR" python3 "$LIB_DIR/eng" \
            touched-since "$RECORD" "${DISPATCH_EPOCH:-0}" 2>/dev/null; then
        STATE=failed
        RC=1
        RECORD_UNTOUCHED=1
        echo "job-runner: the build ran clean, but engineering record '$RECORD' was never updated — its last_touched is not newer than this job's dispatch. A job dispatched against a record succeeds only by writing its outcome back to it (crab eng touch $RECORD '...'). Marked failed; the work above may still be real, so read the log and the record before repeating it." >> "$LOG"
    fi
fi
SUMMARY="$(tail -c 600 "$LOG" | tr '\n\t' '  ' | sed 's/  */ /g')"
# A build that never began is its own outcome. Reported as "failed" it reads as
# a builder that tried and got it wrong, which sends the next wake to read a log
# holding nothing but a refusal — and leaves the standing dispatch policy free
# to send the next builder into the same wall.
BLOCKED=""
if [ "$RC" -ne 0 ]; then
    # The same event-level judgement as the retry decision above, on the same
    # slice: blocked means the CLI's own words refused and no model output
    # exists. A build that ran and failed has model output, so it can never
    # land here (specs/jobs.md rule 15).
    BLOCKED="$(claude_stream_refusal "$STREAMLOG" "$ATT_OFF")" || BLOCKED=""
    if [ -n "$BLOCKED" ]; then
        STATE=blocked
        job_block_record "$BLOCKED"
    fi
fi
"$LIB_DIR/job-status" set "$STATUS" state="$STATE" exit="$RC" finished=now summary="$SUMMARY"

# The durable day record: the task in full, the report in full. A job is a
# turn of the day like any other — it just had nobody waiting on it.
day_journal_append job "$START" "$(( $(date +%s) - START ))" "$$" \
    "$TASK" "$(cat "$LOG" 2>/dev/null)" "$STATE (exit $RC)"

# Tell her it landed — via an event wake, not a voice: whether anything gets
# said out loud is the wake's own decision, made by the usual busy/quiet rules.
if [ "$STATE" = blocked ]; then
    # Nothing ran, so there is nothing to read and nothing to verify. Say that
    # plainly instead of sending the next wake to audit an empty log.
    WAKE_REASON="Detached job $ID never began: ${BLOCKED:-the CLI refused to run}. NO WORK WAS ATTEMPTED and the log holds only the refusal — do not read it looking for results. Task still undone: $(printf '%.200s' "$TASK"). Further dispatches are held for $(( JOB_BLOCK_RETRY / 60 )) min; do the work by hand if it is small, or leave it for later."
elif [ -n "$RECORD_UNTOUCHED" ]; then
    # The build ran clean and the obligation did not: the record it was
    # dispatched against was never touched (jobs.md rule 28). Name the record
    # in the one channel that reaches her, so the next reader knows what is
    # owed before deciding whether the work itself needs repeating.
    WAKE_REASON="Detached job $ID FAILED because engineering record '$RECORD' was never updated: the build ran, but its last_touched is older than the dispatch. Read $LOG, and if the work is real, write the outcome yourself with crab eng touch $RECORD — the thread must carry what happened to it. Task was: $(printf '%.200s' "$TASK")"
else
    WAKE_REASON="Detached job $ID finished ($STATE, exit $RC). Task was: $(printf '%.200s' "$TASK") — full output in $LOG. Read it and verify its claims yourself before repeating them."
fi
# ...but not when this runner is a test. A scratch run gets its own JOBS_DIR so
# it cannot dirty the live jobs directory — and on 2026-08-07 one still woke me
# for real, about a job called "testid" whose task was "do a thing", leaving no
# log and no sidecar anywhere for me to find. Isolating what a test may TOUCH
# and what it may SPEND says nothing about who it may INTERRUPT. A run that is
# not the live jobs directory does not get to reach the live me.
LIVE_JOBS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/deskcrab/jobs"
SCRATCH_RUN=""
if [ -n "${DESKCRAB_NO_DISPATCH:-}" ] || [ "$JOBS_DIR" != "$LIVE_JOBS_DIR" ]; then
    SCRATCH_RUN=1
fi

# A blocked job's brief must not wait on her happening to notice (jobs.md rules
# 18a-18f). The wake above ANNOUNCES that the task is still undone, but until
# now nothing re-dispatched it: the block marker expired on its own and the
# brief sat in the sidecar until a hand found it. So: one transient timer, for
# the retry window plus a margin — past the marker's own expiry, so the fired
# dispatch is the retry probe and not another refusal at the preflight. The
# fire side (lib/job-block-retry) re-reads the sidecar and does every check
# there, where the facts will be current, not here, where they are guesses
# about the future. Never armed for a job that is itself a retry: a brief gets
# exactly one automatic shot, or two dry accounts would volley it forever.
if [ "$STATE" = blocked ]; then
    ORIGIN_OF="$("$LIB_DIR/job-status" get "$STATUS" retry_of 2>/dev/null)"
    if [ -n "$SCRATCH_RUN" ]; then
        echo "job-runner: scratch run ($JOBS_DIR) — block retry not armed" >> "$LOG"
    elif [ -n "$ORIGIN_OF" ]; then
        echo "job-runner: this job was itself the one automatic retry (of $ORIGIN_OF) — not arming another; the task stays undone for a hand to notice" >> "$LOG"
    else
        RETRY_IN=$(( JOB_BLOCK_RETRY + 60 ))
        # CLAUDE_CONFIG_DIR is deliberately NOT forwarded into the timer's
        # unit: the fired dispatch must ask claude_preferred_login at fire
        # time, so the brief goes out on whatever account the chain has since
        # rotated to — never pinned to the login that just refused.
        if systemd-run --user --collect --quiet --unit="deskcrab-job-retry-$ID" \
            --on-active="${RETRY_IN}s" \
            --setenv=PATH="$HOME/.local/bin:$PATH" \
            --setenv=DESKCRAB_CONF="$CONF_FILE" \
            --setenv=DESKCRAB_STATE_PREFIX="$STATE_PREFIX" \
            --setenv=JOBS_DIR="$JOBS_DIR" \
            --setenv=CLAUDE_BIN="${CLAUDE_BIN:-}" \
            --setenv=JOB_MODEL="$JOB_MODEL" \
            --setenv=JOB_EFFORT="$JOB_EFFORT" \
            "$LIB_DIR/job-block-retry" "$ID" 2>/dev/null; then
            echo "job-runner: the brief re-dispatches itself once, in $(( RETRY_IN / 60 )) min (unit deskcrab-job-retry-$ID)" >> "$LOG"
        else
            # No user manager: the same shape job_start falls back to.
            ( setsid bash -c 'sleep "$1"; exec "$2" "$3"' _ "$RETRY_IN" \
                "$LIB_DIR/job-block-retry" "$ID" >/dev/null 2>&1 </dev/null & )
            echo "job-runner: the brief re-dispatches itself once, in $(( RETRY_IN / 60 )) min (setsid — no user manager)" >> "$LOG"
        fi
    fi
fi

if [ -n "$SCRATCH_RUN" ]; then
    echo "job-runner: scratch run ($JOBS_DIR) — event wake suppressed: $WAKE_REASON" >> "$LOG"
elif [ -n "$WANTS_FILE" ]; then
    "$SCRIPT_DIR/crab" wake-at --by job-runner 5s event "$WAKE_REASON" >/dev/null 2>&1
fi

exit "$RC"
