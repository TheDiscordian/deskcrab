#!/bin/bash
# Detached job worker. Runs ONE claude builder session under the systemd user
# manager, not under the turn that asked for it.
#
# Why this exists: a subagent dispatched from inside a turn is a child of that
# turn's claude process. When the turn ends the child dies, so every "an agent
# is working on it in the background" was false the moment the reply finished —
# and worse, while the turn was alive it held the session open, so the next
# push-to-talk had nothing to talk to. Both halves of that are the same bug:
# work was welded to a conversation. Here systemd owns the process; the turn
# that started it can end a second later and the work carries on.
#
# Silent by contract: nothing here speaks, notifies, or opens windows. The
# job's outputs are its log, its JSON status sidecar, and (when wants are
# configured) one event wake so the assistant hears that it finished.
#
# Usage (called by `crab job`, not by hand):
#   job-runner <id> <workdir>

set -u
ID="$1"; WORKDIR="$2"
START=$(date +%s)

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

mkdir -p "$JOBS_DIR"
LOG="$JOBS_DIR/$ID.log"
STATUS="$JOBS_DIR/$ID.json"
TASK="$("$LIB_DIR/job-status" get "$STATUS" description)"
[ -n "$TASK" ] || { echo "job-runner: no status file (or empty task) for $ID" >> "$LOG"; exit 1; }

# The pid and its start time let `crab jobs` tell a hard-killed job from a
# running one — a SIGKILLed worker never gets to write its own outcome.
"$LIB_DIR/job-status" set "$STATUS" pid=$$ pidstart="$(_proc_starttime $$)"
# systemctl stop TERMs the whole unit: claude dies first, then this trap runs.
# Without it a deliberately stopped job would look identical to a crashed one.
# The day journal gets the stop too, with whatever log the job managed to write.
trap '"$LIB_DIR/job-status" set "$STATUS" state=stopped finished=now; day_journal_append job "$START" "$(( $(date +%s) - START ))" "$$" "$TASK" "$(cat "$LOG" 2>/dev/null)" "stopped"; exit 143' TERM

CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"

# A builder writes freely in its workdir and this runner writes the job log —
# declare both for the self-change watcher, for as long as a job may run, so
# a build in her own repo never reads as an intruder's hand. Renewed after the
# run to cover the report and any trailing writes.
touch_suppress -w "${JOB_TOUCH_WINDOW:-14400}" "$WORKDIR" "$JOBS_DIR" 2>/dev/null

# A builder, not a persona. It reports back to the assistant, and it is told
# plainly that unproven work must be reported as unproven — the failure this
# whole mechanism exists to end is a confident "done" behind which nothing ran.
SYS="You are a detached build agent working for $ASSISTANT_NAME on her own machine.
Nobody is watching this run and nothing you output is spoken or shown: work
silently — never use TTS, notify-send, or windows; file output only. Your final
message is a report she will read later in $LOG, so make it concrete — what you
changed, file:line, what you ran, and what the output was.

Hard rules:
- Test what you claim. If you could not verify something, say so in plain words
  rather than implying it works. An unproven claim is worse than an admitted gap.
- Run long commands in the FOREGROUND and wait for them. Your session — and
  everything it left running in the background — is killed the moment your
  final message is written, so a backgrounded command is work that silently
  never happens. If something must outlive you, dispatch it with 'crab job'.
- If you commit, stage with an explicit \`git add -- <paths>\` (never \`git add -A\`;
  another hand may have files open in the same repo).
- Read the repo's CLAUDE.md before changing anything in it.
- If the task turns out to be wrong or impossible, stop and report why. Do not
  invent adjacent work to have something to show."

cd "$WORKDIR" 2>/dev/null || cd "$HOME"
# Deliberately NOT prefixed with $CLAUDE_NO_AUTO_MEMORY, unlike every other
# claude run in this project (see the comment on it in lib/common.sh). That
# switch exists to keep the WORKDIR's auto-memory out of HER prompt, because
# it is the user's coding agent's memory and she is not that agent. A builder
# is: it is a headless coding session working inside his project, and the
# project's own memory index is precisely the rules it should arrive knowing.
# ATT_OFF marks where the current attempt's output begins: every judgement
# below reads only the final attempt's slice of the log, so a first-attempt
# refusal kept as history can never masquerade as the retry's outcome.
ATT_OFF=$(wc -c < "$LOG" 2>/dev/null || echo 0)
"$CLAUDE_BIN" -p --dangerously-skip-permissions \
    --model "$JOB_MODEL" --effort "$JOB_EFFORT" \
    --append-system-prompt "$SYS" \
    "$TASK" >> "$LOG" 2>&1
RC=$?
# A login refusing over a usage/session limit is not a dead job: run the build
# again on each remaining account in the fallback chain before declaring
# anything. ATT_OFF moves to the head of every attempt, so each account's
# refusal is judged on its own bytes and the loop stops the moment one of them
# either works or fails for some other reason.
for FBDIR in $(claude_fallback_dirs); do
    [ "$RC" -ne 0 ] || break
    tail -c +$(( ATT_OFF + 1 )) "$LOG" | grep -qiE "$CLAUDE_LIMIT_RE" || break
    echo "job-runner: login refused (limit) — retrying via CLAUDE_CONFIG_DIR=$FBDIR" >> "$LOG"
    ATT_OFF=$(wc -c < "$LOG")
    CLAUDE_CONFIG_DIR="$FBDIR" "$CLAUDE_BIN" -p --dangerously-skip-permissions \
        --model "$JOB_MODEL" --effort "$JOB_EFFORT" \
        --append-system-prompt "$SYS" \
        "$TASK" >> "$LOG" 2>&1
    RC=$?
done
trap - TERM

# Renewed: the status write, the day journal, and the completion wake below
# all still touch her files after a run that may have outlived the first
# declaration's window.
touch_suppress -w 900 "$WORKDIR" "$JOBS_DIR" 2>/dev/null

SUMMARY="$(tail -c 600 "$LOG" | tr '\n\t' '  ' | sed 's/  */ /g')"
STATE=finished
[ "$RC" -eq 0 ] || STATE=failed
# A build that never began is its own outcome. Reported as "failed" it reads as
# a builder that tried and got it wrong, which sends the next wake to read a log
# holding nothing but a refusal — and leaves the standing dispatch policy free
# to send the next builder into the same wall.
BLOCKED=""
if [ "$RC" -ne 0 ] && tail -c +$(( ATT_OFF + 1 )) "$LOG" | grep -qiE "$CLAUDE_LIMIT_RE"; then
    STATE=blocked
    BLOCKED="$(tail -c +$(( ATT_OFF + 1 )) "$LOG" | grep -ihoE "$CLAUDE_LIMIT_RE" | head -n1)"
    job_block_record "${BLOCKED:-the CLI refused to run}"
fi
"$LIB_DIR/job-status" set "$STATUS" state="$STATE" exit="$RC" finished=now summary="$SUMMARY"

# The durable day record: the task in full, the report in full. A job is a
# turn of the day like any other — it just had nobody waiting on it.
day_journal_append job "$START" "$(( $(date +%s) - START ))" "$$" \
    "$TASK" "$(cat "$LOG" 2>/dev/null)" "$STATE (exit $RC)"

# Tell her it landed — via an event wake, not a voice: whether anything gets
# said out loud is the wake's own decision, made by the usual busy/quiet rules.
if [ "$STATE" = blocked ]; then
    # Nothing ran, so there is nothing to read and nothing to verify. Say that
    # plainly instead of sending the next wake to audit an empty log.
    WAKE_REASON="Detached job $ID never began: ${BLOCKED:-the CLI refused to run}. NO WORK WAS ATTEMPTED and the log holds only the refusal — do not read it looking for results. Task still undone: $(printf '%.200s' "$TASK"). Further dispatches are held for $(( JOB_BLOCK_RETRY / 60 )) min; do the work by hand if it is small, or leave it for later."
else
    WAKE_REASON="Detached job $ID finished ($STATE, exit $RC). Task was: $(printf '%.200s' "$TASK") — full output in $LOG. Read it and verify its claims yourself before repeating them."
fi
# ...but not when this runner is a test. A scratch run gets its own JOBS_DIR so
# it cannot dirty the live jobs directory — and on 2026-08-07 one still woke me
# for real, about a job called "testid" whose task was "do a thing", leaving no
# log and no sidecar anywhere for me to find. Isolating what a test may TOUCH
# and what it may SPEND says nothing about who it may INTERRUPT. A run that is
# not the live jobs directory does not get to reach the live me.
LIVE_JOBS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/deskcrab/jobs"
if [ -n "${DESKCRAB_NO_DISPATCH:-}" ] || [ "$JOBS_DIR" != "$LIVE_JOBS_DIR" ]; then
    echo "job-runner: scratch run ($JOBS_DIR) — event wake suppressed: $WAKE_REASON" >> "$LOG"
elif [ -n "$WANTS_FILE" ]; then
    "$SCRIPT_DIR/crab" wake-at 5s event "$WAKE_REASON" >/dev/null 2>&1
fi

exit "$RC"
