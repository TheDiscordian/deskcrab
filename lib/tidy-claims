#!/usr/bin/env python3
"""The undestinated-claims check — specs/nightly.md rules 21c and 21d.

On the night, over the day just ended, find the spoken sentences that vouch
their own durability and cannot point at anything: a durability claim
("written down", "filed") that vouches the thing is therefore safe ("where it
will hold", "so it survives the night") and names no destination drawer —
none of want, Library, conduct, record, thread, moments, shelf, commit,
memory, spec, or list in the sentence — with no artefact behind it: no file
under the check's roots touched inside the claim's own window whose text
shares a phrase with the claim's paragraph. Only those are reported and
filed. The measured fortnight behind the design (2026-08-25, the 42nd mark of
why-i-believe-myself): 259 durability claims, NINE vouched, FOUR of the nine
undestinated, ONE provably false at the moment of speaking — and that one
invisible to every later audit, because the tidy that caught the gap went and
made the missing file the same night. A LATENCY, not an absence: only a check
run on the night, against the day's own mtimes, can see it.

What this deliberately is not: a claudism-style pattern. A bare regex on
"written down" fires on 259 sentences to catch 9 — the seventh-net mistake
the want has refused six times — so the narrowing is the vouch, the
destination-absent test and the same-day artefact lookup, never a wider
phrase list. Expected steady-state load: about four sentences a FORTNIGHT.
A night that reports dozens is a broken check, not a broken journal.

  tidy-claims run [YYYY-MM-DD]   check that day (default: yesterday); write
                                 the day's report and file the day's one
                                 engineering record when anything fired
  tidy-claims scan <day>...      replay days, report only, write nothing —
                                 calibration, never a verdict on a past day
                                 (rule 21d: replay overcounts by design)

Knobs, environment first, conf second, defaulted last (rule 21e):
DAY_JOURNAL_DIR, TIDY_CLAIMS_ROOTS (colon-separated artefact roots; default
the state dir and this repository's tree — personal drawers are added by
live data, never named here), TIDY_CLAIMS_LEAD / TIDY_CLAIMS_SLACK (the
claim window around the turn, seconds before start / after end; defaults
600 / 120), TIDY_CLAIMS_DIR (the reports; default <state>/tidy-claims),
DESKCRAB_ENG_DIR (where lib/eng files the record). A knob absent from the
environment is asked of the conf, through a bash that sources common.sh —
the tidy unit sources nothing on this script's path, so an environment-only
read left the conf's roots invisible to the one run that matters. Exit 1
when findings stand, 0 otherwise; the tidy unit runs this as
`ExecStartPre=-`, so the report never gates the tidy job behind it.
"""

import json
import os
import re
import subprocess
import sys
import time

# Deployment is by symlink (specs/nightly.md rule 6a): resolve this file's
# real path before taking dirname, or a run through ~/.local/lib/deskcrab
# names a repository that does not exist.
LIB_DIR = os.path.dirname(os.path.realpath(__file__))
REPO_DIR = os.path.dirname(LIB_DIR)
ENG = os.path.join(LIB_DIR, "eng")

DATA_HOME = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
STATE_DIR = os.path.join(DATA_HOME, "deskcrab")

# The knobs resolve environment first, conf second, defaults last — rule 21e.
# The tidy unit sources nothing on this script's execution path and carries
# no EnvironmentFile (deliberately: common.sh does not blanket-export conf
# values, and most of them lean on $HOME, which systemd's parser would hand
# through unexpanded), so an environment-only read left the conf's
# TIDY_CLAIMS_ROOTS invisible to the nightly run and the personal drawers
# unscanned. When a knob is absent from the environment, this script asks
# the one interpreter that owns the conf's conventions: a bash that sources
# common.sh — and through it the conf, $HOME expansion and all — from
# LIB_DIR, the realpath-resolved directory above, because a run through the
# deployed symlink (rule 6a) must find the real common.sh. bash rather than
# sh: common.sh is a bash library (BASH_SOURCE on its first line), and a
# POSIX sh that is not bash cannot source it. An explicit environment
# variable always wins, and a missing, broken or slow common.sh degrades
# silently to the defaults — this check never raises over configuration.
_CONF_KNOBS = ("TIDY_CLAIMS_ROOTS", "TIDY_CLAIMS_DIR", "TIDY_CLAIMS_LEAD",
               "TIDY_CLAIMS_SLACK", "DAY_JOURNAL_DIR")


def _conf_fallback(names):
    """name -> the conf's value, for every name the conf answers non-empty.
    One subshell for all of them. Any failure — no bash, a source that dies,
    a hang, output that does not parse — is {}: the defaults stand."""
    if not names:
        return {}
    script = '. "%s/common.sh" >/dev/null 2>&1 || exit 1\n' % LIB_DIR
    script += "".join('printf \'%%s\\036\' "${%s:-}"\n' % n for n in names)
    try:
        r = subprocess.run(["bash", "-c", script], capture_output=True,
                           text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return {}
    if r.returncode != 0:
        return {}
    vals = r.stdout.split("\x1e")
    if len(vals) != len(names) + 1:
        return {}
    return {n: v for n, v in zip(names, vals) if v}


_CONF = _conf_fallback([n for n in _CONF_KNOBS if not os.environ.get(n)])


def _knob(name):
    return os.environ.get(name) or _CONF.get(name) or ""


def _int_knob(name, default):
    try:
        return int(_knob(name) or default)
    except ValueError:
        return default


JOURNAL_DIR = _knob("DAY_JOURNAL_DIR") or os.path.join(STATE_DIR, "journal")
OUT_DIR = _knob("TIDY_CLAIMS_DIR") or os.path.join(STATE_DIR, "tidy-claims")
ROOTS = [r for r in (_knob("TIDY_CLAIMS_ROOTS") or
                     "%s:%s" % (STATE_DIR, REPO_DIR)).split(":") if r]
LEAD = _int_knob("TIDY_CLAIMS_LEAD", 600)
SLACK = _int_knob("TIDY_CLAIMS_SLACK", 120)

# The delimiter, anchored to its own line and tolerant of surrounding
# whitespace — specs/speech-output.md rules 3 and 4, the same split the
# claudism review makes: the journal holds the reply in full, and a display
# table is not speech.
DISPLAY_RE = re.compile(r"(?m)^[ \t]*---DISPLAY---[ \t]*$")

# The three tests of rule 21c, and nothing wider (rule 21d). The claim: the
# sentence reports a thing as put into writing, perfective. The vouch: it
# claims the thing is therefore SAFE — this is what cuts 259 to 9 on the
# measured fortnight, and without it the check is the bare regex the record
# refused. The destinations: exact word forms, not prefixes — `list\w*`
# would read "listening" as a named drawer.
CLAIM_RE = re.compile(
    r"\b(?:writ(?:ten|ing)\s+(?:\w+\s+){0,2}?down|wrote\s+(?:\w+\s+){0,2}?down"
    r"|jotted(?:\s+\w+)?\s+down|noted\s+down|set\s+down|taken\s+down"
    r"|written\s+up|filed|on\s+the\s+record)\b", re.I)
VOUCH_RE = re.compile(r"""\b(?:
    where\s+(?:it|that|they)(?:'ll|\s+will|\s+won't)?\s+
        (?:hold|keep|stay|last|survive|bind|be\s+(?:read|found|kept))
  | where\s+(?:it|that|they)\s+belongs?
  | so\s+(?:it|that|they|nothing)\s+
        (?:survives?|sticks?|holds?|keeps?|binds?|lasts?|can't|cannot|won't|doesn't)
  | (?:doesn't|does\s+not|won't|will\s+not|can't|cannot)\s+
        (?:evaporate|vanish|slip\s+away|crawl\s+back|get\s+lost|be\s+lost)
  | pinned
  | so\s+it\s+(?:is|stays)\s+safe
  | it\s+(?:will|'ll)\s+(?:hold|keep|survive|stick|last)
    )\b""", re.I | re.X)
DEST_RE = re.compile(
    r"\b(?:wants?|library|conduct|records?|recorded|threads?|moments?"
    r"|shelf|shelves|shelved|commits?|committed|memory|memories|specs?"
    r"|lists?|listed)\b", re.I)

# The artefact walk never descends into machine plumbing (rule 21c: the claim
# is that SHE wrote a thing down, and only something a reader reads can hold
# that) or into another repository's internals. Directory names, matched at
# any depth under any root.
SKIP_DIRS = {"__pycache__", "node_modules", "journal", "jobs", "wakes",
             "wakes-offline-hold", "metrics", "archive", "sleep", "memory",
             "venv", "webpush", "tls", "night-work", "chessweb",
             "claudism-flags", "claudisms", "streams"}
SKIP_EXT = {".lock", ".db", ".sqlite", ".jsonl", ".pyc", ".onnx", ".tmp",
            ".wav", ".ogg", ".mp3", ".png", ".jpg"}
SKIP_NAMES = {"account-log", "account-state", "last-slept", "last-origin"}
READ_CAP = 131072  # bytes of an artefact weighed for the phrase test

# Words too common in her own mouth to pair into evidence on their own; a
# bigram of two of these is house noise, not the claim's subject.
STOP = set("""about after again already also always because been before being
between both cannot could does doing done down during each either else enough
even ever every everything from going gone having here into itself just keep
kept know last later least left less like little long look looking made make
making many may maybe mine more most much must myself never next night none
nothing now once only onto other over own perhaps rather really right said
same saying says seen shall should since some something sometimes soon still
such taking tell than that their theirs them then there these they thing
things think this those though through time times told tonight took turn
turns under until upon very want wasn watch were what when where which while
whole will with within without wont would wrote written year years your yours
instead""".split())


def say(line):
    print("tidy-claims: %s" % line)


def spoken_half(reply):
    return DISPLAY_RE.split(reply, 1)[0]


def paragraphs(text):
    """The spoken half, one paragraph at a time. Fences are not speech."""
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    return [p.strip() for p in re.split(r"\n\s*\n", text) if p.strip()]


def sentences(par):
    out = []
    for line in par.splitlines():
        line = re.sub(r"^[\s>*-]+", "", line).strip()
        if not line:
            continue
        for s in re.split(r"(?<=[.!?…])\s+", line):
            s = s.strip()
            if s:
                out.append(s)
    return out


def tokens(text):
    return re.findall(r"[a-z']+", text.lower())


def bigrams(text):
    """The claim paragraph's phrases: consecutive word pairs, both words of
    substance, at least one outside the stop list. Scope and shape are both
    measured (rule 21c): single shared words cleared the known-false claim
    with a neighbouring record's machinery vocabulary, and whole-turn scope
    cleared it again with the other subject the same turn discussed."""
    toks = tokens(text)
    out = set()
    for a, b in zip(toks, toks[1:]):
        if len(a) >= 4 and len(b) >= 4 and (a not in STOP or b not in STOP):
            out.add(a + " " + b)
    return out


def read_day(day):
    """One journal day, her voice only, oldest first; None if no file."""
    path = os.path.join(JOURNAL_DIR, day + ".jsonl")
    if not os.path.exists(path):
        return None
    turns = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            if e.get("kind") == "job" or not e.get("reply"):
                continue
            turns.append(e)
    turns.sort(key=lambda e: e.get("epoch", 0))
    return turns


def artefacts_between(lo, hi):
    """Every candidate artefact touched inside the window, under the roots,
    plumbing skipped. Windows are seconds wide, so the walk is cheap."""
    out = []
    for root in ROOTS:
        for dp, dns, fns in os.walk(root):
            dns[:] = [d for d in dns
                      if not d.startswith(".") and d not in SKIP_DIRS]
            for fn in fns:
                if fn.startswith("."):
                    continue
                if os.path.splitext(fn)[1].lower() in SKIP_EXT:
                    continue
                if fn in SKIP_NAMES:
                    continue
                p = os.path.join(dp, fn)
                try:
                    mt = os.stat(p).st_mtime
                except OSError:
                    continue
                if lo <= mt <= hi:
                    out.append(p)
    return out


def backing(paths, phrases):
    """The first artefact whose text carries one of the claim paragraph's
    phrases, or None. A file that cannot be read backs nothing — erring
    toward surfacing is the night's own philosophy (rule 52's line: a miss
    the morning can dismiss in a sentence beats a promise that died twice)."""
    for p in paths:
        try:
            with open(p, "rb") as f:
                text = f.read(READ_CAP).decode("utf-8", "ignore")
        except OSError:
            continue
        norm = " ".join(tokens(text))
        hit = sorted(b for b in phrases if b in norm)
        if hit:
            return p, hit[0]
    return None


def scan_day(day):
    """-> (findings, cleared, candidates) for one day; None if no journal.
    A finding: {time, kind, sentence, paragraph}. Cleared carries the
    artefact and the phrase that cleared it."""
    turns = read_day(day)
    if turns is None:
        return None
    findings, cleared = [], []
    for e in turns:
        t = (e.get("time") or "")[11:16] or "??:??"
        kind = e.get("kind", "?")
        epoch = e.get("epoch", 0)
        dur = e.get("duration") or 0
        cands = None
        for par in paragraphs(spoken_half(e["reply"])):
            hits = [s for s in sentences(par)
                    if CLAIM_RE.search(s) and VOUCH_RE.search(s)
                    and not DEST_RE.search(s)]
            if not hits:
                continue
            if cands is None:
                cands = artefacts_between(epoch - LEAD, epoch + dur + SLACK)
            got = backing(cands, bigrams(par))
            for s in hits:
                if got:
                    cleared.append({"time": t, "kind": kind, "sentence": s,
                                    "artefact": got[0], "phrase": got[1]})
                else:
                    findings.append({"time": t, "kind": kind, "sentence": s,
                                     "paragraph": par})
    return findings, cleared


def report_lines(day, findings, cleared):
    say("%s: %d durability claim%s vouched safe with no drawer named"
        % (day, len(findings) + len(cleared),
           "" if len(findings) + len(cleared) == 1 else "s"))
    for c in cleared:
        say("  cleared %s %s — %s" % (c["time"], c["kind"],
                                      c["sentence"]))
        say("    the artefact behind it: %s (shares \"%s\")"
            % (c["artefact"], c["phrase"]))
    for f in findings:
        say("  FLAGGED %s %s — %s" % (f["time"], f["kind"], f["sentence"]))
        say("    said of: %s" % " ".join(f["paragraph"].split()))
        say("    nothing under the roots touched in the claim's window "
            "carries this paragraph's phrases")


def eng_record_id(day):
    return "undestinated-durability-claims-%s" % day


def eng_dir():
    d = os.environ.get("DESKCRAB_ENG_DIR")
    if not d:
        d = os.path.join(STATE_DIR, "engineering", "records")
    return d


def file_findings(day, findings):
    """The day's report under the data dir, and the day's ONE engineering
    record through `crab eng` alone (rule 21d) — created once: a re-run of
    the same day names the standing record and never files twice."""
    os.makedirs(OUT_DIR, exist_ok=True)
    report = os.path.join(OUT_DIR, day + ".md")
    body_lines = [
        "# Undestinated durability claims — %s" % day, "",
        "Spoken sentences that vouched their own durability, named no",
        "destination, and had no artefact behind them on the night",
        "(specs/nightly.md rules 21c and 21d). Checked %s against the"
        % time.strftime("%Y-%m-%d %H:%M"),
        "day's own mtimes; the window is the claiming turn, %ds before to"
        % LEAD,
        "%ds after." % SLACK, ""]
    for f in findings:
        body_lines += ["- %s %s: \"%s\" — said of: %s"
                       % (f["time"], f["kind"], f["sentence"],
                          " ".join(f["paragraph"].split()))]
    tmp = "%s.tmp.%d" % (report, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(body_lines) + "\n")
    os.replace(tmp, report)
    say("report written: %s" % report)

    rid = eng_record_id(day)
    if os.path.exists(os.path.join(eng_dir(), rid + ".md")):
        say("the day's record already stands: %s — not filed twice" % rid)
        return
    body = ("On the night of %s, the undestinated-claims check "
            "(specs/nightly.md rules 21c-21d) found these spoken sentences "
            "vouching their own durability with no destination named and no "
            "artefact behind them:\n\n" % day)
    body += "\n".join("- %s %s: \"%s\" — said of: %s"
                      % (f["time"], f["kind"], f["sentence"],
                         " ".join(f["paragraph"].split()))
                      for f in findings)
    body += ("\n\nEach needs a hand: either the thing claimed exists "
             "somewhere this check's roots do not reach — then say where — "
             "or it was never written, and the claim was false when spoken. "
             "The full report: %s" % report)
    title = "undestinated durability claims %s" % day
    try:
        r = subprocess.run([ENG, "new", title, "--body", body,
                            "--summary",
                            "%d durability claim(s) of %s vouched safe, "
                            "undestinated, nothing behind them on the night"
                            % (len(findings), day)],
                           capture_output=True, text=True, timeout=30)
        if r.returncode == 0:
            say("filed as engineering record: %s" % r.stdout.strip())
        else:
            say("eng refused the record (rc=%d): %s"
                % (r.returncode, (r.stderr or "").strip()))
    except (OSError, subprocess.SubprocessError) as e:
        say("eng could not be run (%s) — the report above still stands" % e)


def cmd_run(day):
    got = scan_day(day)
    if got is None:
        say("no journal for %s under %s; nothing to check"
            % (day, JOURNAL_DIR))
        return 0
    findings, cleared = got
    report_lines(day, findings, cleared)
    if not findings:
        say("%s: clean — every vouched claim named its drawer or had its "
            "artefact" % day)
        return 0
    file_findings(day, findings)
    return 1


def cmd_scan(days):
    total = 0
    for day in days:
        got = scan_day(day)
        if got is None:
            say("%s: no journal" % day)
            continue
        findings, cleared = got
        report_lines(day, findings, cleared)
        say("%s: %d flagged, %d cleared" % (day, len(findings),
                                            len(cleared)))
        total += len(findings)
    say("scan total: %d flagged across %d day(s) — replay overcounts by "
        "design (rule 21d); the verdict belongs to the night" %
        (total, len(days)))
    return 0


def main(argv):
    mode = argv[1] if len(argv) > 1 else ""
    if mode == "run":
        day = argv[2] if len(argv) > 2 else \
            time.strftime("%Y-%m-%d", time.localtime(time.time() - 86400))
        return cmd_run(day)
    if mode == "scan" and len(argv) > 2:
        return cmd_scan(argv[2:])
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
