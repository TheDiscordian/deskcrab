#!/usr/bin/env bash
# night-work — the night spends itself on the owed work.
#
# Part of sleep, run after the stamp, the review and the promise sweep, as
# the night's last phase (specs/nightly.md rules 54-61). The owed work
# accumulates faster than waking hours spend it, and the stretch between the
# night's stamp and the morning is machine time nobody is using. This turns
# that stretch into builders: each round, the QUEUED briefs the daytime
# dispatch policy shelved (specs/jobs.md rules 30-34) go out first, oldest
# first, through `crab job dispatch` — already-written work, no model call —
# and then one model call reads the LIVE open
# engineering records (rule 58c: the records drawer `crab eng` keeps, state
# open, newest-touched first — never the frozen pre-records archive, which
# is closed by construction and bought already-finished work four nights
# over), the promise sweep's genuine end-of-day misses, and
# the wake queue's pending reasons — the whole owed-work shelf (rule 58b) —
# beside the job list and the night's own ledger, picks what is GENUINELY
# actionable without the user's voice in the room — never a note, never
# settled work, never a duplicate of a job running or already dispatched —
# and writes a self-contained brief per pick. Each brief goes
# through the job door (`crab job`), never around it, so every builder
# carries the whole jobs contract. Then the night waits, re-reads what is
# still open, and goes again — for hours, until the wall-clock cutoff, at
# which point
# dispatch stops, in-flight builders are left to finish, and the sleep
# pipeline carries on so the night ends idle and available. Sleeping is an
# active activity, the user's own design: reading the day and then idling
# until morning is not it.
#
#   night-work run     take up the owed work until the cutoff, the cap permitting
#
# Every failure path exits 0 with a trace line on stdout (the night's log):
# a broken night's work costs only itself, never the night.
#
# Knobs, environment or deskcrab.conf (this file sources lib/common.sh):
#   NIGHT_WORK=0                 switch the phase off
#   NIGHT_WORK_CUTOFF=06:00      local wall clock, the user's hard line;
#                                   no new dispatch at or past it, re-checked
#                                   before every dispatch ("@<epoch>" is the
#                                   test's spelling)
#   NIGHT_WORK_CAP=2             max concurrent jobs (dispatched or
#                                   running), counting everyone's — two is
#                                   the user's standing overnight ceiling
#                                   (2026-08-11): eight at once burned two
#                                   logins inside an hour
#   NIGHT_WORK_POLL=300          seconds between rounds
#   NIGHT_WORK_WINDOW_MAX=21600  a start further than this from the next
#                                   cutoff takes up nothing (the noon catch-up)
#   NIGHT_WORK_ROUNDS_MAX=0      0 = rounds bounded by the cutoff alone
#   NIGHT_WORK_MODEL=gpt-5.6-sol the selector — picking work is judgement,
#                                   and every sleep judgment is the night
#                                   judge's (specs/nightly.md rules 14c-14e);
#                                   no fallback model may select in its place
#   NIGHT_WORK_EFFORT=high       the judge's reasoning effort
#   NIGHT_WORK_TIMEOUT=600       seconds per selection call
#   NIGHT_WORK_THREADS_DIR / _RECORDS_DIR / _LEDGER   the material paths
#                                   (_RECORDS_DIR: the live records drawer,
#                                   default $NIGHT_WORK_THREADS_DIR/records)
#   DESKCRAB_NO_DISPATCH=1          dry-run: real selection, nothing started,
#                                   no ledger written (rule 61)
set -uo pipefail

# readlink -f before dirname, or the deployed symlink's logical `..` walks
# into ~/.local/lib and sources a lib/common.sh that does not exist
# (specs/nightly.md rule 6a; dead in production until 2026-08-11).
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=common.sh
. "$SCRIPT_DIR/lib/common.sh"

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/deskcrab"
# The live shelf (rule 58c). The old THREADS_FILE (engineering.md) and the
# drawer's OPEN.md/INDEX.md are the frozen pre-records archive — read-only
# history in which everything is closed by construction — and they are
# CLOSED to the selector: shopping from them bought already-finished work
# on four separate nights (2026-08-15 to 08-17, the record
# the-nightly-drain-shops-from-the-frozen-archive). An archive item a hand
# judges still owed is migrated to a live record, never re-fed to the drain.
THREADS_DIR="${NIGHT_WORK_THREADS_DIR:-$DATA_DIR/engineering}"
RECORDS_DIR="${NIGHT_WORK_RECORDS_DIR:-$THREADS_DIR/records}"
LEDGER="${NIGHT_WORK_LEDGER:-$DATA_DIR/night-work/dispatched.tsv}"
CUTOFF_SPEC="${NIGHT_WORK_CUTOFF:-06:00}"
CAP="${NIGHT_WORK_CAP:-2}"
POLL="${NIGHT_WORK_POLL:-300}"
WINDOW_MAX="${NIGHT_WORK_WINDOW_MAX:-21600}"
ROUNDS_MAX="${NIGHT_WORK_ROUNDS_MAX:-0}"
# Defaults from the night's one judge (nightly.md rule 14c-i); this pair
# overrides it for work selection alone.
NIGHT_WORK_MODEL="${NIGHT_WORK_MODEL:-${NIGHT_JUDGE_MODEL:-gpt-5.6-sol}}"
NIGHT_WORK_EFFORT="${NIGHT_WORK_EFFORT:-${NIGHT_JUDGE_EFFORT:-high}}"
CRAB="${CRAB_BIN:-$SCRIPT_DIR/crab}"
CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"

# The account log names the path that recorded each refusal
# (specs/account-fallback.md rule 11) — the night's classifies are their own
# kind, never a defaulted "session". Not exported: nothing dispatched from
# here should inherit it.
SESSION_KIND=night-work

say() { printf 'night-work: %s\n' "$1"; }

# Rule 58a's second half: a cut that actually happens is announced. The byte
# bound on each section of the selector's material is design, but a trim
# nobody can see is silent truncation — the thing the standing rule forbids
# everywhere (specs/prompt-assembly.md rule 36 is the same rule at the
# prompt's own scale). A section that outgrew its budget is named on the
# night log at the moment it is bounded: which section, its true size in
# bytes, and the budget it was cut to. A section inside its budget passes
# without a word, and a missing file is an empty section, never an over-run.
section_overrun() {  # <section name> <true bytes> <budget bytes>
    [ "$2" -gt "$3" ] 2>/dev/null || return 0
    say "round ${ROUNDS:-0}: the $1 outgrew its budget — $2 bytes against $3, cut to the budget on a character boundary (rule 58a)"
}

# One selection question to the NIGHT JUDGE — the one shared walk of
# specs/nightly.md rules 14c-14e, sourced, never re-implemented. No fallback
# model: a round the judge cannot answer selects nothing, because picking the
# night's work is exactly the judgment no cheaper model may make.
# shellcheck source=nightly-judge
. "$LIB_DIR/nightly-judge"
classify_walk() {  # <verdict-line-ERE>
    nightly_judge_walk "$NIGHT_WORK_MODEL" "$NIGHT_WORK_EFFORT" \
        "${NIGHT_WORK_TIMEOUT:-600}" night-work "$1"
}

running_jobs() {  # every sidecar standing dispatched or running — the whole box's, not ours
    # dispatched counts (nightly.md rule 57): a builder between the dispatch
    # call and its worker's first write already holds a slot and an account,
    # and a count blind to it overshot the cap in exactly the window where
    # one round's dispatches had not yet spoken as the next round counted.
    local f s n=0
    for f in "$JOBS_DIR"/*.json; do
        [ -e "$f" ] || continue
        s="$("$SCRIPT_DIR/lib/job-status" get "$f" state 2>/dev/null)"
        case "$s" in dispatched|running) n=$(( n + 1 )) ;; esac
    done
    printf '%s' "$n"
}

queued_jobs() {  # the queued backlog's ids, oldest first (nightly.md rule 56a)
    local f id qe
    for f in "$JOBS_DIR"/*.json; do
        [ -e "$f" ] || continue
        [ "$("$SCRIPT_DIR/lib/job-status" get "$f" state 2>/dev/null)" = queued ] || continue
        id="$("$SCRIPT_DIR/lib/job-status" get "$f" id 2>/dev/null)"
        [ -n "$id" ] || continue
        qe="$("$SCRIPT_DIR/lib/job-status" get "$f" queued_epoch 2>/dev/null)"
        case "$qe" in ''|*[!0-9]*) qe=0 ;; esac
        printf '%s\t%s\n' "$qe" "$id"
    done | sort -n | cut -f2
}

cmd_run() {
    if [ "${NIGHT_WORK:-1}" != 1 ]; then
        say "off (NIGHT_WORK=${NIGHT_WORK:-})"; return 0
    fi
    # The judge's own engine binary, by the model name (specs/nightly.md rule
    # 14c; model-backends rule 1). Existence only — a cooling codex engine
    # still runs the queue phase, and each round's failed selection says so
    # in the walk's own name (rule 14e).
    case "$(model_backend "$NIGHT_WORK_MODEL")" in
        codex)
            if ! [ -x "$CODEX_BIN" ] && ! command -v "$CODEX_BIN" >/dev/null 2>&1; then
                say "no codex binary for the night judge ($NIGHT_WORK_MODEL) — nothing selected, nothing dispatched"
                return 0
            fi ;;
        *)
            if [ ! -x "$CLAUDE_BIN" ]; then
                say "no claude binary — nothing selected, nothing dispatched"; return 0
            fi ;;
    esac

    # One-time move of the durable ledger: this mechanism was called the
    # backlog drain until 2026-08-20, and its dispatch record lived under
    # that name. The picks on it are what keeps rule 59's dedup honest
    # across the rename, so the file moves rather than starting over —
    # declared here (rule 6), once; after the first night this runs, the
    # legacy path is gone and this block never speaks again. The literal
    # old name below is deliberate: it is the only way to find the file
    # the old code wrote.
    local LEGACY_LEDGER="$DATA_DIR/backlog-drain/dispatched.tsv"
    if [ ! -e "$LEDGER" ] && [ -f "$LEGACY_LEDGER" ]; then
        mkdir -p "$(dirname "$LEDGER")"
        touch_suppress "$(dirname "$LEDGER")" 2>/dev/null
        if mv "$LEGACY_LEDGER" "$LEDGER" 2>/dev/null; then
            say "the dispatch ledger moved from the mechanism's old name — $LEGACY_LEDGER -> $LEDGER, records intact"
            rmdir "$(dirname "$LEGACY_LEDGER")" 2>/dev/null
        else
            say "the ledger at $LEGACY_LEDGER could not be moved to $LEDGER — tonight judges from a fresh ledger"
        fi
    fi
    # No selection material is not "nothing to take up": the queued backlog
    # is the night's FIRST material (nightly.md rule 56a), and it exists
    # whether or not a single engineering thread does. This used to return
    # here, and the shelved briefs of an instance with no threads file waited
    # for a night that never worked them. Selection is switched off; the
    # night still takes up the queue.
    local NO_THREADS=""
    if [ ! -d "$RECORDS_DIR" ]; then
        NO_THREADS=1
        say "no engineering threads — selection is off; the night still takes up the queued backlog"
    fi

    local NOW CUTOFF
    NOW="$(date +%s)"
    case "$CUTOFF_SPEC" in
        @*) CUTOFF="${CUTOFF_SPEC#@}"
            case "$CUTOFF" in ''|*[!0-9]*)
                say "cannot parse NIGHT_WORK_CUTOFF '$CUTOFF_SPEC'"; return 2 ;;
            esac ;;
        *)  if ! CUTOFF="$(date -d "today $CUTOFF_SPEC" +%s 2>/dev/null)"; then
                say "cannot parse NIGHT_WORK_CUTOFF '$CUTOFF_SPEC'"; return 2
            fi
            # The cutoff names a time of night, and sleep starts before it:
            # 03:10 against an 04:00 cutoff is today, 23:50 against it is
            # tomorrow. `date -d tomorrow`, not +86400: DST nights are why.
            [ "$CUTOFF" -le "$NOW" ] \
                && CUTOFF="$(date -d "tomorrow $CUTOFF_SPEC" +%s 2>/dev/null)"
            ;;
    esac

    # The daylight guard (rule 56): Persistent=true means a machine that was
    # off at 03:10 sleeps at noon, and a noon round of builders would fill
    # the day's working hours. A caught-up night still sleeps; it does not
    # take up the backlog.
    if [ $(( CUTOFF - NOW )) -gt "$WINDOW_MAX" ]; then
        say "next cutoff ($CUTOFF_SPEC) is $(( (CUTOFF - NOW) / 60 )) min away — outside the ${WINDOW_MAX}s night-work window; a daylight catch-up takes up nothing"
        return 0
    fi

    local DRY=""
    [ -n "${DESKCRAB_NO_DISPATCH:-}" ] && DRY=1 && say "dry-run (DESKCRAB_NO_DISPATCH) — selection is real, dispatch and the ledger are not"

    local WORK; WORK="$(mktemp -d "${TMPDIR:-/tmp}/deskcrab-night-work-XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf '$WORK'" EXIT

    local ROUNDS=0 DISPATCHED=0 OUR_IDS="" REASON="" SKIP_QUEUED=""
    while :; do
        NOW="$(date +%s)"
        if [ "$NOW" -ge "$CUTOFF" ]; then
            REASON="the cutoff ($CUTOFF_SPEC) — in-flight builders finish on their own"
            break
        fi
        if [ "$ROUNDS_MAX" -gt 0 ] 2>/dev/null && [ "$ROUNDS" -ge "$ROUNDS_MAX" ]; then
            REASON="the round cap (NIGHT_WORK_ROUNDS_MAX=$ROUNDS_MAX)"
            break
        fi
        ROUNDS=$(( ROUNDS + 1 ))

        # `crab jobs` first — the reporting path reaps hard-killed workers,
        # so the count below is of jobs actually running — and its text is
        # the duplicate-evidence the selector reads.
        local JOBS_RAW JOBS_TEXT RUNNING FREE
        JOBS_RAW="$("$CRAB" jobs 2>/dev/null)"
        section_overrun "job list" "$(printf '%s' "$JOBS_RAW" | wc -c)" 6000
        JOBS_TEXT="$(printf '%s' "$JOBS_RAW" | utf8_head 6000)"
        RUNNING="$(running_jobs)"
        FREE=$(( CAP - RUNNING ))
        if [ "$FREE" -le 0 ]; then
            say "round $ROUNDS: cap full ($RUNNING running, cap $CAP) — waiting"
            local S=$(( CUTOFF - NOW )); [ "$S" -gt "$POLL" ] && S="$POLL"
            [ "$S" -lt 1 ] && S=1
            sleep "$S"
            continue
        fi

        # The queued backlog goes first (nightly.md rule 56a): the briefs the
        # daytime policy shelved are already-written work — no model call, no
        # judgement to buy — so they spend the night's slots before the
        # selector is asked to invent anything. Oldest first, through the
        # door and never around it, DESKCRAB_JOB_NIGHT open so the door knows
        # the window (jobs.md rule 31), the cutoff re-checked before EVERY
        # dispatch (rule 56: a dispatch a minute past the line is a dispatch
        # past the line). A refusal that is not the block marker skips the
        # brief for the rest of the night — never a retry loop — and the
        # block marker ends the night for everyone.
        local SENT_THIS_ROUND=0 BLOCKED="" CUTOFF_HIT="" QID QOUT QRC
        for QID in $(queued_jobs); do
            [ "$FREE" -le 0 ] && break
            case " $SKIP_QUEUED " in *" $QID "*) continue ;; esac
            if [ "$(date +%s)" -ge "$CUTOFF" ]; then CUTOFF_HIT=1; break; fi
            if [ -n "$DRY" ]; then
                say "round $ROUNDS: would dispatch queued job '$QID'"
                SKIP_QUEUED="$SKIP_QUEUED $QID"
                SENT_THIS_ROUND=$(( SENT_THIS_ROUND + 1 ))
                DISPATCHED=$(( DISPATCHED + 1 ))
                FREE=$(( FREE - 1 ))
                continue
            fi
            QOUT="$(DESKCRAB_JOB_NIGHT=1 "$CRAB" job dispatch "$QID" 2>&1)"; QRC=$?
            if [ "$QRC" -ne 0 ]; then
                case "$QOUT" in
                    *"the last job never began"*)
                        say "the job door is blocked — ${QOUT%%$'\n'*}"
                        BLOCKED=1; break ;;
                    *)  say "round $ROUNDS: queued job '$QID' refused — ${QOUT%%$'\n'*} — skipped for the night"
                        SKIP_QUEUED="$SKIP_QUEUED $QID"
                        continue ;;
                esac
            fi
            say "round $ROUNDS: dispatched queued job '$QID'"
            OUR_IDS="$OUR_IDS $QID"
            SENT_THIS_ROUND=$(( SENT_THIS_ROUND + 1 ))
            DISPATCHED=$(( DISPATCHED + 1 ))
            FREE=$(( FREE - 1 ))
        done
        if [ -n "$BLOCKED" ]; then
            REASON="the job door's block marker — no builder can begin, so none is asked to"
            break
        fi
        if [ -n "$CUTOFF_HIT" ]; then
            REASON="the cutoff ($CUTOFF_SPEC) — in-flight builders finish on their own"
            break
        fi
        if [ "$FREE" -le 0 ]; then
            # The queue filled the slate; selection waits for the next round.
            NOW="$(date +%s)"
            local S=$(( CUTOFF - NOW )); [ "$S" -gt "$POLL" ] && S="$POLL"
            [ "$S" -lt 1 ] && S=1
            sleep "$S"
            continue
        fi

        # No engineering threads: the queued phase above was the whole round
        # (rule 56a) — a selector with nothing to read is not called, so no
        # model tokens are spent inventing work from an empty shelf. The
        # night ends when the queue is dry and nothing of tonight's is still
        # running.
        if [ -n "$NO_THREADS" ]; then
            if [ "$SENT_THIS_ROUND" -eq 0 ]; then
                local ID ANY=""
                for ID in $OUR_IDS; do
                    [ "$("$SCRIPT_DIR/lib/job-status" get "$JOBS_DIR/$ID.json" state 2>/dev/null)" = running ] \
                        && ANY=1 && break
                done
                if [ -z "$ANY" ]; then
                    REASON="the queue is dry and there are no engineering threads to select from"
                    break
                fi
            fi
            NOW="$(date +%s)"
            local S=$(( CUTOFF - NOW )); [ "$S" -gt "$POLL" ] && S="$POLL"
            [ "$S" -lt 1 ] && S=1
            sleep "$S"
            continue
        fi

        # The live shelf (rule 58c): the open records, whole — front matter
        # and body, so the selector reads each record's state with its own
        # eyes — newest-touched first, the order `eng list --state open`
        # already produces. lib/eng is the one parser of record front
        # matter; nothing here re-implements it. utf8_head, never a bare
        # `head -c`, for every cut — a byte cut through a multibyte
        # character would hand the selector and the night's stream log
        # invalid UTF-8 (rule 58a; the wake ledger's incident, in prompt
        # form). And a cut that actually happens says so on the night log
        # first: the bound is design, a cut nobody can see is not (rule
        # 58a's second half). A record past the total budget is never
        # silently dropped: it rides its one-line list entry in the
        # overflow section, still live, still selectable.
        local RECORDS_TEXT OVERFLOW LIST_RAW LEDGER_TAIL
        local RID RF RB TAKE BUDGET_LEFT=24000 INCLUDED=0 CLIPPED=0
        RECORDS_TEXT="" OVERFLOW=""
        if ! LIST_RAW="$(DESKCRAB_ENG_DIR="$RECORDS_DIR" \
                "$SCRIPT_DIR/lib/eng" list --state open 2>/dev/null)"; then
            # Rule 58b's discipline: an unreadable section is presented AS
            # unreadable, never silently omitted.
            say "round $ROUNDS: the open records could not be read — the selector is told so"
            RECORDS_TEXT="(the open records could not be read tonight — judging from less than the whole shelf)"
            OVERFLOW="(unknown tonight)"
            LIST_RAW=""
        fi
        for RID in $(printf '%s\n' "$LIST_RAW" \
                | sed -n 's/.* \[\([a-z0-9-]\{1,\}\)\] — opened .*/\1/p'); do
            RF="$RECORDS_DIR/$RID.md"
            [ -f "$RF" ] || continue
            TAKE=6000
            [ "$TAKE" -gt "$BUDGET_LEFT" ] && TAKE="$BUDGET_LEFT"
            if [ "$TAKE" -le 0 ]; then
                CLIPPED=$(( CLIPPED + 1 ))
                OVERFLOW="$OVERFLOW$(printf '%s\n' "$LIST_RAW" | grep -F -- "[$RID]" | head -1)
"
                continue
            fi
            RB="$(wc -c < "$RF" 2>/dev/null || echo 0)"
            section_overrun "open record '$RID'" "$RB" "$TAKE"
            RECORDS_TEXT="$RECORDS_TEXT--- $RID ---
$(utf8_head "$TAKE" "$RF" 2>/dev/null)

"
            INCLUDED=$(( INCLUDED + 1 ))
            [ "$RB" -lt "$TAKE" ] 2>/dev/null && TAKE="$RB"
            BUDGET_LEFT=$(( BUDGET_LEFT - TAKE ))
        done
        if [ "$CLIPPED" -gt 0 ]; then
            say "round $ROUNDS: the open records outgrew the 24000-byte total — the $INCLUDED newest-touched are in, $CLIPPED more on their list lines only (rule 58a)"
        fi
        [ -n "$RECORDS_TEXT" ] || RECORDS_TEXT="(no open records — the live shelf is empty tonight)"
        # 24000, not less: the live drawer holds sixty open records tonight
        # and a real one-liner measured ~285 bytes, so anything smaller cuts
        # open records out of the selector's sight — invisible open work,
        # the very defect rule 58c exists to close. The cut past it is
        # announced, as ever.
        section_overrun "overflow list" "$(printf '%s' "$OVERFLOW" | wc -c)" 24000
        OVERFLOW="$(printf '%s' "$OVERFLOW" | utf8_head 24000)"
        [ -n "$OVERFLOW" ] || OVERFLOW="(none — every open record is above in full)"
        LEDGER_TAIL="$(tail -n 40 "$LEDGER" 2>/dev/null)"
        [ -n "$LEDGER_TAIL" ] || LEDGER_TAIL="(none yet)"

        # The rest of the owed-work shelf (rule 58b). The sweep's genuine
        # end-of-day misses — its `type: sweep` records, never the live
        # checker's raw catches, which run heavily false — and among them
        # only the UNRESOLVED: a row a `sweep-resolution` row has answered
        # (rule 53f — fulfilled, struck, or booked alike) is settled debt,
        # and before this exclusion every recent raw row stayed eligible for
        # redispatch until it aged out, fifty reconciled misses among them
        # (the record the-end-of-day-promise-sweep-calls-existing-arte). The
        # identity walk is lib/promise_ledger.py's, the one reader; the count
        # of resolved rows excluded is stated in the section itself, never
        # silently dropped. And the pending wake reasons, where owed work
        # sits waiting for a live turn that cannot commit to the repository
        # anyway. Either section failing to read is presented AS unreadable
        # and named on the night log, never silently omitted: the selector
        # must know it judges from less than the whole shelf.
        local OWED PENDING
        if ! OWED="$(python3 - "$PROMISE_LEDGER" "$LIB_DIR" 2>/dev/null <<'PY'
import os, sys, time
path, libdir = sys.argv[1], sys.argv[2]
sys.path.insert(0, libdir)
from promise_ledger import read_rows, owed
cut = time.time() - 3 * 86400
try:
    ledger_rows = read_rows(path)
except OSError:
    if os.path.exists(path):
        print("(the promise ledger could not be read tonight — judging from less than the whole shelf)")
    else:
        print("(no promise ledger yet)")
    sys.exit(0)
owed_rows, resolved_n = owed(ledger_rows, cut)
rows = []
for d in owed_rows:
    promise = " ".join(str(d.get("promise", "?")).split())[:300]
    why = " ".join(str(d.get("why", "")).split())[:200]
    rows.append("- [%s, said at %s] \"%s\" — %s"
                % (d.get("day", "?"), d.get("said_at", "?"), promise, why))
rows = rows[-20:]
if resolved_n:
    rows.append("(%d swept miss(es) from these nights already resolved — "
                "fulfilled, struck, or booked — and off the shelf)" % resolved_n)
print("\n".join(rows) if rows else "(no swept misses on the ledger)")
PY
)"; then
            OWED="(the promise ledger could not be read tonight — judging from less than the whole shelf)"
        fi
        case "$OWED" in
            "(the promise ledger could not be read"*)
                say "round $ROUNDS: the promise ledger could not be read — the selector is told so" ;;
        esac
        PENDING=""
        local WF PN=0
        for WF in "$WAKES_DIR"/*.wake; do
            [ -e "$WF" ] || continue
            wake_record_read "$WF" || continue
            [ "$PN" -ge 20 ] && { PENDING="$PENDING
  (…more pending wakes clipped)"; break; }
            PN=$(( PN + 1 ))
            PENDING="$PENDING
- [fires $(date -d "@$WK_FIRE" '+%F %H:%M' 2>/dev/null || echo '?'), booked by $WK_BOOKED_BY] $(utf8_trim "$WK_REASON" 300)"
        done
        [ -n "$PENDING" ] || PENDING="
(nothing is on the books)"

        local PROMPT="You do the night's work of a desktop assistant: while she
sleeps, her open owed work becomes detached builder jobs. Below is the whole
shelf, and every part of it is LIVE: her open engineering records — one
stateful record per thread, front matter and all, newest-touched first,
with an overflow list naming any open record whose body did not fit
tonight — then the promises the night sweep found genuinely missed at end
of day, and the wakes already on the books (owed work often parks there —
and a live waked session cannot commit to her own repository, so
builder-shaped work on a wake otherwise waits forever). Nothing outside
these sections is on the shelf: her frozen pre-records archive is closed to
this selection because everything in it is history. Then
the current job list, and the ledger of picks the night's work has ALREADY
dispatched on earlier rounds and nights.

Pick AT MOST $FREE items, from ANY of those sources, that are genuinely
actionable engineering work right now — work that needs no conversation and
no decision from the user — and write a builder's brief for each. Skip,
without exception:
- notes, incident write-ups, decisions and diary entries with no work left;
- anything the material itself records as done, landed, fixed, verified;
- anything a RUNNING, QUEUED, or recently finished job already covers — match
  the job list below by substance, not wording; a queued brief dispatches
  tonight on its own, so selecting its subject buys the same work twice;
- every pick already on the night-work ledger below, whatever its source;
- anything that waits on the user's decision or needs his voice in the room,
  and anything the material says is deliberately parked, held for a quiet
  moment, or claimed by another hand;
- any wake whose reason is speaking, awareness, reflection, chess, or a
  reminder — dispatch a wake's work only when the reason names concrete
  buildable work a detached builder can finish alone.
Fewer is better: an unnecessary builder burns a night's tokens. If nothing
qualifies, answer with the NOTHING line.

Each brief must be fully self-contained — the builder arrives knowing ONLY
the brief's text. It must name: the repository or directory to work in by
absolute path (take it from the material), the thread, promise, or wake it
came from, the concrete work, the constraints the material names, and how
the builder
must verify its work before reporting done. Never write a brief that only
waits on, watches, or coordinates other work: a builder must carry its own
work. For a pick from the open records, the key slug IS the record's id,
verbatim. For a pick from the promises or the wakes, invent a short stable
key slug from its subject, exactly as a record's. Answer in exactly this
form and nothing else:

TASK: <key-slug> | <absolute workdir, or -> | <one-line title>
BRIEF:
<the full brief, as many lines as it needs>
END

(repeat the TASK/BRIEF/END block per pick, at most $FREE)
or, when nothing qualifies, exactly:
NOTHING: <one line saying why>

=== THE OPEN ENGINEERING RECORDS (LIVE — state: open, newest-touched first) ===
$RECORDS_TEXT
=== OPEN RECORDS WHOSE BODIES DID NOT FIT TONIGHT (still live, still selectable) ===
$OVERFLOW

=== PROMISES THE NIGHT SWEEP FOUND MISSED (recent nights) ===
$OWED

=== WAKES ALREADY ON THE BOOKS (fire time, booker, reason) ===
$PENDING

=== THE JOB LIST (running and recently finished) ===
$JOBS_TEXT

=== ALREADY DISPATCHED BY THE NIGHT'S WORK (night, key, job id, title) ===
$LEDGER_TAIL"

        local OUT
        if ! OUT="$(printf '%s' "$PROMPT" | classify_walk '^(TASK|NOTHING)\b')"; then
            REASON="no selection from the night judge ($NIGHT_WORK_MODEL) — nothing more can be judged tonight, and no cheaper model may pick the night's work"
            break
        fi

        # Parse the TASK/BRIEF/END blocks into $WORK/<n>.{key,wd,title,brief}.
        rm -f "$WORK"/*.key "$WORK"/*.wd "$WORK"/*.title "$WORK"/*.brief 2>/dev/null
        local N=0 INBRIEF=0 LINE REST TKEY TWD TTITLE
        while IFS= read -r LINE; do
            case "$LINE" in
                TASK:*)
                    N=$(( N + 1 )); INBRIEF=0
                    REST="${LINE#TASK:}"
                    IFS='|' read -r TKEY TWD TTITLE <<< "$REST"
                    # IFS='|' leaves each field padded with the spaces around
                    # the separators; trim them before the tr below, which
                    # would otherwise turn them into leading and trailing
                    # hyphens on the key. (TWD strips all whitespace, TTITLE
                    # trims its own — only the key needs the guard.)
                    printf '%s' "$TKEY" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
                        | tr '[:upper:] ' '[:lower:]-' \
                        | tr -cd 'a-z0-9-' | head -c 80 > "$WORK/$N.key"
                    printf '%s' "$TWD" | tr -d ' \t' > "$WORK/$N.wd"
                    utf8_trim "$(printf '%s' "$TTITLE" | sed 's/^ *//; s/ *$//')" 200 \
                        > "$WORK/$N.title"
                    ;;
                BRIEF:*) INBRIEF=1; : > "$WORK/$N.brief" ;;
                END)     INBRIEF=0 ;;
                *)  [ "$INBRIEF" = 1 ] && [ "$N" -gt 0 ] \
                        && printf '%s\n' "$LINE" >> "$WORK/$N.brief" ;;
            esac
        done <<< "$OUT"

        # SENT_THIS_ROUND, BLOCKED and CUTOFF_HIT carry over from the queued
        # phase above: the cap and the counters are the round's, not the
        # phase's.
        local I SEL_SENT=0
        for I in $(seq 1 "$N"); do
            [ "$SEL_SENT" -ge "$FREE" ] && break
            if [ "$(date +%s)" -ge "$CUTOFF" ]; then CUTOFF_HIT=1; break; fi
            local KEY WD TITLE BRIEF SQUEEZED
            KEY="$(cat "$WORK/$I.key" 2>/dev/null)"
            WD="$(cat "$WORK/$I.wd" 2>/dev/null)"
            TITLE="$(cat "$WORK/$I.title" 2>/dev/null)"
            BRIEF="$(cat "$WORK/$I.brief" 2>/dev/null)"
            if [ -z "$KEY" ]; then
                say "round $ROUNDS: pick $I has no usable thread key — skipped"
                continue
            fi
            # The null-brief guard, held here as well as at the door: a brief
            # that is empty, null-shaped, or too thin to act on is nobody's
            # work (rule 60; the door's own guard is the backstop).
            SQUEEZED="$(printf '%s' "$BRIEF" | tr -d '[:space:]')"
            case "$SQUEEZED" in
                ''|null|None|undefined)
                    say "round $ROUNDS: '$KEY' came back with a null-shaped brief — skipped"
                    continue ;;
            esac
            if [ "${#SQUEEZED}" -lt 80 ]; then
                say "round $ROUNDS: '$KEY' came back with a brief too thin to act on (${#SQUEEZED} chars) — skipped"
                continue
            fi
            if awk -F'\t' -v k="$KEY" '$2 == k { found = 1 } END { exit !found }' \
                    "$LEDGER" 2>/dev/null; then
                say "round $ROUNDS: '$KEY' is already on the ledger — skipped"
                continue
            fi

            BRIEF="The night's work, from the open item '$KEY': $TITLE

$BRIEF"
            # The dry-run stops HERE, before the door: rule 61 promises real
            # selection with nothing started and no ledger written, so the
            # dispatch call itself must never happen.
            if [ -n "$DRY" ]; then
                say "round $ROUNDS: would dispatch '$KEY' — $TITLE"
                SEL_SENT=$(( SEL_SENT + 1 ))
                SENT_THIS_ROUND=$(( SENT_THIS_ROUND + 1 ))
                DISPATCHED=$(( DISPATCHED + 1 ))
                continue
            fi
            # DESKCRAB_JOB_NIGHT is how the door knows the night window is
            # open (jobs.md rule 31) — without it the daytime policy would
            # queue the night's own picks straight back onto the shelf it is
            # working.
            local OUTPUT RC JOB_ID
            if [ -n "$WD" ] && [ "$WD" != "-" ] && [ -d "$WD" ]; then
                OUTPUT="$(DESKCRAB_JOB_NIGHT=1 "$CRAB" job -C "$WD" "$BRIEF" 2>&1)"; RC=$?
            else
                OUTPUT="$(DESKCRAB_JOB_NIGHT=1 "$CRAB" job "$BRIEF" 2>&1)"; RC=$?
            fi
            if [ "$RC" -ne 0 ]; then
                case "$OUTPUT" in
                    *"the last job never began"*)
                        say "the job door is blocked — ${OUTPUT%%$'\n'*}"
                        BLOCKED=1; break ;;
                    *)  say "round $ROUNDS: dispatch refused for '$KEY' — ${OUTPUT%%$'\n'*}"
                        continue ;;
                esac
            fi
            JOB_ID="$(printf '%s\n' "$OUTPUT" | sed -n 's/^Job \([^ ]*\) dispatched.*/\1/p' | head -1)"
            [ -n "$JOB_ID" ] || JOB_ID="?"
            # The ledger is the night's one write, declared before made
            # (rules 6 and 59) so her own night never reads as an
            # intruder's hand.
            mkdir -p "$(dirname "$LEDGER")"
            touch_suppress "$(dirname "$LEDGER")" 2>/dev/null
            printf '%s\t%s\t%s\t%s\n' "$(date +%F)" "$KEY" "$JOB_ID" "$TITLE" >> "$LEDGER"
            OUR_IDS="$OUR_IDS $JOB_ID"
            say "round $ROUNDS: dispatched '$KEY' as job $JOB_ID — $TITLE"
            SEL_SENT=$(( SEL_SENT + 1 ))
            SENT_THIS_ROUND=$(( SENT_THIS_ROUND + 1 ))
            DISPATCHED=$(( DISPATCHED + 1 ))
        done
        if [ -n "$BLOCKED" ]; then
            REASON="the job door's block marker — no builder can begin, so none is asked to"
            break
        fi
        if [ -n "$CUTOFF_HIT" ]; then
            REASON="the cutoff ($CUTOFF_SPEC) — in-flight builders finish on their own"
            break
        fi

        # Dry backlog: the selector found nothing and nothing of tonight's is
        # still running, so later rounds have nothing to wait for (rule 58).
        if [ "$SENT_THIS_ROUND" -eq 0 ]; then
            local ID ANY=""
            for ID in $OUR_IDS; do
                [ "$("$SCRIPT_DIR/lib/job-status" get "$JOBS_DIR/$ID.json" state 2>/dev/null)" = running ] \
                    && ANY=1 && break
            done
            if [ -z "$ANY" ]; then
                REASON="the backlog is dry — nothing actionable, nothing of tonight's still running"
                break
            fi
        fi

        NOW="$(date +%s)"
        local S=$(( CUTOFF - NOW )); [ "$S" -gt "$POLL" ] && S="$POLL"
        [ "$S" -lt 1 ] && S=1
        sleep "$S"
    done

    say "done — $DISPATCHED job(s) dispatched over $ROUNDS round(s); stopped at ${REASON:-the cutoff}"
    return 0
}

case "${1:-}" in
    run) cmd_run ;;
    *)   echo "Usage: night-work run" >&2; exit 2 ;;
esac
