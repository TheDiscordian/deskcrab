)"; then
        WIDE=0; WIDE_FAIL="reading the jobs ledger failed"
    fi

    local PROMPT EVIDENCE_CLAUSE
    if [ "$WIDE" -eq 1 ]; then
        local OTHERS_N JOBS_N
        OTHERS_N="$(printf '%s\n' "$OTHERS_BLOCK" | grep -c '^--- ' || true)"
        JOBS_N="$(printf '%s\n' "$JOBS_BLOCK" | grep -c '^- ' || true)"
        [ -n "$OTHERS_BLOCK" ] || OTHERS_BLOCK="(no other session ran in the window)"
        [ -n "$JOBS_BLOCK" ] || JOBS_BLOCK="(no job was dispatched or finished in the window)"
        check_log "evidence: own record, ${OTHERS_N:-0} other session(s), ${JOBS_N:-0} job(s) from the last ${WINDOW_MIN}m"
