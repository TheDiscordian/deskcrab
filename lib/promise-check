cands = []
for name in os.listdir(d):
    if not (name.startswith(base + "-debug-") and name.endswith(".log")):
        continue
    if name == own:
        continue
    path = os.path.join(d, name)
    try:
        mt = os.stat(path).st_mtime
    except OSError:
        continue
    if mt >= cut:
        cands.append((mt, path, name))
cands.sort(reverse=True)
MAX_FILES, MAX_CALLS = 8, 20
out = []
for mt, path, name in cands[:MAX_FILES]:
    sid = name[len(base) + len("-debug-"):-len(".log")]
    label = ("builder job " + sid[len("job-"):]) if sid.startswith("job-") \
        else ("session " + sid)
    calls = []
    try:
        fh = open(path, errors="replace")
    except OSError:
        continue
    with fh:
        for raw in fh:
            raw = raw.strip()
            if not raw:
                continue
            try:
                rec = json.loads(raw)
            except ValueError:
                continue
            if not isinstance(rec, dict) or rec.get("type") != "assistant":
                continue
            msg = rec.get("message") or {}
            if rec.get("is_api_error_message") or msg.get("model") == "<synthetic>":
                continue
            for b in msg.get("content") or []:
                if not isinstance(b, dict) or b.get("type") != "tool_use":
                    continue
                tname, inp = b.get("name", "?"), b.get("input") or {}
                if tname in ("Write", "Edit", "MultiEdit", "NotebookEdit"):
                    detail = inp.get("file_path") or inp.get("notebook_path") or ""
                elif tname == "Bash":
                    detail = (inp.get("command") or "").replace("\n", " ")[:300]
                else:
                    detail = json.dumps(inp, ensure_ascii=False)[:200]
                calls.append("%s: %s" % (tname, detail))
    if not calls:
        continue
    out.append("--- %s (last write %s) ---"
               % (label, time.strftime("%H:%M", time.localtime(mt))))
    if len(calls) > MAX_CALLS:
        out.append("  (…%d earlier calls clipped)" % (len(calls) - MAX_CALLS))
        calls = calls[-MAX_CALLS:]
    out.extend("  " + c for c in calls)
print("\n".join(out))
PY
)"; then
        WIDE=0; WIDE_FAIL="gathering other sessions' records failed"
    fi
    if [ "$WIDE" -eq 1 ] && ! JOBS_BLOCK="$(python3 - "$JOBS_DIR" "$WINDOW_MIN" \
            2>/dev/null <<'PY'
import json, os, sys, time
d, window_min = sys.argv[1], sys.argv[2]
cut = time.time() - float(window_min) * 60
rows = []
try:
    names = sorted(os.listdir(d))
except OSError:
    names = []
for name in names:
