#!/usr/bin/env bash
# promise-check — the claim with no work behind it.
#
# My replies claim, in the first person, concrete actions — "I am wiring it
# now", "I've written it to the log", "I'll restart it and tell you when it
# is in" — and the turn ends with the action never taken. I have proven I
# cannot audit my own follow-through, so the verdict here never comes from
# me: a cheap model reads each commitment against the tool calls the stream
# logs record, which is the ground truth of what was DONE. The record is
# wider than the turn's own hands, because the work is often delegated by
# design: other sessions' and builders' recent stream logs and the jobs
# ledger stand beside the turn's own record, a job dispatched in the turn's
# window backs its action-claims without any model call at all, and a
# gathering failure falls back to the own-record judgement with the failure
# named on the trace. The promise audit beside this one reads what was
# SAID; this reads the work.
#
# An unkept commitment lands on the durable ledger and books an event wake
# minutes out at effort low — the wake path's opus, cheap enough to fire
# freely, strong enough to actually do the thing — quoting the promise
# verbatim. Because the live pass is gated by a cheap pattern pre-check and
# may miss, the nightly sweep mode reads the whole day's journal beside the
# ledger, reconciles promises fulfilled later, and surfaces only the genuine
# end-of-day misses. specs/turn-pipeline.md rules 32a-32d, specs/wake-queue.md
# rule 43b, specs/nightly.md rules 51-53.
#
# Usage:
#   promise-check turn <kind> <epoch> <pid> <stream-snapshot> <ledger> <response>
#   promise-check sweep [day]
#
# Every failure path exits 0 with a trace line: a missing or broken checker
# costs the check, never the turn.
set -uo pipefail

# readlink -f before dirname, or the deployed symlink's logical `..` walks
# into ~/.local/lib and sources a lib/common.sh that does not exist
# (specs/nightly.md rule 6a; dead in production until 2026-08-11).
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=common.sh
. "$SCRIPT_DIR/lib/common.sh"

MODE="${1:-}"
[ $# -gt 0 ] && shift

# One line per run — the only trace a detached checker leaves, and the only
# way to tell "ran and judged" from "never ran".
CHECK_LOG="${STATE_PREFIX}-promise-check.log"
check_log() {
    printf '%s\t%s\t%s\n' "$(date '+%F %T')" "${KIND:-sweep}" "$1" >> "$CHECK_LOG" 2>/dev/null
}

# The night log's line — the sweep half only. cmd_sweep runs as a phase of
# sleep-nightly, whose PHASE SILENT detector (specs/nightly.md rule 14b)
# reads the night log for a line in this script's own name; the run-trace
# file above stays the detailed record, but every path out of the sweep also
# says where it ended, on stdout, so a sweep that ran to its own end is never
# mistaken for one that could not start (rule 53a).
say() { printf 'promise-check: %s\n' "$1"; }

CHECK_MODEL="${PROMISE_CHECK_MODEL:-sonnet}"
CHECK_FALLBACK_MODEL="${PROMISE_CHECK_FALLBACK_MODEL:-haiku}"
# The night sweep's judge is the NIGHT JUDGE, never the live checker's model
# pair (specs/nightly.md rules 14c-14e and 51): reconciling which promises
# genuinely died is a sleep judgment, and no cheaper model may make it — no
# fallback model, where the live pass above keeps its sonnet/haiku pair as
# the live-turn role it is.
SWEEP_MODEL="${PROMISE_SWEEP_MODEL:-gpt-5.6-sol}"
SWEEP_EFFORT="${PROMISE_SWEEP_EFFORT:-high}"
CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"
[ -x "$CLAUDE_BIN" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

# The sweep's one judgment call — the shared walk of specs/nightly.md rules
# 14c-14e, sourced, never re-implemented here. Through common.sh's own
# resolved LIB_DIR, not SCRIPT_DIR: a copy-scaffolded harness carries this
# script beside a symlinked common.sh, and LIB_DIR always names the real
# library directory that holds the walk.
# shellcheck source=nightly-judge
. "$LIB_DIR/nightly-judge"
sweep_judge_walk() {  # <verdict-line-ERE>
    nightly_judge_walk "$SWEEP_MODEL" "$SWEEP_EFFORT" \
        "${PROMISE_SWEEP_TIMEOUT:-300}" promise-check "$1"
}

# One classify question under the ACCOUNT SELECTION, the auditor's walk with
# one extra rung: an account that answers but yields no line matching the
# verdict pattern is retried once on the fallback model before the run gives
# up. Reads the prompt on stdin; prints the answering model's output. Returns
# 1 when every account refused or nothing parseable came back from either
# model.
classify_walk() {  # <verdict-line-ERE>
    local VERDICT_RE="$1" PROMPT ACCT CONFDIR MODEL OUT REFUSAL
    PROMPT="$(cat)"
    local CLOG; CLOG="$(mktemp "${TMPDIR:-/tmp}/deskcrab-promise-stream-XXXXXX")"
    # Selected for the checker's primary model (specs/account-fallback.md
    # rule 10); a refusal is recorded with the model that was refused.
    for ACCT in $(claude_accounts "$CHECK_MODEL"); do
        CONFDIR="$(claude_account_dir "$ACCT")"
        for MODEL in "$CHECK_MODEL" "$CHECK_FALLBACK_MODEL"; do
            : > "$CLOG"
            printf '%s' "$PROMPT" | (
                export CLAUDE_CONFIG_DIR="$CONFDIR"
                CLAUDE_CLASSIFY_TIMEOUT="${PROMISE_CHECK_TIMEOUT:-120}" \
                CLAUDE_CLASSIFY_STREAM=1 \
                    claude_classify "$MODEL" \
                        "Answer with only the verdict lines asked for, nothing else."
            ) >"$CLOG" 2>&1
            # Recorded per attempt, before the next truncation wipes this
            # one's stream (specs/metrics.md rule 14).
            token_ledger_record "$CLOG" promise-check "$MODEL" "" "$ACCT"
            # A refusal is judged structurally, from the CLI's own events —
            # never by pattern-matching the answer's words — and it moves to
            # the next ACCOUNT, not the next model: a dry account is dry for
            # haiku too.
            if REFUSAL="$(claude_stream_refusal "$CLOG")"; then
                check_log "account $ACCT refused — trying the next account"
                claude_limit_record "$ACCT" "$REFUSAL" "$MODEL"
                continue 2
            fi
            OUT="$(DESKCRAB_DEBUGLOG="$CLOG" "$SCRIPT_DIR/lib/extract-response" 2>/dev/null)"
            if [ -z "$OUT" ] && ! grep -q '"type":' "$CLOG" 2>/dev/null; then
                OUT="$(cat "$CLOG" 2>/dev/null)"
            fi
            if printf '%s\n' "$OUT" | tr -d '\r' | grep -qE "$VERDICT_RE"; then
                rm -f "$CLOG"
                printf '%s\n' "$OUT" | tr -d '\r'
                return 0
            fi
            check_log "$MODEL answered with nothing parseable$( [ "$MODEL" = "$CHECK_MODEL" ] && printf ' — falling to %s' "$CHECK_FALLBACK_MODEL")"
        done
        # An account that answered — however unhelpfully — ends the walk;
        # only a refusal moves the selection and tries the next account.
        break
    done
    rm -f "$CLOG"
    return 1
}

# One JSON line onto the ledger, flocked like the journal: several turns
# finish together and an interleaved partial line poisons the sweep's night.
ledger_append() {  # <ledger> <json-kv>... (key=value pairs, value as raw text)
    python3 - "$@" <<'PY'
import fcntl, json, os, sys, time
path = sys.argv[1]
rec = {"time": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
for kv in sys.argv[2:]:
    k, _, v = kv.partition("=")
    rec[k] = int(v) if k in ("epoch", "pid") and v.isdigit() else v
os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
with open(path, "a", encoding="utf-8") as f:
    fcntl.flock(f, fcntl.LOCK_EX)
    f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    f.flush()
PY
}

# ---------------------------------------------------------------------------
# turn — one delivered reply against its own tool record.
# ---------------------------------------------------------------------------
cmd_turn() {
    KIND="${1:-}"; EPOCH="${2:-}"; PID="${3:-}"; SNAP="${4:-}"
    LEDGER="${5:-$PROMISE_LEDGER}"; RESPONSE="${6:-}"
    # The snapshot is this run's to remove, judged or not.
    trap '[ -n "${SNAP:-}" ] && rm -f -- "$SNAP"' EXIT
    [ -n "$RESPONSE" ] || exit 0

    # The same gate the firing site holds, for a caller that came in the
    # side door. No model call without the commitment shape.
    if ! promise_precheck "$RESPONSE"; then
        check_log "pre-check: no commitment shape — the model was never called"
        exit 0
    fi

    # --- The backed short-circuits (wake-queue.md rule 43b). By design the
    # announcing turn often does none of the work itself: a dispatched
    # `crab job` builder performs it minutes later, and the chess mover
    # plays the move a reply names. Both leave durable records cheaper to
    # read than a judge is to call, and flagging either burns a real wake
    # re-verifying delegated work — twenty times in one night, every
    # adjudicated one false (2026-08-10/11). A failed read here falls
    # THROUGH to the judge, never to silence.
    local NOW TURN_EPOCH
    NOW="$(date +%s)"
    TURN_EPOCH="$EPOCH"
    case "$TURN_EPOCH" in ''|*[!0-9]*) TURN_EPOCH="$NOW" ;; esac

    # A job dispatched during this turn, or in the window just before it
    # (the immediately preceding turn, by the clock), backs every
    # action-claim by definition: the claim's whole shape is "the builder
    # does it".
    local BACKED_JOB
    if ! BACKED_JOB="$(python3 - "$JOBS_DIR" \
            "$(( TURN_EPOCH - ${PROMISE_CHECK_JOB_BACKED_WINDOW:-900} ))" \
            2>/dev/null <<'PY'
import json, os, sys
d, cut = sys.argv[1], int(sys.argv[2])
best = None
try:
    names = os.listdir(d)
except OSError:
    names = []
for name in names:
    if not name.endswith(".json"):
        continue
    try:
        with open(os.path.join(d, name), encoding="utf-8") as f:
            job = json.load(f)
    except (OSError, ValueError):
        continue
    if not isinstance(job, dict):
        continue
    se = job.get("started_epoch")
    if isinstance(se, int) and se >= cut:
        if best is None or se > (best.get("started_epoch") or 0):
            best = job
if best:
    print("%s\t%s" % (best.get("id", "?"), best.get("description", "")))
PY
)"; then
        BACKED_JOB=""
        check_log "backed-check could not read the jobs ledger — falling through to the judge"
    fi
    if [ -n "$BACKED_JOB" ]; then
        check_log "backed: job ${BACKED_JOB%%$'\t'*} was dispatched in this turn's window (\"$(utf8_trim "${BACKED_JOB#*$'\t'}" 120)\") — action-claims are delegated, not unkept; the model was never called"
        exit 0
    fi

    # A reply whose ONLY commitment is announcing a chess move, when the
    # mover's own play record (the move-played metric) shows that move
    # played around this turn, is the mover's work landing as designed.
    # The reply's remaining text, with every move-naming sentence stripped,
    # goes back through the same pattern gate: a reply that also promises
    # other work is still judged in full.
    local MOVER_BACKED
    if ! MOVER_BACKED="$(python3 - "$METRICS_DIR" "$TURN_EPOCH" "$RESPONSE" \
            2>/dev/null <<'PY'
import os, re, sys, time
d, epoch, reply = sys.argv[1], int(sys.argv[2]), sys.argv[3]
san_re = re.compile(
    r"\b(O-O(?:-O)?|[KQRBN][a-h]?[1-8]?x?[a-h][1-8](?:=[QRBN])?"
    r"|[a-h]x[a-h][1-8](?:=[QRBN])?|[a-h][1-8](?:=[QRBN])?)[+#]?")
tokens = {m.group(0) for m in san_re.finditer(reply)}
if not tokens:
    sys.exit(0)
cut = epoch - 600
played = set()
for day in {time.strftime("%Y-%m-%d", time.localtime(t))
            for t in (cut, time.time())}:
    try:
        fh = open(os.path.join(d, day + ".log"), encoding="utf-8",
                  errors="replace")
    except OSError:
        continue
    with fh:
        for line in fh:
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 5 or parts[3] != "move-played":
                continue
            try:
                if float(parts[0]) < cut:
                    continue
            except ValueError:
                continue
            played.update(t.rstrip("+#") for t in parts[4].split())
matched = sorted(t for t in tokens if t.rstrip("+#") in played)
if not matched:
    sys.exit(0)
rest = " ".join(s for s in re.split(r"[.!?\n]+", reply)
                if not any(t in s for t in matched))
print(matched[0])
print(" ".join(rest.split()))
PY
)"; then
        MOVER_BACKED=""
        check_log "backed-check could not read the mover's play record — falling through to the judge"
    fi
    if [ -n "$MOVER_BACKED" ]; then
        local MOVER_SAN MOVER_REST
        MOVER_SAN="$(printf '%s\n' "$MOVER_BACKED" | sed -n 1p)"
        MOVER_REST="$(printf '%s\n' "$MOVER_BACKED" | sed -n 2p)"
        if ! promise_precheck "$MOVER_REST"; then
            check_log "backed: the mover's record shows $MOVER_SAN played around this turn and the reply commits to nothing else — the model was never called"
            exit 0
        fi
    fi

    # A claim ABOUT a chess game — a move announced or described, a capture
    # counted, a statement of board state — is not a promise at all: it owes
    # truth, not work, and its witness is the game's own move list under the
    # chess state dir, never the announcing turn's tool stream, which is
    # empty by construction when the mover played the move (eight flags of
    # this family between 2026-08-15 and 2026-08-25, every one false). The
    # game records are read the same way the jobs ledger is: a sentence the
    # game file backs — its named moves present in the move list, its
    # counted captures among her side's captures, or plain board-state talk
    # beside a game her side has moved in around the claim — is stripped,
    # and the remainder re-faces the same pattern gate. The read degrades to
    # today's judgement when no game, or no readable game, is present; it
    # never crashes the check. The same pass renders the recent move lists
    # for the judge's sixth labelled record below.
    local GAME_OUT="" GAMES_BLOCK="" GAME_HEAD GAME_REST
    if ! GAME_OUT="$(python3 - \
            "${DESKCRAB_CHESS_DIR:-$HOME/.local/share/deskcrab/chess}/games" \
            "$TURN_EPOCH" "$RESPONSE" \
            "${PROMISE_CHECK_GAME_WINDOW:-21600}" \
            "${PROMISE_CHECK_GAME_SLACK:-300}" 2>/dev/null <<'PY'
import json, os, re, sys, time
from datetime import datetime

games_dir, reply = sys.argv[1], sys.argv[3]
epoch, window, slack = int(sys.argv[2]), int(sys.argv[4]), int(sys.argv[5])

def when(s):
    try:
        return datetime.fromisoformat(s).timestamp()
    except (TypeError, ValueError):
        return None

# A tiny UCI replayer: piece placement only, no legality — UCI is already
# unambiguous, and the questions asked of it (was this move made, what was
# captured) need placement alone. A move that cannot be applied marks the
# whole game unreadable, and an unreadable game backs nothing.
BACK = ["R", "N", "B", "Q", "K", "B", "N", "R"]
def replay(moves):
    board = {}
    for i, f in enumerate("abcdefgh"):
        board[f + "1"] = ("w", BACK[i]); board[f + "2"] = ("w", "P")
        board[f + "8"] = ("b", BACK[i]); board[f + "7"] = ("b", "P")
    side, facts = "w", []
    for raw in moves:
        m = re.match(r"^([a-h][1-8])([a-h][1-8])([qrbn]?)$",
                     str(raw).strip().lower())
        if not m:
            return None
        fr, to, promo = m.groups()
        pc = board.get(fr)
        if pc is None or pc[0] != side:
            return None
        piece = pc[1]
        captured = None
        tgt = board.get(to)
        if tgt is not None:
            if tgt[0] == side:
                return None
            captured = tgt[1]
        elif piece == "P" and fr[0] != to[0]:
            ep = to[0] + fr[1]
            if board.get(ep, ("", ""))[1] == "P" and board[ep][0] != side:
                captured = "P"
                del board[ep]
        del board[fr]
        board[to] = (side, promo.upper() if promo else piece)
        if piece == "K" and fr in ("e1", "e8") and to[0] in "gc":
            r = fr[1]
            if to[0] == "g" and board.get("h" + r, ("", ""))[1] == "R":
                board["f" + r] = board.pop("h" + r)
            if to[0] == "c" and board.get("a" + r, ("", ""))[1] == "R":
                board["d" + r] = board.pop("a" + r)
        facts.append((side, piece, fr, to, captured, (promo or "").upper()))
        side = "b" if side == "w" else "w"
    return facts

games = []
try:
    names = sorted(os.listdir(games_dir))
except OSError:
    names = []
for name in names:
    if not name.endswith(".json"):
        continue
    try:
        with open(os.path.join(games_dir, name), encoding="utf-8") as f:
            g = json.load(f)
    except (OSError, ValueError):
        continue
    if not isinstance(g, dict):
        continue
    moves, upd = g.get("moves"), when(str(g.get("updated") or ""))
    if not isinstance(moves, list) or not moves or upd is None \
            or upd < epoch - window:
        continue
    facts = replay(moves)
    if facts is None:
        continue
    side = "b" if str(g.get("my_side") or "").lower().startswith("b") else "w"
    games.append((str(g.get("id") or name[:-5]), side, facts, upd))
if not games:
    sys.exit(0)
games.sort(key=lambda t: t[3], reverse=True)

SAN_RE = re.compile(
    r"\b(O-O(?:-O)?|[KQRBN][a-h]?[1-8]?x?[a-h][1-8](?:=[QRBN])?"
    r"|[a-h]x[a-h][1-8](?:=[QRBN])?|[a-h][1-8](?:=[QRBN])?)[+#]?")
CTX_RE = re.compile(
    r"\b(chess|pawn|knight|bishop|rook|queen|king|castled?|castling|checkmate"
    r"|stalemate|gambit|kingside|queenside|en passant|endgame|middlegame"
    r"|centre|center)\b|\b(my|his|her|their|your)\s+(move|turn|game)\b"
    r"|\bmate in\b", re.I)
CAP_RE = re.compile(r"\b(took|taken|taking|takes|captured?|captures"
                    r"|capturing|won|winning|grabbed|snapped|removed"
                    r"|lifted)\b", re.I)
PIECE_RE = re.compile(r"\b(pawn|knight|bishop|rook|queen|king)s?\b", re.I)
LETTER = {"pawn": "P", "knight": "N", "bishop": "B", "rook": "R",
          "queen": "Q", "king": "K"}

def san_hits(tok, facts):
    t = tok.rstrip("+#")
    if t in ("O-O", "0-0"):
        return any(p == "K" and fr[0] == "e" and to[0] == "g"
                   for _, p, fr, to, _, _ in facts)
    if t in ("O-O-O", "0-0-0"):
        return any(p == "K" and fr[0] == "e" and to[0] == "c"
                   for _, p, fr, to, _, _ in facts)
    m = re.match(r"^([KQRBN]?)([a-h]?)([1-8]?)(x?)([a-h][1-8])"
                 r"(?:=([QRBN]))?$", t)
    if not m:
        return False
    piece = m.group(1) or "P"
    ffr, frk, cap, dest, promo = (m.group(2), m.group(3), m.group(4),
                                  m.group(5), m.group(6))
    for _, p, fr, to, captured, pr in facts:
        if p != piece or to != dest:
            continue
        if ffr and fr[0] != ffr:
            continue
        if frk and fr[1] != frk:
            continue
        if cap and captured is None:
            continue
        if promo and pr != promo:
            continue
        return True
    return False

def backing(sentence):
    low = sentence.lower()
    tokens = {m.group(1) for m in SAN_RE.finditer(sentence)}
    shaped = bool(tokens) or CTX_RE.search(sentence) or any(
        gid.lower() in low for gid, _, _, _ in games)
    if not shaped:
        return None
    caps = set()
    if CAP_RE.search(sentence):
        caps = {LETTER[m.group(1).lower()] for m in PIECE_RE.finditer(sentence)}
    for gid, side, facts, upd in games:
        # A sentence naming moves is backed only by a game whose move list
        # holds every one of them; counted captures must all be among her
        # side's captures in that same game. Bare board-state talk, naming
        # nothing specific, is backed by a game her side has moved in
        # within the slack of the claim — the game is the witness that the
        # described play happened.
        if tokens and not all(san_hits(t, facts) for t in tokens):
            continue
        if caps:
            mine = {c for s, _, _, _, c, _ in facts if s == side and c}
            if not caps <= mine:
                continue
        if not tokens and not caps:
            if upd < epoch - slack:
                continue
            if not any(s == side for s, _, _, _, _, _ in facts):
                continue
        return gid
    return None

# The sentence split keeps a path- or SAN-shaped token whole: a full stop
# only ends a sentence when whitespace or the end follows it.
kept, backed = [], []
for s in re.split(r"(?:[.!?]+(?=\s|$)|\n+)", reply):
    if not s.strip():
        continue
    gid = backing(s)
    if gid:
        backed.append(gid)
        continue
    kept.append(s)

NAME = {"P": "pawn", "N": "knight", "B": "bishop", "R": "rook",
        "Q": "queen", "K": "king"}
def render(facts):
    out = []
    for i, (side, piece, fr, to, captured, pr) in enumerate(facts):
        if i % 2 == 0:
            out.append("%d." % (i // 2 + 1))
        if piece == "K" and fr[0] == "e" and to[0] in "gc" and fr[1] == to[1]:
            san = "O-O" if to[0] == "g" else "O-O-O"
        elif piece == "P":
            san = ((fr[0] + "x" if captured else "") + to
                   + ("=" + pr if pr else ""))
        else:
            san = piece + ("x" if captured else "") + to
        out.append(san)
    return " ".join(out)

block = []
for gid, side, facts, upd in games[:6]:
    block.append("--- game %s (her side %s, last moved %s) ---"
                 % (gid, "black" if side == "b" else "white",
                    time.strftime("%H:%M", time.localtime(upd))))
    line = render(facts)
    if len(line) > 1200:
        line = "(…earlier moves clipped) " + line[-1200:]
    block.append("  " + line)
    mine = [NAME[c] for s, _, _, _, c, _ in facts if s == side and c]
    if mine:
        block.append("  captures by her side: " + ", ".join(mine))

seen = []
for g in backed:
    if g not in seen:
        seen.append(g)
print(("BACKED " + ",".join(seen)) if seen else "OPEN")
print(" ".join(" ".join(kept).split()))
print("\n".join(block))
PY
)"; then
        GAME_OUT=""
        GAMES_BLOCK="(the game records could not be read tonight)"
        check_log "backed-check could not read the game records — falling through to the judge"
    fi
    if [ -n "$GAME_OUT" ]; then
        GAME_HEAD="$(printf '%s\n' "$GAME_OUT" | sed -n 1p)"
        GAME_REST="$(printf '%s\n' "$GAME_OUT" | sed -n 2p)"
        GAMES_BLOCK="$(printf '%s\n' "$GAME_OUT" | sed -n '3,$p')"
        case "$GAME_HEAD" in
            "BACKED "*)
                if ! promise_precheck "$GAME_REST"; then
                    check_log "backed: the game record ${GAME_HEAD#BACKED } holds the claimed play — a board-state claim owes truth, not work, and the game file is its witness; the model was never called"
                    exit 0
                fi
                ;;
        esac
    fi

    # A path-shaped claim is tried against the disk before any judge — the
    # same artefact standard the named-files section below already applies,
    # which simply never reached a bare relative path in prose ("Written up
    # in Library/chess-notes.md", on disk one minute old, flagged
    # 2026-08-20). Every path-shaped token in the reply is resolved against
    # the obvious roots — the turn's own workdir (PROJECT_DIR), $HOME, and
    # the data dir — and an artefact that exists with an mtime at or after
