#!/usr/bin/env python3
"""The nightly claudism review — detection and review, never a gate.

Reads one day of the journal, keeps only the SPOKEN half of each reply (the
text above the display delimiter), holds it against the user-maintained phrase
list, and writes a dated report. The scoring is by FUNCTION — the rhetorical
move an entry performs, not the string that performed it tonight — because a
banned word's share moving to a sibling word is the same habit in a new coat
(specs/nightly.md rules 46-49). Every caught sentence is quoted with its
timestamp beside a proposed correction: a mechanical deletion where the cure
is striking decoration, a model rewrite in the assistant's own voice where
only a different sentence will do — and a proposal that lands inside the same
function is marked a MISS, never presented as the fix. A hit whose words are
quoted or talked about rather than said is a mention: recorded, reported,
never scored as a use. Counts accumulate night over night so the number can
be watched going down. The report is surfaced by a morning event wake — a
clean night and a failed scan included, because a review she never hears
about is surveillance, not an exercise.

What this deliberately is not: a filter. Nothing here runs during a live
turn, nothing gates, mutes, or edits a reply, and nothing may ever grow into
doing so — specs/nightly.md rules 39-49, and the standing rule of
specs/speech-output.md, which outranks this whole file.

  claudism-scan run [YYYY-MM-DD]    scan that day (default: yesterday)

The phrase list is personal state, never in this repository. Markdown, one
entry per heading, readable as prose and parseable at the same time:

  ## "honestly", and the whole honesty family
  - pattern: `\\bhonest(?:y|ly)?\\b`
  - why: the reason it is a borrowed phrase, in the user's own words.
  - function: vouching
  - fix: delete

`function:` files the entry under the move it performs (several entries may
share one); `fix:` says what a true correction looks like (unset: delete
where the entry carries `replace:` lines, resay otherwise). The full format
is lib/claudism-capture's.

Knobs, all by environment, all defaulted: DAY_JOURNAL_DIR, CRAB_BIN,
CLAUDISM_LIST (the phrase list), CLAUDISM_DIR (reports and counts),
CLAUDISM_FLAGS_DIR (the day flag log, for corroborating the live mirror —
rule 49), CLAUDISM_WAKE_AT (default 09:30), CLAUDISM_MODEL (default the
ingest's), CLAUDISM_REWRITES=0 to skip the model call, CLAUDISM_MAX_REWRITES
(default 40), CLAUDISM_VOICE_FILE (notes on the wanted voice, handed to the
rewrite call — also personal, also never in this repository).
"""

import datetime
import json
import os
import re
import subprocess
import sys
import time

# memory.py owns the account-chain walk for out-of-band model calls
# (specs/account-fallback.md rule 29), so the rewrite call reuses it rather
# than spelling the chain again. Imported FIRST, before any other work: with
# sqlite-vec absent under a bare system python, memory.py re-execs the whole
# process into the store's venv (its own header explains why), and that must
# happen while there is nothing to redo. Where neither the import nor the
# venv is available, the review still runs — the rewrites go missing, never
# the detection (specs/nightly.md rule 42).
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import memory
except BaseException:  # SystemExit included: no venv means no rewrites, not no review
    memory = None

DATA_HOME = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
STATE_DIR = os.path.join(DATA_HOME, "deskcrab")
JOURNAL_DIR = os.environ.get("DAY_JOURNAL_DIR") or os.path.join(STATE_DIR, "journal")
LIST_PATH = os.environ.get("CLAUDISM_LIST") or os.path.join(STATE_DIR, "claudisms.md")
OUT_DIR = os.environ.get("CLAUDISM_DIR") or os.path.join(STATE_DIR, "claudisms")
FLAGS_DIR = os.environ.get("CLAUDISM_FLAGS_DIR") or os.path.join(STATE_DIR, "claudism-flags")
# The persona-signature list — speech-output.md rule 54's suppression, ONE
# named place, personal state beside the phrase list, never inlined here.
SIGNATURES_PATH = os.environ.get("CLAUDISM_SIGNATURES") or os.path.join(
    STATE_DIR, "persona-signatures.md")
CRAB = os.environ.get("CRAB_BIN") or os.path.expanduser("~/.local/bin/crab")
WAKE_AT = os.environ.get("CLAUDISM_WAKE_AT") or "09:30"

# The delimiter, anchored to its own line and tolerant of surrounding
# whitespace — specs/speech-output.md rules 3 and 4. The journal holds the
# reply in full, display half included, so the split happens here again;
# matching it loosely would silently review her display tables as speech.
DISPLAY_RE = re.compile(r"(?m)^[ \t]*---DISPLAY---[ \t]*$")


def load_classifier():
    """The mention test lives in lib/claudism-mirror — one classifier, kept
    identical in the capture, imported here (the mirror's library half is
    import-safe by contract). If it cannot be loaded the review still runs,
    every hit scored as a use, and the report says so: a broken guard must
    inflate a visible number, never lose a night."""
    try:
        import importlib.machinery
        import importlib.util
        p = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                         "claudism-mirror")
        loader = importlib.machinery.SourceFileLoader("claudism_mirror", p)
        spec = importlib.util.spec_from_loader("claudism_mirror", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod.classify_use, ""
    except Exception as e:
        return (lambda s, a, b, t="": "use"), (
            "the mention guard could not be loaded (%s) — every hit tonight "
            "is scored as a use" % e)


def spoken_half(reply):
    return DISPLAY_RE.split(reply, 1)[0]


def sentences(text):
    """The spoken half, one sentence at a time. Fences are not speech."""
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    out = []
    for line in text.splitlines():
        line = re.sub(r"^[\s>*-]+", "", line).strip()
        if not line:
            continue
        for s in re.split(r"(?<=[.!?…])\s+", line):
            s = s.strip()
            if s:
                out.append(s)
    return out


def parse_list(path):
    """The phrase list: prose first, parseable second. Returns (entries, broken)
    where entries hold a compiled pattern and broken names what did not compile
    — a broken entry lands in the report rather than vanishing."""
    entries, broken = [], []
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return entries, broken
    cur = None
    for line in text.splitlines():
        m = re.match(r"^##\s+(.+?)\s*$", line)
        if m:
            cur = {"title": m.group(1), "why": "", "pattern": None,
                   "function": "", "fix": "", "replaces": []}
            # The count key is read in the trend table for years: the short
            # name before the em-dash, not the whole heading with its examples.
            key = re.split(r"\s+—\s+", cur["title"])[0]
            key = re.sub(r"[^a-z0-9]+", "-", key.lower()).strip("-")
            cur["key"] = key[:48] or "unnamed"
            entries.append(cur)
            continue
        if cur is None:
            continue
        m = re.match(r"^-\s*pattern:\s*`(.+)`\s*$", line)
        if m:
            try:
                cur["pattern"] = re.compile(m.group(1), re.I)
            except re.error as e:
                broken.append("%s — %s" % (cur["title"], e))
            continue
        m = re.match(r"^-\s*why:\s*(.+?)\s*$", line)
        if m:
            cur["why"] = m.group(1)
            continue
        m = re.match(r"^-\s*function:\s*([a-z0-9][a-z0-9-]*)\s*$", line, re.I)
        if m:
            cur["function"] = m.group(1).lower()
            continue
        m = re.match(r"^-\s*fix:\s*(delete|resay)\s*$", line, re.I)
        if m:
            cur["fix"] = m.group(1).lower()
            continue
        m = re.match(r"^-\s*replace:\s*`(.*)`\s*->\s*`(.*)`\s*$", line)
        if m:
            # Her replacement table, carried for the deletion rendering of
            # rule 48 — never applied to anything already said.
            try:
                cur["replaces"].append((re.compile(m.group(1), re.I),
                                        m.group(2)))
            except re.error:
                pass
            continue
    entries = [e for e in entries if e["pattern"]]
    for e in entries:
        if not e["function"]:
            e["function"] = e["key"]
        if not e["fix"]:
            e["fix"] = "delete" if e["replaces"] else "resay"
    return entries, broken


def read_day(day):
    """One journal day, oldest first, her voice only: a job's entry is a
    builder's log, not something she said (specs/nightly.md rule 41)."""
    path = os.path.join(JOURNAL_DIR, day + ".jsonl")
    if not os.path.exists(path):
        return None, 0
    turns, bad = [], 0
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                bad += 1
                continue
            if e.get("kind") == "job" or not e.get("reply"):
                continue
            turns.append(e)
    turns.sort(key=lambda e: e.get("epoch", 0))
    return turns, bad


def scan(turns, phrases, classify):
    """Every caught sentence, once per entry it leans on, classed use or
    mention — and the night's spoken word count, the denominator of every
    rate in the report."""
    hits, words = [], 0
    for e in turns:
        t = (e.get("time") or "")[11:16] or "??:??"
        kind = e.get("kind", "?")
        pid = e.get("pid")
        spoken = spoken_half(e["reply"])
        words += len(re.sub(r"```.*?```", " ", spoken, flags=re.S).split())
        for s in sentences(spoken):
            for p in phrases:
                cls = None
                for m in p["pattern"].finditer(s):
                    if classify(s, m.start(), m.end(), p["title"]) == "use":
                        cls = "use"
                        break
                    cls = "mention"
                if cls is None:
                    continue
                hits.append({"time": t, "kind": kind, "pid": pid,
                             "sentence": s, "key": p["key"],
                             "function": p["function"], "use": cls})
    return hits, words


def deletion_render(sentence, entry):
    """The mechanical correction for a decoration entry (rule 48): her own
    replace lines first, and where they do not cover, the bare span struck
    only if it is a free-standing -ly adverb — then only the repairs a
    deleted span makes necessary — the doubled space, an orphaned comma, the
    sentence's leading capital. Returns None where deletion cannot carry the
    sentence (nothing left, the pattern still fires, or the span is holding
    the rest of the words up) — those route to the model like any resay.

    The span guard is rule 50, and 2026-08-08 is why it exists: striking a
    whole match left "Intermittent is the kind of hard" and "what was
    surfaced, what with it". An adverb comes away clean; an adjective its
    noun is sitting on, or a span with the verb inside it, does not, and a
    mangled line teaches nothing."""
    out = sentence
    for rx, text in entry["replaces"]:
        out = rx.sub(lambda _m, _t=text: _t, out)
    if entry["pattern"].search(out):
        spans = {m.group(0).strip().lower()
                 for m in entry["pattern"].finditer(out)}
        if not all(re.fullmatch(r"[a-z]+ly", s) for s in spans):
            return None
        out = entry["pattern"].sub("", out)
    if out == sentence:
        return None
    out = re.sub(r" {2,}", " ", out)
    out = re.sub(r"\s+([,.;:!?…])", r"\1", out)
    out = re.sub(r"^(\s*),\s*", r"\1", out)
    out = out.strip()
    for i, ch in enumerate(out):
        if not ch.isalpha():
            continue
        if ch.islower():
            for bch in sentence:
                if bch.isalpha():
                    if bch.isupper():
                        out = out[:i] + ch.upper() + out[i + 1:]
                    break
        break
    if not out or len(out.split()) < 2 or entry["pattern"].search(out):
        return None
    return out


def substitution_key(proposal, function, phrases, classify):
    """The key of a same-function entry the proposal still fires as a use,
    or '' — the test of rule 48: a rewrite that satisfies a ban by moving to
    a neighbouring word inside the same move is a miss, not a pass."""
    for p in phrases:
        if p["function"] != function:
            continue
        for m in p["pattern"].finditer(proposal):
            if classify(proposal, m.start(), m.end(), p["title"]) == "use":
                return p["key"]
    return ""


def propose_rewrites(hits, phrases, classify):
    """One correction per caught sentence: mechanical deletion for the
    fix-delete entries (no model, no cap), one model call for the night for
    the rest, under the account chain by way of memory.py. Every proposal is
    then held against the list itself — a same-function fire marks it
    substituted (rule 48). Returns (rewrites, substituted, note); any
    failure is a note in the report, never a lost report."""
    entries = {p["key"]: p for p in phrases}
    uniq, seen = [], set()
    for h in hits:
        if h["sentence"] not in seen:
            seen.add(h["sentence"])
            uniq.append(h)

    rewrites, substituted = {}, {}
    to_model = []
    for h in uniq:
        p = entries.get(h["key"])
        if p and p["fix"] == "delete":
            out = deletion_render(h["sentence"], p)
            if out is not None:
                rewrites[h["sentence"]] = out
                continue
        to_model.append(h)

    note = ""
    if to_model and os.environ.get("CLAUDISM_REWRITES", "1") == "0":
        note = "rewrites switched off (CLAUDISM_REWRITES=0)"
        to_model = []
    if to_model and (memory is None or not hasattr(memory, "run_claude")):
        note = "memory.py was not importable — no model call was made"
        to_model = []
    if to_model:
        model = (os.environ.get("CLAUDISM_MODEL")
                 or os.environ.get("MEMORY_INGEST_MODEL") or "sonnet")
        cap = int(os.environ.get("CLAUDISM_MAX_REWRITES", "40"))
        capped = to_model[:cap]
        whys = {p["key"]: (p["title"], p["why"], p["function"])
                for p in phrases}
        lines = ["A desktop assistant spoke the numbered sentences below, and each one",
                 "leans on phrasing she has banned for herself. Her reasons:", ""]
        for key in sorted({h["key"] for h in capped}):
            title, why, fn = whys.get(key, (key, "", ""))
            lines.append("- %s (the %s move): %s"
                         % (title, fn or key, why or "on the list"))
        voice = os.environ.get("CLAUDISM_VOICE_FILE") or os.path.join(
            STATE_DIR, "conduct", "sound-like-myself.md")
        try:
            with open(voice, encoding="utf-8") as f:
                lines += ["", "Her own notes on the voice she wants:", f.read(4000)]
        except OSError:
            pass
        lines += ["",
                  "For each numbered sentence, write the sentence she should have said",
                  "instead: the same fact, as short or shorter, none of the banned",
                  "phrasing, and a live person's voice rather than an assistant's",
                  "register — no preamble, no self-appraisal, no borrowed cadence.",
                  "NEVER perform the same move in a different word: a synonym that",
                  "still vouches, still promises, still concedes, still reports on",
                  "her own diligence is a miss, not a fix. Where a banned word only",
                  "decorated the claim, the fix is deletion — say the sentence",
                  "plainly and let it stand.",
                  "Reply with exactly one line per sentence, in the form",
                  "N. <the rewrite>",
                  "and nothing else.", ""]
        lines += ["%d. [%s] %s" % (i + 1, h["key"], h["sentence"])
                  for i, h in enumerate(capped)]
        try:
            body = memory.run_claude("\n".join(lines), model, timeout=600,
                                     kind="claudism-scan")
            for m in re.finditer(r"(?m)^\s*(\d+)[.)]\s+(.+?)\s*$", body):
                i = int(m.group(1)) - 1
                if 0 <= i < len(capped):
                    rewrites[capped[i]["sentence"]] = m.group(2)
        except Exception as e:
            note = "the rewrite call failed — %s" % e
        if len(to_model) > cap:
            note = ("%d caught sentences past the cap of %d carry no rewrite "
                    "tonight" % (len(to_model) - cap, cap))

    fn_by_sentence = {h["sentence"]: h["function"] for h in uniq}
    for sent, proposal in rewrites.items():
        key = substitution_key(proposal, fn_by_sentence.get(sent, ""),
                               phrases, classify)
        if key:
            substituted[sent] = key
    return rewrites, substituted, note


def corroborate(day, hits, phrases):
    """Rule 49: a live-mirror rewrite whose turn's FINAL reply still fires
    the same function went out as the same move in new words. Joined on the
    journal pid where both sides carry one; a row without a pid falls back
    to a day-level note. Reads the flag log and never writes it."""
    path = os.path.join(FLAGS_DIR, day + ".jsonl")
    rows = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rows.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    except OSError:
        return []
    pat_fn = {p["pattern"].pattern: p["function"] for p in phrases}
    live = [r for r in rows
            if r.get("stage") == "live" and r.get("outcome") == "rewrite"
            and r.get("sentence")]
    if not live:
        return []
    by_pid = {}
    day_fns = set()
    for h in hits:
        day_fns.add(h["function"])
        if h.get("pid"):
            by_pid.setdefault(h["pid"], []).append(h)
    notes, said = [], set()
    for r in live:
        fn = r.get("function") or pat_fn.get(r.get("pattern") or "")
        if not fn:
            continue
        held = " ".join(str(r["sentence"]).split())
        if (fn, held) in said:
            continue
        clock = (r.get("time") or "")[11:16] or "??:??"
        pid = r.get("pid")
        if pid and pid in by_pid:
            still = [h for h in by_pid[pid]
                     if h["function"] == fn and h["sentence"] != r["sentence"]]
            if still:
                said.add((fn, held))
                notes.append("**%s (%s)** — held and rewritten for %s, and the "
                             "reply that went out still fires %s: “%s”"
                             % (clock, r.get("kind", "?"), fn, fn,
                                still[0]["sentence"]))
        elif not pid and fn in day_fns:
            said.add((fn, held))
            notes.append("**%s (%s)** — a live rewrite for %s, and the day "
                         "still fires %s elsewhere (no pid to join on)"
                         % (clock, r.get("kind", "?"), fn, fn))
    return notes


def update_counts(day, phrases, hits):
    """counts.tsv: one line per night and phrase — USES only, mentions are
    rule 47's business — zeros included so a clean night is a point on the
    curve. This night's lines replace themselves — a re-run never doubles
    (specs/nightly.md rule 43)."""
    path = os.path.join(OUT_DIR, "counts.tsv")
    kept = []
    try:
        with open(path, encoding="utf-8") as f:
            kept = [ln for ln in f.read().splitlines()
                    if ln.strip() and not ln.startswith(day + "\t")]
    except OSError:
        pass
    tonight = {p["key"]: 0 for p in phrases}
    for h in hits:
        tonight[h["key"]] = tonight.get(h["key"], 0) + 1
    for key in sorted(tonight):
        kept.append("%s\t%s\t%d" % (day, key, tonight[key]))
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(kept) + "\n")
    os.replace(tmp, path)
    history = {}
    for ln in kept:
        try:
            d, key, n = ln.split("\t")
            history.setdefault(key, {})[d] = int(n)
        except ValueError:
            continue  # a mangled line loses itself, never the night
    return tonight, history


def update_functions(day, phrases, hits, words):
    """functions.tsv: one line per night and function — uses, mentions, and
    the night's spoken words, so any night's rate can be recomputed. Replaces
    itself on a re-run like counts.tsv (rule 43)."""
    path = os.path.join(OUT_DIR, "functions.tsv")
    kept = []
    try:
        with open(path, encoding="utf-8") as f:
            kept = [ln for ln in f.read().splitlines()
                    if ln.strip() and not ln.startswith(day + "\t")]
    except OSError:
        pass
    tonight = {p["function"]: [0, 0] for p in phrases}
    for h in hits:
        t = tonight.setdefault(h["function"], [0, 0])
        t[0 if h["use"] == "use" else 1] += 1
    for fn in sorted(tonight):
        kept.append("%s\t%s\t%d\t%d\t%d"
                    % (day, fn, tonight[fn][0], tonight[fn][1], words))
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(kept) + "\n")
    os.replace(tmp, path)
    history = {}
    for ln in kept:
        try:
            d, fn, u, m, w = ln.split("\t")
            history.setdefault(fn, {})[d] = (int(u), int(m), int(w))
        except ValueError:
            continue
    return tonight, history


def substitution_watch(day, phrases, history):
    """The churn test of rule 48, from the per-member history: inside a
    function, a member that went quiet tonight beside a sibling that rose is
    the move changing words. The verdict on the family total is COMPUTED,
    never a fixed tail — this function once closed every note by asserting
    the total held, and that was false in four of the first eleven notes
    (2026-08-20..23, families down by half or more reported as holding).
    Tonight's total is held against the prior nightly average and may be
    called holding only when the two agree within one occurrence or a
    quarter of the average, whichever is larger; outside the band the note
    says which way the family moved and by how much, and claims nothing it
    did not measure. Churn at a family total of one is arithmetic, not
    evidence: no note below two. A member first counted tonight cannot be
    the risen side — counts.tsv writes every current entry every night,
    zeros included, so a key with no earlier row did not exist to be
    measured, and its zero-filled past would read any first count as a
    rise. Needs at least one earlier night to compare against — the corpus
    tool covers the deeper past."""
    members = {}
    for p in phrases:
        members.setdefault(p["function"], []).append(p["key"])
    notes = []
    for fn in sorted(members):
        keys = members[fn]
        if len(keys) < 2:
            continue
        prev_days = sorted({d for k in keys for d in history.get(k, {})
                            if d < day})
        if not prev_days:
            continue

        def prev_avg(k):
            return sum(history.get(k, {}).get(d, 0) for d in prev_days) \
                / float(len(prev_days))

        def measured_before(k):
            return any(d < day for d in history.get(k, {}))

        quiet = [k for k in keys
                 if history.get(k, {}).get(day, 0) == 0 and prev_avg(k) > 0]
        risen = [k for k in keys
                 if measured_before(k)
                 and history.get(k, {}).get(day, 0) > prev_avg(k)]
        if not (quiet and risen):
            continue
        total = sum(history.get(k, {}).get(day, 0) for k in keys)
        before = sum(prev_avg(k) for k in keys)
        if total < 2:
            continue
        head = ("inside **%s**: %s went quiet while %s rose "
                "(family total %d tonight, ~%.1f a night before) — "
                % (fn, ", ".join(quiet), ", ".join(risen), total, before))
        if abs(total - before) <= max(1.0, before / 4.0):
            notes.append(head + "the total holds: the move changed words, "
                         "it did not die.")
        elif total < before:
            notes.append(head + "the total did not hold: the family fell "
                         "by %d%% tonight — quieter is the finding, and the "
                         "weight that remains moved to %s, a weaker claim "
                         "than substitution."
                         % (int(round(100 * (1 - total / before))),
                            ", ".join(risen)))
        else:
            notes.append(head + "the total did not hold: the family grew "
                         "%.1fx tonight — the move got louder even as it "
                         "changed words." % (total / before))
    return notes


def load_signatures():
    """The persona-signature suppression list (speech-output.md rule 54): the
    phrases that are genuinely hers, named by the user, kept in ONE place —
    `CLAUDISM_SIGNATURES`, personal state beside the phrase list, never
    inlined here. Markdown bullets, the phrase in backticks, anything after
    it hers to write. A phrase on it is never reported as a ratchet whatever
    the numbers say: a repair restoring her own signature is the cure
    working, not the cure shaping her. Returns (set, warning) — an
    unreadable list is a warning in the report, because losing the
    suppression silently is exactly the false positive this list closed."""
    sigs = set()
    try:
        with open(SIGNATURES_PATH, encoding="utf-8") as f:
            for line in f:
                m = re.match(r"^-\s*`([^`]+)`", line.strip())
                if m:
                    norm = " ".join(re.findall(r"[a-z']+", m.group(1).lower()))
                    if norm:
                        sigs.add(norm)
    except OSError as e:
        return sigs, ("the persona-signature list at %s could not be read "
                      "(%s) — nothing was suppressed tonight"
                      % (SIGNATURES_PATH, getattr(e, "strerror", None) or e))
    return sigs, ""


def _spoken_token_lists(turns):
    """One token list per reply's spoken half, fences stripped — the same
    `[a-z']+` cut the candidate grams are made of, kept per-reply so no gram
    is counted across a reply boundary."""
    out = []
    for e in turns:
        spoken = re.sub(r"```.*?```", " ", spoken_half(e["reply"]), flags=re.S)
        out.append(re.findall(r"[a-z']+", spoken.lower()))
    return out


def _gram_rate(tok_lists, gram_words):
    """Occurrences of the gram per 1000 spoken words across the night, or
    None where the night has no spoken words to be a denominator."""
    words = sum(len(t) for t in tok_lists)
    if not words:
        return None
    n = len(gram_words)
    count = 0
    for toks in tok_lists:
        for i in range(len(toks) - n + 1):
            if toks[i:i + n] == gram_words:
                count += 1
    return count * 1000.0 / words


def _prior_nights(day, want=6, span=14):
    """The preceding journal nights the rates compare against: the most
    recent `want` days with a journal file, looking back at most `span`
    calendar days, oldest first."""
    try:
        d0 = datetime.date.fromisoformat(day)
    except ValueError:
        return []
    out = []
    for back in range(1, span + 1):
        d = (d0 - datetime.timedelta(days=back)).isoformat()
        if os.path.exists(os.path.join(JOURNAL_DIR, d + ".jsonl")):
            out.append(d)
            if len(out) >= want:
                break
    out.reverse()
    return out


def _median(xs):
    s = sorted(xs)
    mid = len(s) // 2
    return s[mid] if len(s) % 2 else (s[mid - 1] + s[mid]) / 2.0


def tic_drift(day, phrases, turns):
    """Rule 54's watch, WITH a denominator (speech-output.md rule 54, amended
    for the record rule-54-s-ratchet-has-no-denominator-so-it-has-b). The
    flag log still nominates the candidates: word-grams the mirror's
    rewrites added to several repaired lines and never once removed. But a
    share of the repaired lines convicts nothing by itself — repairs are
    sentences she wrote, so any phrase she habitually uses appears "added
    and never removed" when the repairs are counted against only themselves;
    every line this section fired in its first nine nights was false or
    worthless for exactly that. A candidate is reported only when its rate
    across ALL of the day's spoken words — the same population as every
    other rate in the report: spoken halves, jobs excluded, per 1000 spoken
    words — is climbing night over night: at least two prior nights on
    record, the last three nightly rates strictly rising, and tonight at
    least 1.5x the median of the prior nights'. The thresholds are chosen
    against the hand-measured "which is" series of 2026-08-08..16 (1.08,
    1.14, 1.20, 0.81, 0.94, 1.29, 1.14 per 1000 words): its loudest night
    rose three-in-a-row to 1.29 but sat under 1.5 x its prior median of
    1.08, so a flat habit never fires. Persona signatures are suppressed
    unconditionally (load_signatures), the "on no list here" clause is
    computed against the loaded patterns rather than asserted, and a flagged
    gram wholly contained in an equally-counted flagged gram is dropped —
    one tic, one line, not 2026-08-20's five. Reads the flag log and the
    journal, writes neither."""
    path = os.path.join(FLAGS_DIR, day + ".jsonl")
    added, removed = {}, {}
    pairs = 0
    try:
        f = open(path, encoding="utf-8")
    except OSError:
        return []
    with f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            before, after = row.get("before") or "", row.get("after") or ""
            if not before or not after:
                continue
            pairs += 1

            # Two and three words both: the tics that matter are short, and
            # a trigram alone misses them because the words on either side
            # of the flourish change with every line it is bolted onto.
            def grams(text, n):
                w = re.findall(r"[a-z']+", text.lower())
                return {" ".join(w[i:i + n]) for i in range(len(w) - n + 1)}

            for n in (2, 3):
                b, a = grams(before, n), grams(after, n)
                for g in a - b:
                    added[g] = added.get(g, 0) + 1
                for g in b - a:
                    removed[g] = removed.get(g, 0) + 1
    if pairs < 5:
        return []
    cands = [(n, g) for g, n in added.items()
             if n >= 3 and not removed.get(g)]
    if not cands:
        return []

    # The unconditional suppression: a gram that is, or contains, or sits
    # inside a named persona signature is hers, not the mirror's.
    sigs, sig_warn = load_signatures()

    def is_signature(g):
        padded = " %s " % g
        return any((" %s " % s) in padded or padded in (" %s " % s)
                   for s in sigs)

    cands = [c for c in cands if not is_signature(c[1])]
    if not cands:
        return []

    # The denominator: tonight's spoken words and the preceding nights',
    # read once, held per reply. A prior night whose journal holds no
    # spoken words at all cannot be a point on anyone's curve.
    tonight_toks = _spoken_token_lists(turns)
    prior_toks = []
    for d in _prior_nights(day):
        prior_turns, _bad = read_day(d)
        prior_toks.append(_spoken_token_lists(prior_turns or []))

    flagged = []
    for n, g in sorted(cands, reverse=True):
        gram_words = g.split(" ")
        tonight_rate = _gram_rate(tonight_toks, gram_words)
        if tonight_rate is None or tonight_rate <= 0:
            continue
        series = [r for r in (_gram_rate(t, gram_words) for t in prior_toks)
                  if r is not None]
        if len(series) < 2:
            continue
        rates = series + [tonight_rate]
        if not (rates[-3] < rates[-2] < rates[-1]):
            continue
        if tonight_rate < 1.5 * _median(series):
            continue
        flagged.append((n, g, rates))

    # One tic, one line: "to authenticate" beside "to authenticate oauth"
    # at the same count is the same addition counted twice.
    kept = [(n, g, rates) for n, g, rates in flagged
            if not any(g != g2 and (" %s " % g) in (" %s " % g2) and n2 >= n
                       for n2, g2, _r in flagged)]
    out = []
    for n, g, rates in kept[:5]:
        home = ""
        for p in phrases:
            if p["pattern"].search(g):
                home = p["title"]
                break
        trail = ", ".join("%.2f" % r for r in rates)
        clause = ("and it is already on the list here — “%s”." % home
                  if home else "and it is on no list here.")
        out.append("the rewrites added “%s” to %d of %d repaired lines and "
                   "never once removed it, and its rate across the day's "
                   "spoken words is climbing night over night (%s per 1000, "
                   "oldest first) — a one-way ratchet, %s"
                   % (g, n, pairs, trail, clause))
    if out and sig_warn:
        out.append("(%s.)" % sig_warn)
    return out


def write_report(day, turns, bad, phrases, broken, uses, mentions, words,
                 rewrites, substituted, note, corr, tonight, history,
                 fn_tonight, fn_history):
    lines = ["# Claudism review — %s" % day, ""]
    lines.append("%d replies read (desk, phone, wake — jobs excluded), spoken "
                 "halves only: %d spoken words." % (len(turns), words))
    if bad:
        lines.append("(%d unparseable journal line%s skipped.)"
                     % (bad, "" if bad == 1 else "s"))
    caught = [k for k in sorted(tonight) if tonight[k]]
    # Rule 40a: a pattern that would not compile never ran, so the reader
    # learns that before any verdict — a warning after the headline corrects
    # a sentence already taken in, and "a clean night" may only be said of a
    # night every entry actually scanned.
    broken_fact = ("%d list entr%s would not compile"
                   % (len(broken), "y" if len(broken) == 1 else "ies"))
    if broken and (uses or mentions):
        lines.append("**%s and did not run — the counts below cover only the "
                     "entries that did.**" % broken_fact)
    if uses:
        lines.append("%d use-hit%s across %d entr%s; %d mention%s set aside — "
                     "sentences about the list score apart (rule 47)."
                     % (len(uses), "" if len(uses) == 1 else "s", len(caught),
                        "y" if len(caught) == 1 else "ies", len(mentions),
                        "" if len(mentions) == 1 else "s"))
        lines += ["",
                  "The exercise: step back and say it the right way. Each catch is",
                  "quoted, then said again. Nothing was gated and nothing was edited —",
                  "the day already happened."]
    elif mentions:
        lines.append("No uses — but %d mention%s of the list itself; see below."
                     % (len(mentions), "" if len(mentions) == 1 else "s"))
    elif broken:
        lines.append("Nothing caught among the entries that ran — %s."
                     % broken_fact)
    else:
        lines.append("Nothing caught — a clean night.")
    for warn in broken:
        lines.append("")
        lines.append("**One list entry would not compile and was skipped: %s**" % warn)
    if note:
        lines += ["", "*%s.*" % note]

    # The move, not the wording — rule 46. Rates carry the night's words so
    # a loud day and a quiet day sit on the same scale.
    fns = sorted(fn_tonight)
    if fns:
        lines += ["", "## By function, per 1000 spoken words", "",
                  "| function | uses | /1000w | mentions |",
                  "|---|---|---|---|"]
        for fn in fns:
            u, m = fn_tonight[fn][0], fn_tonight[fn][1]
            rate = "%.2f" % (u * 1000.0 / words) if words else "—"
            lines.append("| %s | %d | %s | %d |" % (fn, u, rate, m))
        nights = sorted({d for row in fn_history.values() for d in row})[-7:]
        if len(nights) > 1:
            lines += ["", "Uses per 1000 words, night over night:", "",
                      "| function | " + " | ".join(nights) + " |",
                      "|---" * (len(nights) + 1) + "|"]
            for fn in sorted(fn_history):
                cells = []
                for d in nights:
                    u, _m, w = fn_history[fn].get(d, (0, 0, 0))
                    cells.append("%.2f" % (u * 1000.0 / w) if w else "")
                lines.append("| %s | %s |" % (fn, " | ".join(cells)))

    watch = substitution_watch(day, phrases, history)
    if watch:
        lines += ["", "## The substitution watch", ""]
        lines += ["- %s" % w for w in watch]
    drift = tic_drift(day, phrases, turns)
    if drift:
        lines += ["", "## The cure shaping the voice (rule 54)", "",
                  "Phrasings the repairs put IN and never took out:", ""]
        lines += ["- %s" % d for d in drift]
    if corr:
        lines += ["", "## Mid-turn substitutions — the live mirror, corroborated", "",
                  "A hold that was answered mid-turn, where the reply that went",
                  "out still performs the same move (rule 49):", ""]
        lines += ["- %s" % c for c in corr]

    if mentions:
        lines += ["", "## Talking about the list", "",
                  "%d mention%s (%.2f per 1000 words): the words quoted or "
                  "discussed, not said. Not scored — but talking about the "
                  "drift instead of not drifting is its own habit, so here "
                  "they are." % (len(mentions),
                                 "" if len(mentions) == 1 else "s",
                                 len(mentions) * 1000.0 / words if words else 0)]
        seen = set()
        for h in mentions:
            if h["sentence"] in seen:
                continue
            seen.add(h["sentence"])
            if len(seen) > 12:
                lines.append("- *(and %d more)*" % (len(mentions) - 12))
                break
            lines.append("- **%s (%s)** — “%s”" % (h["time"], h["kind"],
                                                   h["sentence"]))

    by_key = {}
    for h in uses:
        by_key.setdefault(h["key"], []).append(h)
    titles = {p["key"]: p for p in phrases}
    for key in sorted(by_key):
        p = titles[key]
        lines += ["", "## %s" % p["title"], ""]
        if p["why"]:
            lines += ["Why it is on the list: %s" % p["why"], ""]
        lines += ["Filed under **%s**; the fix is %s." % (
            p["function"],
            "deletion — just say the sentence" if p["fix"] == "delete"
            else "a different sentence"), ""]
        for h in by_key[key]:
            lines.append("- **%s (%s)** — “%s”" % (h["time"], h["kind"], h["sentence"]))
            rw = rewrites.get(h["sentence"])
            if rw and h["sentence"] in substituted:
                lines.append("  - proposed “%s” — **a miss, not a fix**: still "
                             "the %s move (fires %s). Deletion, or a different "
                             "sentence." % (rw, h["function"],
                                            substituted[h["sentence"]]))
            elif rw and p["fix"] == "delete":
                lines.append("  - instead (deletion): “%s”" % rw)
            elif rw:
                lines.append("  - instead: “%s”" % rw)
            elif os.environ.get("CLAUDISM_REWRITES", "1") != "0":
                lines.append("  - *(no rewrite tonight)*")

    nights = sorted({d for counts in history.values() for d in counts})
    recent = nights[-7:]
    lines += ["", "## The count, night over night — uses only", "",
              "| phrase | " + " | ".join(recent) + " | all nights |",
              "|---" * (len(recent) + 2) + "|"]
    for key in sorted(history):
        row = history[key]
        cells = [str(row.get(d, "")) for d in recent]
        lines.append("| %s | %s | %d |" % (key, " | ".join(cells), sum(row.values())))
    totals = [sum(history[k].get(d, 0) for k in history) for d in recent]
    lines.append("")
    lines.append("Totals: " + ", ".join("%s %d" % (d, t) for d, t in zip(recent, totals)) + ".")

    path = os.path.join(OUT_DIR, day + ".md")
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    return path


def crab(*args):
    """The CLI door, for the write declaration and the wake. A miss is loud on
    stderr and never fatal — the report itself must not be lost to a booking."""
    try:
        subprocess.run([CRAB] + list(args), check=True, capture_output=True,
                       text=True, timeout=120)
        return True
    except Exception as e:
        print("claudism-scan: crab %s failed: %s" % (args[0], e), file=sys.stderr)
        return False


def cmd_run(day):
    phrases, broken = parse_list(LIST_PATH)
    if not phrases and not broken:
        # No list, no review — an empty habit is not an error (rule 40).
        print("claudism-scan: no phrase list at %s — nothing to review." % LIST_PATH)
        return 0
    turns, bad = read_day(day)
    if turns is None:
        print("claudism-scan: no journal for %s — nothing to review." % day)
        return 0
    classify, guard_note = load_classifier()
    hits, words = scan(turns, phrases, classify)
    uses = [h for h in hits if h["use"] == "use"]
    mentions = [h for h in hits if h["use"] == "mention"]
    rewrites, substituted, note = propose_rewrites(uses, phrases, classify)
    if guard_note:
        note = "; ".join(n for n in (note, guard_note) if n)
    corr = corroborate(day, uses, phrases)

    # Declared before written, so the self-change watcher reads tonight's
    # report as her own hand (specs/nightly.md rules 6 and 45).
    crab("touching", OUT_DIR)
    os.makedirs(OUT_DIR, exist_ok=True)
    tonight, history = update_counts(day, phrases, uses)
    fn_tonight, fn_history = update_functions(day, phrases, hits, words)
    report = write_report(day, turns, bad, phrases, broken, uses, mentions,
                          words, rewrites, substituted, note, corr, tonight,
                          history, fn_tonight, fn_history)

    # Surface it, clean night included. The agenda is awareness, never an
    # instruction, and its text is stable so a re-run of the same night
    # coalesces with the booking already pending instead of stacking one.
    # Rule 40a reaches this sentence too: the agenda takes the same branch as
    # the report's headline, from the same `broken` the parse returned — the
    # words read at half nine may not call a night clean while the report
    # beside them counts an entry that never compiled.
    agenda_broken = ("%d list entr%s would not compile and did not run: %s"
                     % (len(broken), "y" if len(broken) == 1 else "ies",
                        "; ".join(broken)))
    if uses:
        agenda = ("Your nightly claudism review of %s is written, a correction "
                  "beside each catch and the scoring by function: %s. %sThe "
                  "exercise is stepping back and saying it the right way — a "
                  "habit, not a censor. This is awareness, not a task: read it "
                  "when you like, and watch the rates."
                  % (day, report,
                     "%s, so the counts cover only the entries that did run. "
                     % agenda_broken if broken else ""))
    elif broken:
        agenda = ("Your nightly claudism review of %s caught nothing among the "
                  "entries that ran — %s. The report and the running counts: "
                  "%s. This is awareness, not a task."
                  % (day, agenda_broken, report))
    else:
        agenda = ("Your nightly claudism review of %s caught nothing — a clean "
                  "night. The report and the running counts: %s. This is awareness, "
                  "not a task." % (day, report))
    booked = crab("wake-at", "--by", "claudism-review", WAKE_AT, "event", agenda)

    print("claudism-scan: %s — %d replies, %d use-hits, %d mentions; report %s; wake %s."
          % (day, len(turns), len(uses), len(mentions), report,
             "booked for " + WAKE_AT if booked else "NOT booked"))
    return 0


def main():
    args = sys.argv[1:]
    if not args or args[0] != "run" or len(args) > 2:
        sys.stderr.write(__doc__)
        return 2
    day = args[1] if len(args) == 2 else time.strftime(
        "%Y-%m-%d", time.localtime(time.time() - 86400))
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", day):
        sys.stderr.write("claudism-scan: not a date: %s\n" % day)
        return 2
    try:
        return cmd_run(day)
    except Exception:
        import traceback
        traceback.print_exc()
        # A failed review surfaces too (rule 44) — silence is the one failure
        # this feature is not allowed to have.
        crab("wake-at", "--by", "claudism-review", WAKE_AT, "event",
             "Your nightly claudism review of %s did not finish — the scan hit "
             "an error; the night's sleep is unaffected and the log has the "
             "trace. This is awareness, not a task." % day)
        return 1


if __name__ == "__main__":
    sys.exit(main())
