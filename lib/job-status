#!/usr/bin/env python3
"""Status files for DeskCrab's detached background jobs (crab job / crab jobs).

Each job is one small JSON file <id>.json beside its log <id>.log:
    {id, description, started, started_epoch, unit, state,
     pid, pidstart, finished, finished_epoch, exit}
state: running | finished | failed | stopped | died | blocked
       blocked is a run that never began — the CLI refused before any work was
       attempted — and it is deliberately not the same outcome as failed.

    job-status new <dir> <id> <description> <unit>
    job-status set <file> key=value [key=value ...]
    job-status get <file> <key>
    job-status report <dir> [show-finished] [keep-days] [--live] [--failed-since EPOCH]
    job-status since <dir> <epoch>

`set` coerces digit values to ints, treats the value "now" as a timestamp
(writing both <key> and <key>_epoch), and an empty value as "remove the key".

`since` is the state block's delta: how many jobs were dispatched after an
epoch and how many of them ended badly, as one phrase, printing nothing at all
when neither happened. The block leads every list with a count, and a job
dispatched between two turns is exactly the work a later turn must be able to
report without having started it.

`report` prints one line per job — running first, recent finishes last — and
reaps on the way: a file still claiming "running" whose unit is inactive and
whose recorded pid is gone (start time checked, so a recycled pid cannot keep
a dead job looking alive) is rewritten as "died". A SIGKILLed job never gets
to record its own outcome, and vanishing without trace is exactly what the
status files exist to prevent. Stdlib only, like serve.py — this must run on
an offline machine with nothing installed.
"""

import json
import os
import subprocess
import sys
import time


def write(path, data):
    # Atomic: a concurrent reader or reaper never sees a half-written file.
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def proc_starttime(pid):
    """Boot-relative start time of a pid (field 22 of /proc/PID/stat), or 0."""
    try:
        with open("/proc/%d/stat" % pid) as f:
            return int(f.read().rsplit(") ", 1)[1].split()[19])
    except (OSError, ValueError, IndexError):
        return 0


def alive(job):
    """Is a job that claims to be running actually still running?"""
    if job.get("unit"):
        r = subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", job["unit"]],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if r.returncode == 0:
            return True
    # Once the worker has recorded its own pid, that pid is the authority: a
    # matching start time means alive, anything else means dead right now.
    pid = job.get("pid")
    if pid:
        return proc_starttime(pid) == job.get("pidstart", -1) != 0
    # Launched moments ago: the unit may not be up yet and the worker may not
    # have recorded its pid. Give it a minute before declaring it dead.
    return time.time() - job.get("started_epoch", 0) < 60


def fmt_dur(secs):
    secs = max(0, int(secs))
    if secs < 100:
        return "%ds" % secs
    if secs < 6000:
        return "%dm" % round(secs / 60)
    return "%dh%02dm" % (secs // 3600, secs % 3600 // 60)


def one_line(desc, limit=140):
    desc = " ".join(str(desc).split())
    return desc if len(desc) <= limit else desc[:limit - 1] + "…"


def cmd_new(argv):
    d, jid, desc, unit = argv
    os.makedirs(d, exist_ok=True)
    now = time.time()
    write(os.path.join(d, jid + ".json"), {
        "id": jid,
        "description": desc,
        "started": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(now)),
        "started_epoch": int(now),
        "unit": unit,
        "state": "running",
    })


def cmd_set(argv):
    path, pairs = argv[0], argv[1:]
    with open(path) as f:
        data = json.load(f)
    for p in pairs:
        k, _, v = p.partition("=")
        if v == "now":
            data[k] = time.strftime("%Y-%m-%d %H:%M:%S")
            data[k + "_epoch"] = int(time.time())
        elif v == "":
            data.pop(k, None)
        elif v.lstrip("-").isdigit():
            data[k] = int(v)
        else:
            data[k] = v
    write(path, data)


def cmd_get(argv):
    path, key = argv
    with open(path) as f:
        print(json.load(f).get(key, ""))


def cmd_report(argv):
    # Flags may follow the positional args: --live (running work only, the
    # prompt's copy) and --failed-since EPOCH (plus any job that ended badly
    # after EPOCH, so a death that nobody has been told about yet still gets
    # said once).
    live = "--live" in argv
    failed_since = None
    if "--failed-since" in argv:
        i = argv.index("--failed-since")
        try:
            failed_since = int(argv[i + 1])
        except (IndexError, ValueError):
            failed_since = None
    positional = []
    for a in argv:
        if a.startswith("--"):
            break
        positional.append(a)
    argv = positional
    d = argv[0]
    show = int(argv[1]) if len(argv) > 1 else 6
    keep_days = int(argv[2]) if len(argv) > 2 else 14
    jobs = []
    if os.path.isdir(d):
        for name in sorted(os.listdir(d)):
            if not name.endswith(".json"):
                continue
            path = os.path.join(d, name)
            try:
                with open(path) as f:
                    job = json.load(f)
            except (OSError, ValueError):
                continue
            job["_path"] = path
            jobs.append(job)
    now = time.time()

    for job in jobs:
        if job.get("state") == "running" and not alive(job):
            path = job.pop("_path")
            job["state"] = "died"
            job["finished"] = time.strftime("%Y-%m-%d %H:%M:%S")
            job["finished_epoch"] = int(now)
            write(path, job)
            job["_path"] = path

    # Finished records are a memory aid, not an archive.
    for job in jobs[:]:
        done_at = job.get("finished_epoch", job.get("started_epoch", now))
        if job.get("state") != "running" and now - done_at > keep_days * 86400:
            for ext in (".json", ".log"):
                try:
                    os.unlink(job["_path"][:-len(".json")] + ext)
                except OSError:
                    pass
            jobs.remove(job)

    jobs.sort(key=lambda j: j.get("started_epoch", 0))
    running = [j for j in jobs if j.get("state") == "running"]
    done = [j for j in jobs if j.get("state") != "running"][-show:]

    if live:
        lines = ["  - running (%s so far)  %s — %s" % (
            fmt_dur(now - j.get("started_epoch", now)),
            j.get("id", "?"), one_line(j.get("description", ""), 100))
            for j in running]
        if not lines:
            lines.append("  (none running)")
        if failed_since is not None:
            # News, once. Capped: a night in which five builders hit the same
            # wall is one thing to look at, not five lines of prompt.
            fresh = [j for j in jobs
                     if j.get("state") in ("failed", "died", "blocked", "stopped")
                     and j.get("finished_epoch", 0) >= failed_since]
            for j in fresh[:3]:
                state = j.get("state")
                if state == "blocked":
                    state = "blocked (never ran)"
                elif state == "failed":
                    state = "failed (exit %s)" % j.get("exit", "?")
                lines.append("  - ENDED SINCE YOUR LAST TURN: %s  %s — %s" % (
                    state, j.get("id", "?"), one_line(j.get("description", ""), 90)))
        print("\n".join(lines))
        return

    lines = []
    for j in running:
        lines.append("  - running (%s so far)  %s — %s" % (
            fmt_dur(now - j.get("started_epoch", now)),
            j.get("id", "?"), one_line(j.get("description", ""))))
    for j in done:
        ran = ""
        if j.get("finished_epoch") and j.get("started_epoch"):
            ran = ", ran " + fmt_dur(j["finished_epoch"] - j["started_epoch"])
        state = j.get("state", "?")
        if state == "failed":
            state = "failed (exit %s)" % j.get("exit", "?")
        elif state == "blocked":
            # Never began — no attempt, nothing in the log worth reading.
            state = "blocked (never ran)"
        lines.append("  - %s %s%s  %s — %s" % (
            state, (j.get("finished") or "?")[:16], ran,
            j.get("id", "?"), one_line(j.get("description", ""))))
    print("\n".join(lines) if lines else "  (none)")


def cmd_since(argv):
    """Dispatched and badly-ended counts since an epoch, as one phrase."""
    d = argv[0]
    try:
        cut = int(argv[1])
    except (IndexError, ValueError):
        return
    started = ended = 0
    if os.path.isdir(d):
        for name in sorted(os.listdir(d)):
            if not name.endswith(".json"):
                continue
            try:
                with open(os.path.join(d, name)) as f:
                    job = json.load(f)
            except (OSError, ValueError):
                continue
            if job.get("started_epoch", 0) >= cut:
                started += 1
            if (job.get("state") in ("failed", "died", "blocked", "stopped")
                    and job.get("finished_epoch", 0) >= cut):
                ended += 1
    parts = []
    if started:
        parts.append("%d job%s dispatched" % (started, "" if started == 1 else "s"))
    if ended:
        parts.append("%d ended badly" % ended)
    if parts:
        print(", ".join(parts))


def main():
    cmds = {"new": cmd_new, "set": cmd_set, "get": cmd_get,
            "report": cmd_report, "since": cmd_since}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        sys.exit(__doc__.strip())
    try:
        cmds[sys.argv[1]](sys.argv[2:])
    except (OSError, ValueError) as e:
        print("job-status: %s" % e, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
