HERE = os.path.dirname(os.path.abspath(__file__))


def data_dir():
    d = os.environ.get("DESKCRAB_WATCHALONG_DIR")
    if d:
        return d
    xdg = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return os.path.join(xdg, "deskcrab", "watchalong")


FFMPEG = os.environ.get("DESKCRAB_FFMPEG") or "ffmpeg"
FFPROBE = os.environ.get("DESKCRAB_FFPROBE") or "ffprobe"
WHISPER = os.environ.get("DESKCRAB_WHISPER_CLI") or "whisper-cli"
WHISPER_MODEL = os.environ.get("WATCHALONG_WHISPER_MODEL") or \
    "/usr/share/whisper.cpp-model-small.en/ggml-small.en.bin"
MONTAGE = os.environ.get("DESKCRAB_MONTAGE") or "montage"
CLAUDE_BIN = os.environ.get("CLAUDE_BIN") or "claude"
REVIEW_MODEL = os.environ.get("WATCHALONG_REVIEW_MODEL") or "haiku"
LAG_OK = float(os.environ.get("WATCHALONG_LAG_OK") or 30)
STALE_LEAD = float(os.environ.get("WATCHALONG_STALE_LEAD") or 60)
SAFETY = float(os.environ.get("WATCHALONG_SAFETY") or 2)
POLL = float(os.environ.get("WATCHALONG_POLL") or 1.0)
SEEK_THRESHOLD = float(os.environ.get("WATCHALONG_SEEK_THRESHOLD") or 2.0)
LOST_BACKOFF_MAX = 5.0
DEFAULT_TTL = int(os.environ.get("WATCHALONG_DEFAULT_TTL") or 4 * 3600)
PREROLL = 1.5
ACTIVE = "ACTIVE"


class Refused(Exception):
    pass


# ---------------------------------------------------------------- clocks

def mono():
    f = os.environ.get("WATCHALONG_CLOCK_FILE")
    if f:
        with open(f, encoding="utf-8") as fh:
            return float(fh.read().strip())
    return time.monotonic()


def wall():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def boot_id():
    try:
        with open("/proc/sys/kernel/random/boot_id", encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return "unknown"


def mmss(x):
    if x is None:
        return "?"
    x = max(0.0, float(x))
    m = int(x // 60)
    return "%02d:%04.1f" % (m, x - 60 * m)


# ---------------------------------------------------------------- files

def canonical(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def sha256_bytes(b):
    return hashlib.sha256(b).hexdigest()


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def write_once(path, obj):
    """Immutable record: created with O_EXCL, never rewritten."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(json.dumps(obj, indent=1, ensure_ascii=False))
        fh.write("\n")


def write_atomic(path, obj):
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(json.dumps(obj, indent=1, ensure_ascii=False))
        fh.write("\n")
    os.replace(tmp, path)


def read_json(path):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)


# ---------------------------------------------------------------- session

def sessions_dir():
    return os.path.join(data_dir(), "sessions")


def session_dir(sid):
    return os.path.join(sessions_dir(), sid)


def current_pointer():
    return os.path.join(data_dir(), "current")


def current_id():
    try:
        with open(current_pointer(), encoding="utf-8") as fh:
            sid = fh.read().strip()
    except OSError:
        return None
    if not sid or "/" in sid or ".." in sid:
        return None
    return sid


def load_session(sid):
    try:
        return read_json(os.path.join(session_dir(sid), "session.json"))
    except (OSError, ValueError):
        return None


def save_session(s):
    write_atomic(os.path.join(session_dir(s["id"]), "session.json"), s)


@contextlib.contextmanager
def session_lock(sid):
    """Every read-modify-write of session.json happens under this lock: the
    observer files anchors from one process while a hand may stop the session
    from another, and the later writer must not resurrect what the earlier one
    wrote. flock on a file beside the record, released with the descriptor."""
    path = os.path.join(session_dir(sid), ".lock")
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


@contextlib.contextmanager
def locked_session(sid, require=True):
    """Load the session under its lock, hand it out, save it on the way out.
    With require, a session that is not active raises Refused inside the lock,
    so a stop that landed a moment ago is seen and nothing is written over it."""
    with session_lock(sid):
        s = load_session(sid)
        if s is None:
            raise Refused("no viewing session %s" % sid)
        if require and session_state(s) != ACTIVE:
            raise Refused("no active viewing session (%s)" % session_state(s))
        yield s
        save_session(s)


def session_state(s):
    """The permission as it stands right now. Rules 2, 3, 5."""
    if s is None:
        return "INACTIVE"
    if s.get("state") == "stopped":
        return "STOPPED"
    if s.get("boot_id") != boot_id():
        # The monotonic basis of the anchor and the expiry died with the boot.
        return "EXPIRED"
    if mono() > float(s.get("expires_mono", 0)):
        return "EXPIRED"
    return ACTIVE


def active_session():
    sid = current_id()
    if not sid:
        return None, "INACTIVE"
    s = load_session(sid)
    if s is None:
        return None, "INACTIVE"
    return s, session_state(s)


def require_active():
    s, state = active_session()
    if state != ACTIVE:
        raise Refused("no active viewing session (%s)" % state)
    return s


def telemetry_reading(s):
    """The player's last reading, when it belongs to this epoch and the player
    has been seen (connected, or lost since). None when the estimate must come
    from the anchor alone: no player, waiting for one, or on the wrong file."""
    t = s.get("telemetry") or {}
    if t.get("observed_mono") is None or t.get("epoch") != s.get("epoch"):
        return None
    if t.get("state") not in ("connected", "lost"):
        return None
    return t


def estimate(s):
    """Rule 6: the anchor plus elapsed time while playing. Rule 8d: with a
    player reading in this epoch, the reading plus elapsed time at the player's
    rate — the anchor opened the epoch, the readings refine the number without
    opening another. A status change or a jump beyond the threshold is an
    anchor, never a refinement."""
    t = telemetry_reading(s)
    if t is not None:
        if t.get("playing"):
            return float(t["position"]) + float(t.get("rate") or 1.0) * max(0.0, mono() - float(t["observed_mono"]))
        return float(t["position"])
    a = s["anchor"]
    if a["playing"]:
        return float(a["position"]) + max(0.0, mono() - float(a["set_mono"]))
    return float(a["position"])


def probe_duration(path):
    try:
        out = subprocess.run(
            [FFPROBE, "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", path],
            capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
        if out.returncode == 0 and out.stdout.strip():
            return float(out.stdout.strip().splitlines()[0])
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return None


def new_anchor(position, playing, basis, quote, set_mono=None):
    if basis not in ("user-stated", "player-telemetry"):
        raise Refused("anchor basis must be user-stated or player-telemetry")
    if not math.isfinite(position) or position < 0:
        raise Refused("anchor position must be a finite non-negative number of seconds")
    return {
        "position": float(position),
        "playing": bool(playing),
        "basis": basis,
        "quote": quote or "",
        "set_mono": mono() if set_mono is None else float(set_mono),
        "set_wall": wall(),
    }


def set_anchor(s, anchor):
    dur = s["source"].get("duration")
    if dur is not None and anchor["position"] > dur + 0.5:
        raise Refused("position %.1f is past the source's %.1f-second end" % (anchor["position"], dur))
    s["epoch"] = int(s.get("epoch", 0)) + 1
    s["anchor"] = anchor
    s.setdefault("anchors", []).append(dict(anchor, epoch=s["epoch"]))
    save_session(s)
    return s


def cmd_start(a):
    if not a.authorized_by or not a.authorized_by.strip():
        raise Refused("--authorized-by is required: who asked for this viewing, and when")
    if not os.path.isfile(a.source):
        raise Refused("source not found: %s" % a.source)
    existing, state = active_session()
    if state == ACTIVE:
        raise Refused("a viewing session is already active (%s); stop it first" % existing["id"])
    ttl = int(a.ttl if a.ttl is not None else DEFAULT_TTL)
    if ttl <= 0:
        raise Refused("--ttl must be a positive number of seconds")
    sid = "%s-%s" % (datetime.datetime.now().strftime("%Y%m%d-%H%M%S"),
                     "".join(random.choice(string.ascii_lowercase + string.digits) for _ in range(5)))
    src = os.path.abspath(a.source)
    now = mono()
    s = {
        "id": sid,
        "state": "active",
        "title": a.title or os.path.basename(src),
        "authorized_by": a.authorized_by.strip(),
        "started_wall": wall(),
        "started_mono": now,
        "expires_mono": now + ttl,
        "expires_wall": (datetime.datetime.now().astimezone() + datetime.timedelta(seconds=ttl)).isoformat(timespec="seconds"),
        "ttl": ttl,
        "boot_id": boot_id(),
        "source": {
            "path": src,
            "size": os.path.getsize(src),
            "sha256": sha256_file(src),
            "duration": probe_duration(src),
        },
        "epoch": 0,
        "anchor": None,
        "anchors": [],
        "stopped_wall": None,
        "stop_reason": None,
        "reader_unit": None,
        "player": None,
        "telemetry": None,
    }
    if a.player:
        MprisPlayer(a.player)  # the spec is checked before anything is written
        s["player"] = {"spec": a.player, "kind": "mpris",
                       "poll": float(a.poll if a.poll is not None else POLL),
                       "seek_threshold": float(a.seek_threshold if a.seek_threshold is not None else SEEK_THRESHOLD)}
        s["telemetry"] = {"state": "waiting", "since_wall": wall(), "since_mono": now, "readings": 0,
                          "anchors_filed": 0, "last_error": None}
    os.makedirs(os.path.join(session_dir(sid), "packets"), exist_ok=False)
    os.makedirs(os.path.join(session_dir(sid), "receipts"), exist_ok=True)
    anchor = new_anchor(a.position or 0.0, not a.paused, a.basis, a.quote)
    set_anchor(s, anchor)
    with open(current_pointer() + ".tmp", "w", encoding="utf-8") as fh:
        fh.write(sid + "\n")
    os.replace(current_pointer() + ".tmp", current_pointer())
    first = ""
    if a.player:
        # One look at the player before anything else runs, so the session
        # opens on his real position when the player is already there (rule
        # 8b). Not found is not an error: the observer keeps looking.
        st = {"prev": None, "backoff": s["player"]["poll"]}
        notes = []
        try:
            observe_step(MprisPlayer(a.player), st, s["player"]["poll"], s["player"]["seek_threshold"], notes.append)
        except Exception as e:  # the bus may be absent here; the loop will say so
            notes.append("observer: %s" % e)
        s = load_session(sid)
        anchor = s["anchor"]
        first = "; " + (notes[-1] if notes else "player: no reading")
    if a.launch_reader:
        unit = "deskcrab-watchalong-%s" % sid
        env = ["--setenv=%s=%s" % (k, v) for k, v in os.environ.items()
               if k.startswith(("DESKCRAB_", "WATCHALONG_", "XDG_", "CLAUDE_"))
               or k in ("HOME", "PATH", "DBUS_SESSION_BUS_ADDRESS")]
        cmd = ["systemd-run", "--user", "--collect", "--quiet", "--unit", unit] + env + [
            sys.executable, os.path.abspath(__file__), "reader", "--loop",
            "--reviewer", a.launch_reader, "--log", os.path.join(session_dir(sid), "reader.log")]
        r = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        with locked_session(sid) as s:
            s["reader_unit"] = unit if r.returncode == 0 else None
            s["reader_launch"] = {"rc": r.returncode, "err": r.stderr.strip()[:300]}
    print("started %s: %s, authorised by %s, until %s; epoch %d at %s %s (%s)%s%s" % (
        sid, s["title"], s["authorized_by"], s["expires_wall"], s["epoch"],
        mmss(anchor["position"]), "playing" if anchor["playing"] else "paused", anchor["basis"], first,
        ("; reader unit %s" % s["reader_unit"]) if s.get("reader_unit") else
        ("; reader launch FAILED rc=%s %s" % (s["reader_launch"]["rc"], s["reader_launch"]["err"])) if a.launch_reader else ""))


def cmd_anchor(a, mode=None):
    sid = require_active()["id"]
    with locked_session(sid) as s:
        cur = s["anchor"]
        if mode == "pause":
            pos = a.position if a.position is not None else estimate(s)
            playing = False
        elif mode == "resume":
            pos = a.position if a.position is not None else cur["position"]
            playing = True
        else:
            if a.position is None:
                raise Refused("anchor needs --position")
            pos = a.position
            playing = not a.paused if (a.paused or a.playing) else cur["playing"]
        anchor = new_anchor(float(pos), playing, a.basis, a.quote)
        set_anchor(s, anchor)
    print("epoch %d: %s at %s (%s%s)" % (
        s["epoch"], "playing" if playing else "paused", mmss(pos), anchor["basis"],
        (", %r" % anchor["quote"]) if anchor["quote"] else ""))


def cmd_stop(a):
    s, state = active_session()
    if s is None:
        print("no viewing session")
        return
    if s.get("state") == "stopped":
        print("already stopped: %s" % s["id"])
    else:
        with locked_session(s["id"], require=False) as s:
            s["state"] = "stopped"
            s["stopped_wall"] = wall()
            s["stopped_mono"] = mono()
            s["stop_reason"] = a.reason or ""
        if s.get("reader_unit"):
            subprocess.run(["systemctl", "--user", "stop", s["reader_unit"]],
                           capture_output=True, stdin=subprocess.DEVNULL)
        print("stopped %s%s" % (s["id"], (": " + a.reason) if a.reason else ""))
    try:
        os.unlink(current_pointer())
    except OSError:
        pass


# ---------------------------------------------------------------- packets

def packets_dir(s):
    return os.path.join(session_dir(s["id"]), "packets")


def receipts_dir(s):
    return os.path.join(session_dir(s["id"]), "receipts")


def load_packets(s):
    out = []
    d = packets_dir(s)
    for name in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        if name.endswith(".json"):
            try:
                out.append(read_json(os.path.join(d, name)))
            except (OSError, ValueError):
                continue
    return out


def load_receipts(s):
    out = []
    d = receipts_dir(s)
    for name in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        if name.endswith(".json"):
            try:
                out.append(read_json(os.path.join(d, name)))
            except (OSError, ValueError):
                continue
    return out


def packet_hash(p):
    body = {k: v for k, v in p.items() if k != "hash"}
    return sha256_bytes(canonical(body).encode("utf-8"))


def packet_state(p, s, receipts_by_id):
    if p["epoch"] != s["epoch"]:
        return "superseded"
    if not p.get("ok"):
        return "failed"
    if p["id"] in receipts_by_id:
        return "reviewed"
    return "pending"


def extraction_cursor(s, packets):
    """Where the next cut begins: after the last well-cut packet of this epoch."""
    pos = float(s["anchor"]["position"])
    for p in packets:
        if p["epoch"] == s["epoch"] and p.get("ok"):
            pos = max(pos, float(p["interval"]["end"]))
    return pos


def run(cmd, timeout):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                          stdin=subprocess.DEVNULL)


def extract_frames(src, start, end, step, pdir):
    sel = "select='isnan(prev_selected_t)+gte(t-prev_selected_t\\,%s)',showinfo" % ("%.3f" % (step - 0.02))
    pattern = os.path.join(pdir, "raw%03d.png")
    r = run([FFMPEG, "-nostdin", "-hide_banner", "-v", "info",
             "-ss", "%.3f" % start, "-t", "%.3f" % (end - start), "-copyts", "-i", src,
             "-vf", sel, "-fps_mode", "vfr", "-f", "image2", pattern], timeout=300)
    if r.returncode != 0:
        raise RuntimeError("ffmpeg frames rc=%d: %s" % (r.returncode, r.stderr.strip()[-400:]))
    pts = [float(m) for m in re.findall(r"pts_time:\s*(-?[0-9.]+)", r.stderr)]
    files = sorted(f for f in os.listdir(pdir) if f.startswith("raw") and f.endswith(".png"))
    if len(files) != len(pts):
        raise RuntimeError("showinfo reported %d frames but %d files were written" % (len(pts), len(files)))
    frames = []
    for f, t in zip(files, pts):
        name = "%02dm%04.1fs.png" % (int(t // 60), t - 60 * int(t // 60))
        os.replace(os.path.join(pdir, f), os.path.join(pdir, name))
        frames.append({"pts": t, "file": name, "sha256": sha256_file(os.path.join(pdir, name))})
    return frames


def make_sheet(pdir, frames):
    if not frames:
        return None
    files = [os.path.join(pdir, f["file"]) for f in frames]
    out = os.path.join(pdir, "sheet.jpg")
    r = run([MONTAGE, "-label", "%t"] + files + [
        "-tile", "4x", "-geometry", "+4+4", "-background", "#222", "-fill", "white",
        "-pointsize", "14", out], timeout=120)
    if r.returncode != 0 or not os.path.isfile(out):
        return {"status": "failed", "error": r.stderr.strip()[-300:]}
    return {"file": "sheet.jpg", "sha256": sha256_file(out), "status": "ok"}


def transcribe(src, start, end, pdir):
    a0 = max(0.0, start - PREROLL)
    wav = os.path.join(pdir, "audio.wav")
    rec = {
        "engine": "whisper-cli",
        "model": WHISPER_MODEL,
        "audio_interval": {"start": a0, "end": end, "preroll": start - a0},
        "modality": "machine transcript of decoded audio; not heard",
        "segments": [],
        "status": "failed",
        "error": None,
        "file": None,
    }
    r = run([FFMPEG, "-nostdin", "-hide_banner", "-v", "error", "-ss", "%.3f" % a0,
             "-t", "%.3f" % (end - a0), "-i", src, "-vn", "-ac", "1", "-ar", "16000",
             "-f", "wav", "-y", wav], timeout=300)
    if r.returncode != 0 or not os.path.isfile(wav):
        rec["error"] = "audio decode failed rc=%d: %s" % (r.returncode, r.stderr.strip()[-300:])
        return rec
    rec["audio_sha256"] = sha256_file(wav)
    if not os.path.isfile(WHISPER_MODEL):
        rec["error"] = "whisper model not found: %s" % WHISPER_MODEL
        return rec
    prefix = os.path.join(pdir, "transcript")
    try:
        w = run([WHISPER, "-m", WHISPER_MODEL, "-f", wav, "-l", "en", "-t", "4",
                 "-oj", "-of", prefix, "-np"], timeout=600)
    except subprocess.TimeoutExpired:
        rec["error"] = "whisper-cli timed out"
        return rec
    jpath = prefix + ".json"
    if w.returncode != 0 or not os.path.isfile(jpath):
        rec["error"] = "whisper-cli rc=%d: %s" % (w.returncode, (w.stderr or w.stdout).strip()[-300:])
        return rec
    try:
        data = read_json(jpath)
    except ValueError as e:
        rec["error"] = "whisper json unreadable: %s" % e
        return rec
    segs = []
    for item in data.get("transcription", []):
        off = item.get("offsets", {})
        text = (item.get("text") or "").strip()
        if not text:
            continue
        segs.append({
            "start": a0 + float(off.get("from", 0)) / 1000.0,
            "end": a0 + float(off.get("to", 0)) / 1000.0,
            "text": text,
        })
    rec["segments"] = segs
    rec["file"] = "transcript.json"
    rec["sha256"] = sha256_file(jpath)
    rec["status"] = "ok" if segs else "empty"
    rec["error"] = None
    return rec


def extract(s, start, end, step):
    packets = load_packets(s)
    seq = len(packets) + 1
    pid = "e%03d-%04d-%07.1f-%07.1f" % (s["epoch"], seq, start, end)
    pdir = os.path.join(packets_dir(s), pid)
    os.makedirs(pdir, exist_ok=False)
    est = estimate(s)
    p = {
        "id": pid,
        "session": s["id"],
        "epoch": s["epoch"],
        "source": dict(s["source"]),
        "interval": {"start": float(start), "end": float(end), "step": float(step)},
        "frames": [],
        "sheet": None,
        "transcript": None,
        "extracted_wall": wall(),
        "extracted_mono": mono(),
        "estimate_at_extraction": est,
        "extraction_delay": est - float(end),
        "ok": False,
        "error": None,
        "modalities": ["sampled frames with decoder timestamps",
                       "machine transcript of decoded audio; not heard"],
    }
    try:
        p["frames"] = extract_frames(s["source"]["path"], start, end, step, pdir)
        if not p["frames"]:
            raise RuntimeError("no frames decoded in %s-%s" % (mmss(start), mmss(end)))
        p["sheet"] = make_sheet(pdir, p["frames"])
        p["ok"] = True
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
        p["error"] = str(e)[:500]
    p["transcript"] = transcribe(s["source"]["path"], start, end, pdir)
    p["hash"] = packet_hash(p)
    write_once(os.path.join(packets_dir(s), pid + ".json"), p)
    return p


def choose_interval(s, packets, min_s, max_s):
    est = estimate(s)
    cursor = extraction_cursor(s, packets)
    limit = est - SAFETY
    if limit - cursor < min_s:
        return None
    return cursor, min(limit, cursor + max_s)


def cmd_extract(a):
    s = require_active()
    packets = load_packets(s)
    iv = choose_interval(s, packets, a.min, a.max)
    if iv is None:
        print("nothing new: estimate %s, cursor %s, need %.0f s" % (
            mmss(estimate(s)), mmss(extraction_cursor(s, packets)), a.min))
        sys.exit(3)
    p = extract(s, iv[0], iv[1], a.step)
    print("%s %s: %d frames, transcript %s, delay %.1f s%s" % (
        p["id"], "ok" if p["ok"] else "FAILED", len(p["frames"]),
        p["transcript"]["status"], p["extraction_delay"],
        (" — " + p["error"]) if p["error"] else ""))


# ---------------------------------------------------------------- receipts

def verify_packet_integrity(s, p):
    if packet_hash(p) != p.get("hash"):
        raise Refused("packet integrity: stored hash does not match its content")
    pdir = os.path.join(packets_dir(s), p["id"])
    for f in p.get("frames", []):
        path = os.path.join(pdir, f["file"])
        if not os.path.isfile(path):
            raise Refused("packet integrity: frame %s is missing" % f["file"])
        if sha256_file(path) != f["sha256"]:
            raise Refused("packet integrity: frame %s does not match its recorded hash" % f["file"])
    sheet = p.get("sheet") or {}
    if sheet.get("status") == "ok":
        path = os.path.join(pdir, sheet["file"])
        if not os.path.isfile(path) or sha256_file(path) != sheet["sha256"]:
            raise Refused("packet integrity: the contact sheet is missing or altered")


def review(s, p, reviewer, modalities, observation, frames_looked_at):
    if session_state(s) != ACTIVE:
        raise Refused("no active viewing session")
    if p["session"] != s["id"]:
        raise Refused("source mismatch: packet belongs to another session")
    if p["source"].get("sha256") != s["source"].get("sha256"):
        raise Refused("source mismatch: packet was cut from a different source")
    if p["epoch"] != s["epoch"]:
        raise Refused("stale epoch: packet is from epoch %d, the session is at %d" % (p["epoch"], s["epoch"]))
    verify_packet_integrity(s, p)
    if not p.get("ok"):
        raise Refused("packet failed extraction: %s" % p.get("error"))
    est = estimate(s)
    if float(p["interval"]["end"]) > est + 0.5:
        raise Refused("ahead: packet ends at %s but the estimate is %s; those seconds have not been shown" % (
            mmss(p["interval"]["end"]), mmss(est)))
    if not observation or not observation.strip():
        raise Refused("empty observation")
    rpath = os.path.join(receipts_dir(s), p["id"] + ".json")
    if os.path.exists(rpath):
        raise Refused("already reviewed: one receipt per packet")
    kind, _, name = reviewer.partition(":")
    if kind not in ("fixture-decoder", "model", "hand"):
        raise Refused("reviewer must be fixture-decoder, model:<model> or hand:<name>")
    r = {
        "packet_id": p["id"],
        "packet_hash": p["hash"],
        "session": s["id"],
        "epoch": p["epoch"],
        "source_sha256": p["source"]["sha256"],
        "interval": dict(p["interval"]),
        "frame_pts": [f["pts"] for f in p["frames"]],
        "frames_looked_at": frames_looked_at or [f["pts"] for f in p["frames"]],
        "reviewer": kind,
        "reviewer_name": name,
        "modalities": modalities or list(p.get("modalities", [])),
        "observation": observation.strip(),
        "transcript_status": (p.get("transcript") or {}).get("status"),
        "reviewed_wall": wall(),
        "reviewed_mono": mono(),
        "estimate_at_review": est,
        "lag_at_review": est - float(p["interval"]["end"]),
        "extraction_delay": p.get("extraction_delay"),
        "assertion": "the reader's own assertion that it looked; not proof of cognition",
    }
    r["hash"] = sha256_bytes(canonical({k: v for k, v in r.items() if k != "hash"}).encode("utf-8"))
    write_once(rpath, r)
    return r


def find_packet(s, pid):
    path = os.path.join(packets_dir(s), pid + ".json")
    if not os.path.isfile(path):
        raise Refused("no packet %s" % pid)
    return read_json(path)


def cmd_review(a):
    s, state = active_session()
    if state != ACTIVE:
        raise Refused("no active viewing session (%s)" % state)
    p = find_packet(s, a.packet)
    looked = [float(x) for x in a.frames_looked_at.split(",")] if a.frames_looked_at else None
    r = review(s, p, a.reviewer, a.modality, a.observation, looked)
    print("receipt %s: %s %s-%s by %s, lag %.1f s" % (
        r["hash"][:12], r["packet_id"], mmss(r["interval"]["start"]), mmss(r["interval"]["end"]),
        r["reviewer"] + ((":" + r["reviewer_name"]) if r["reviewer_name"] else ""), r["lag_at_review"]))


# ---------------------------------------------------------------- status

def compute(s, state):
    out = {"state": state, "session": None}
    if s is None:
        return out
    est = estimate(s) if state == ACTIVE else None
    a = s["anchor"]
    receipts = load_receipts(s)
    packets = load_packets(s)
    by_id = {r["packet_id"]: r for r in receipts}
    this = sorted((r for r in receipts if r["epoch"] == s["epoch"]), key=lambda r: r["interval"]["start"])
    cursor = max((float(r["interval"]["end"]) for r in this), default=None)
    gaps = []
    pos = float(a["position"])
    for r in this:
        st, en = float(r["interval"]["start"]), float(r["interval"]["end"])
        if st > pos + 0.05:
            gaps.append([pos, st])
        pos = max(pos, en)
    latest = max(this, key=lambda r: r["reviewed_mono"]) if this else None
    lag = None
    if est is not None:
        lag = est - (cursor if cursor is not None else float(a["position"]))
    word = state
    if state == ACTIVE:
        if not this:
            word = "UNOBSERVED"
        else:
            word = "CURRENT" if lag <= LAG_OK else "LAGGING"
    pstates = {}
    for p in packets:
        pstates[packet_state(p, s, by_id)] = pstates.get(packet_state(p, s, by_id), 0) + 1
    earlier = [r for r in receipts if r["epoch"] != s["epoch"]]
    earlier_last = max(earlier, key=lambda r: r["reviewed_mono"]) if earlier else None
    out.update({
        "session": s["id"],
        "title": s["title"],
        "authorized_by": s["authorized_by"],
        "expires_wall": s["expires_wall"],
        "epoch": s["epoch"],
        "anchor": a,
        "estimate": est,
        "playing": bool(a["playing"]),
        "word": word,
        "lag": lag,
        "reviewed_cursor": cursor,
        "reviewed_intervals": [[float(r["interval"]["start"]), float(r["interval"]["end"])] for r in this],
        "gaps": gaps,
        "ahead": bool(est is not None and any(float(r["interval"]["end"]) > est + 0.5 for r in this)),
        "stale_latest": bool(latest and (latest.get("extraction_delay") or 0) > STALE_LEAD),
        "latest_receipt_age": (mono() - latest["reviewed_mono"]) if latest else None,
        "receipts_this_epoch": len(this),
        "receipts_earlier": len(earlier),
        "earlier_last": ([float(earlier_last["interval"]["start"]), float(earlier_last["interval"]["end"])]
                         if earlier_last else None),
        "packets": pstates,
        "extraction_cursor": extraction_cursor(s, packets) if state == ACTIVE else None,
        "latest": latest,
        "previous": (sorted(this, key=lambda r: r["reviewed_mono"])[-2] if len(this) >= 2 else None),
        "stop_reason": s.get("stop_reason"),
        "player": s.get("player"),
        "telemetry": s.get("telemetry"),
        "telemetry_age": ((mono() - float(s["telemetry"]["observed_mono"]))
                          if (s.get("telemetry") or {}).get("observed_mono") is not None else None),
        "telemetry_since": ((mono() - float(s["telemetry"]["since_mono"]))
                            if (s.get("telemetry") or {}).get("since_mono") is not None else None),
        "basis": s["anchor"]["basis"],
    })
    return out


def telemetry_line(c):
    """One line on the player, for status and the log."""
    pl = c.get("player")
    if not pl:
        return "player: none (no telemetry; the estimate is his word plus elapsed time)"
    t = c.get("telemetry") or {}
    who = (t.get("player") or {}).get("identity") or (t.get("player") or {}).get("name") or pl["spec"]
    st = t.get("state") or "waiting"
    if st == "connected":
        return "player: CONNECTED %s, %s at %s read %.0f s ago (source %s; %d readings, %d anchors filed)" % (
            who, t.get("status"), mmss(t.get("position")), c.get("telemetry_age") or 0,
            t.get("source_verified"), t.get("readings") or 0, t.get("anchors_filed") or 0)
    if st == "lost":
        return "player: LOST %s since %s (%.0f s): %s; last reading %s at %s" % (
            who, t.get("since_wall"), c.get("telemetry_since") or 0, t.get("last_error") or "-",
            t.get("status"), mmss(t.get("position")))
    if st == "mismatch":
        return "player: MISMATCH %s is on %s, not the source; not followed since %s" % (
            who, t.get("url"), t.get("since_wall"))
    return "player: WAITING for %s since %s (%.0f s): %s" % (
        pl["spec"], t.get("since_wall"), c.get("telemetry_since") or 0, t.get("last_error") or "not looked yet")


def cmd_status(a):
