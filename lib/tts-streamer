#!/usr/bin/env python3
"""Stream TTS from DeskCrab's debug log. Reads stream-json events,
extracts assistant text, and pipes it to piper-tts for speech."""

import fcntl
import json
import subprocess
import time
import os
import re
import signal
import sys

signal.signal(signal.SIGTERM, lambda *a: (_clear_live_speech(), os._exit(0)))

# Speech mutex: hold the flock for the whole TTS stage of this turn, so no
# other session (a wake's speak_once, another streamer) can talk over it.
# Released automatically when this process exits — even via os._exit above.
# Taken LAZILY, at the first thing worth saying — never at startup. Held at
# startup it silently ate whole replies: a wake overlapping a desk turn owns
# the lock, this streamer blocks before it ever reads the stream, and by the
# time the lock frees its parent has gone, the ppid check below fires, and it
# exits having spoken nothing. The reply appeared on screen and was never
# heard. Blocking here instead means the words wait their turn; they are not
# discarded.
_SPEECHLOCK = os.environ.get("DESKCRAB_SPEECHLOCK", "").strip()
_lockfd = None


def hold_speech_lock():
    global _lockfd
    if _SPEECHLOCK and _lockfd is None:
        _lockfd = os.open(_SPEECHLOCK, os.O_CREAT | os.O_WRONLY, 0o644)
        fcntl.flock(_lockfd, fcntl.LOCK_EX)


# Live speech notice: the words currently on the speakers, published so the
# NEXT session of her to start can REGROUP against them — fold what it has to
# say and what is being said into one reply — instead of talking over them or
# dropping its own point. Header line is `epoch \t device \t pid \t until`,
# the text follows from line 2. Mirrors live_speech_begin/end in common.sh.
#
# This publishes; it never edits. No word reaching piper is changed or
# withheld by anything here.
_LIVE_SPEECH = os.environ.get("DESKCRAB_LIVE_SPEECH", "").strip()
_said = []


def _publish_live_speech(text):
    if not _LIVE_SPEECH:
        return
    _said.append(text)
    try:
        tmp = "%s.%d.tmp" % (_LIVE_SPEECH, os.getpid())
        with open(tmp, "w") as fh:
            fh.write("%d\tdesk\t%d\t0\n%s\n" % (time.time(), os.getpid(),
                                                "\n".join(_said)))
        os.replace(tmp, _LIVE_SPEECH)
    except Exception:
        pass


def _clear_live_speech():
    # Only our own notice: a later session may already have taken the floor,
    # and deleting its record would blind whoever starts next.
    if not _LIVE_SPEECH:
        return
    try:
        with open(_LIVE_SPEECH) as fh:
            head = fh.readline().split("\t")
        if len(head) > 2 and head[2] == str(os.getpid()):
            os.unlink(_LIVE_SPEECH)
    except Exception:
        pass

LOG = os.environ["DESKCRAB_DEBUGLOG"]
PIPER = os.environ["DESKCRAB_PIPER_VOICE"]
LENGTH_SCALE = os.environ.get("DESKCRAB_PIPER_LENGTH_SCALE", "").strip()
SPEAKER = os.environ.get("DESKCRAB_PIPER_SPEAKER", "").strip()

# Optional sed expressions (same format as WHISPER_FIXES) applied to spoken
# text only — display content is untouched. Lets users rewrite words piper
# mispronounces or spells out letter-by-letter, e.g. s/\bhmph\b/humph/gi
TTS_FIXES = os.environ.get("DESKCRAB_TTS_FIXES", "").strip()


def fix_pronunciation(text):
    if not TTS_FIXES:
        return text
    try:
        out = subprocess.run(
            ["sed", "-E", TTS_FIXES],
            input=text.encode(), stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL)
        if out.returncode == 0:
            return out.stdout.decode()
    except Exception:
        pass
    return text


def speak(text):
    hold_speech_lock()
    _publish_live_speech(text)
    try:
        cmd = ["piper-tts", "--model", PIPER, "--output-raw"]
        if LENGTH_SCALE:
            cmd += ["--length-scale", LENGTH_SCALE]
        if SPEAKER:
            cmd += ["--speaker", SPEAKER]
        piper = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        aplay = subprocess.Popen(
            ["aplay", "-r", "22050", "-c", "1", "-f", "S16_LE", "-t", "raw"],
            stdin=piper.stdout, stderr=subprocess.DEVNULL)
        piper.stdin.write(text.encode())
        piper.stdin.close()
        aplay.wait()
        piper.wait()
    except Exception:
        pass


# Remember who launched us (the crab process). If it dies we get reparented —
# to PID 1 or, under a systemd user manager, to a subreaper — either way our
# ppid changes. That's our cue to stop, since an orphaned crab can no longer
# append the terminator and we must not tail the log forever.
ORIG_PPID = os.getppid()

while not os.path.exists(LOG):
    time.sleep(0.1)

with open(LOG) as f:
    while True:
        line = f.readline()
        if not line:
            # Backstop: if our launching crab process is gone we've been
            # reparented (ppid changes) — it can no longer append a terminator,
            # so stop instead of tailing the log forever.
            if os.getppid() != ORIG_PPID:
                break
            time.sleep(0.05)
            continue
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        if d.get("type") == "result":
            break
        if d.get("type") == "assistant" and "message" in d:
            for block in d["message"].get("content", []):
                if block.get("type") == "text":
                    text = block["text"].strip()
                    if not text:
                        continue
                    text = text.split("---DISPLAY---")[0].strip()
                    text = re.sub(r"\*+", "", text)
                    text = re.sub(r"\x60[^\x60]*\x60", "", text)
                    text = fix_pronunciation(text)
                    text = text.strip()
                    if not text:
                        continue
                    speak(text)

# The floor is free again — retract the notice so the next session is not told
# to regroup against words that finished a while ago.
_clear_live_speech()
