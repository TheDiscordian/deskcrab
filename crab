        echo "Usage: crab start|stop|status|seal|revive|shutup|face <verb>|face-window|claim <what>|unclaim|touching <paths>|numb [-w secs] <paths>|checkpoint <note>|resolve <name>|job [-C <dir>] [--record <eng-id>] [--want <ref>] <desc>|job log|activity|show|collect|dispatch|drop|requeue|steer <id>|jobs [--state <s>]|eng <new|list|show|touch|review|accept|reject|settle|kill|search> …|want <new|list|show|touch|dormant|revive|grown|retire|link|search|migrate> …|journal [YYYY-MM-DD]|metrics [YYYY-MM-DD|backfill]|context [--profile <p>]|--layers|wake|wake-now <reason>|wake-at <when> [kind] [reason]|wake-cancel <unit>|--all|wake-restore|wake-tidy|serve [port]|openrsc-link [base-url]|remote <text>|notify <text>|play <file>|tired|shelf-check|<message>"
        exit 0
        ;;

    *)
        # Anything else is treated as a text query — but a leading dash is a
        # mistyped flag, not speech; it must never reach the spoken channel.
        if deskcrab_is_builder_context; then
            echo "DeskCrab: detached builder text cannot enter the user conversation. Write the job log/checkpoint or engineering record." >&2
            exit 64
        fi
        TEXT="$*"
        case "$TEXT" in
            -*) echo "Unknown option '$1' — run crab with no arguments for usage."; exit 1 ;;
        esac
        if [ -z "$TEXT" ]; then
            echo "Usage: crab start|stop|status|seal|revive|shutup|face <verb>|face-window|claim <what>|unclaim|touching <paths>|numb [-w secs] <paths>|checkpoint <note>|resolve <name>|job [-C <dir>] [--record <eng-id>] [--want <ref>] <desc>|job log|activity|show|collect|dispatch|drop|requeue|steer <id>|jobs [--state <s>]|eng <new|list|show|touch|review|accept|reject|settle|kill|search> …|want <new|list|show|touch|dormant|revive|grown|retire|link|search|migrate> …|journal [YYYY-MM-DD]|metrics [YYYY-MM-DD|backfill]|context [--profile <p>]|--layers|wake|wake-now <reason>|wake-at <when> [kind] [reason]|wake-cancel <unit>|--all|wake-restore|wake-tidy|serve [port]|openrsc-link [base-url]|remote <text>|notify <text>|play <file>|tired|shelf-check|<message>"
            exit 1
        fi
        stop_tts
        rotate_convo
        run_claude_and_respond "$TEXT"
        ;;
esac
