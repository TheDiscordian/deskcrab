#!/bin/bash
# DeskCrab: push-to-talk desktop assistant powered by Claude
# Usage: crab start | stop | status | tired | shutup | face <verb> | play <file> | job <desc> | jobs | memory <verb> | conduct <verb> | eng <verb> | want <verb> | wake | wake-at <when> | wake-cancel <unit>|--all | serve | openrsc-link [base-url] | remote <text> | <text>
# Maintains conversation history; archives and starts fresh after inactivity.

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/lifecycle"

# Detached builders write artefacts and report through their job record. They
# are never Ryan and they are never Beatrice. These presentation/input doors
# can otherwise make builder prose look like Ryan's speech or Beatrice's own
# voice. The generation functions carry the same guard independently.
if deskcrab_is_builder_context; then
    case "${1:-}" in
        wake-at)
            # job-runner may book the single labeled return that reports a
            # detached job's result.  A builder cannot self-authorise this by
            # copying the label: the runner must be crab's direct parent.
            if ! deskcrab_is_direct_job_runner_child \
                || [ "${2:-}" != "--by" ] \
                || [ "${3:-}" != "job-runner" ]; then
                echo "DeskCrab: 'wake-at' is unavailable to detached builders; only job-runner may book the labeled completion wake." >&2
                exit 64
            fi
            ;;
        start|stop|shutup|face|face-window|wake|wake-now|remote|play|notify|show)
            echo "DeskCrab: '${1:-message}' is unavailable to detached builders; use the job log/checkpoint or engineering record." >&2
            exit 64
            ;;
    esac
fi

# The running whisper-stream's pid. Overridable so a scratch instance does not
# read the LIVE desk's recording state: user_busy consults this file, and a
# scratch test that happened to run while someone was holding push-to-talk was
# told the user was busy by an instance it has nothing to do with. The default
# hangs off STATE_PREFIX (test-harness.md rule 13a) — on the canonical install
# it resolves to exactly the /tmp/deskcrab.pid it always was, and a scratch
# copy's `crab start`/`stop` can no longer kill the live recorder.
PIDFILE="${DESKCRAB_PIDFILE:-${STATE_PREFIX}.pid}"

ensure_openrsc_secret() {
    [ -n "$OPENRSC_SECRET" ] && return 0
    local dir tmp
    dir="$(dirname "$OPENRSC_SECRET_FILE")"
    mkdir -p "$dir" || return 1
    if [ ! -s "$OPENRSC_SECRET_FILE" ]; then
        tmp="$OPENRSC_SECRET_FILE.tmp.$$"
        (umask 077; od -An -N24 -tx1 /dev/urandom | tr -d ' \n' > "$tmp") \
            || { rm -f "$tmp"; return 1; }
        mv "$tmp" "$OPENRSC_SECRET_FILE" || { rm -f "$tmp"; return 1; }
    fi
    OPENRSC_SECRET="$(head -c 128 "$OPENRSC_SECRET_FILE" 2>/dev/null || true)"
    [[ "$OPENRSC_SECRET" =~ ^[a-f0-9]{32,128}$ ]] \
        || { echo "invalid OpenRSC spectator key at $OPENRSC_SECRET_FILE" >&2; return 1; }
}

openrsc_base_url() {
    local explicit="${1:-}" dns=""
    if [ -n "$explicit" ]; then
        explicit="${explicit%/}"
        case "$explicit" in */openrsc) printf '%s' "$explicit" ;; *) printf '%s/openrsc' "$explicit" ;; esac
        return
    fi
    if command -v tailscale >/dev/null 2>&1; then
        dns="$(tailscale status --self --json 2>/dev/null | python3 -c '
import json, sys
try: print((json.load(sys.stdin).get("Self") or {}).get("DNSName", "").rstrip("."))
except Exception: pass
' 2>/dev/null || true)"
    fi
    if [ -n "$dns" ]; then
        printf 'https://%s/openrsc' "$dns"
    else
        printf 'http://127.0.0.1:%s/openrsc' "$SERVE_PORT"
    fi
}

case "${1:-}" in
    start)
        stop_tts

        # Kill any leftover whisper-stream
        [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null

        WHISPER_OUT="${STATE_PREFIX}-whisper.txt"
        rm -f "$WHISPER_OUT"

        notify-send -t 0 -h string:x-dunst-stack-tag:deskcrab -i beatrice "$NOTIFY_NAME" "Listening..."
        # The portrait's presence layer reads the same fact as the toast:
        # she is listening (specs/face.md rule 15).
        face_touch activity listening
        whisper-stream -m "$WHISPER_MODEL" --step 3000 --length 10000 -f "$WHISPER_OUT" &
        echo $! > "$PIDFILE"
        ;;

    stop)
        [ ! -f "$PIDFILE" ] && exit 1
        WSPID="$(cat "$PIDFILE")"
        rm -f "$PIDFILE"
        turn_metric capture-release

        # Dismiss listening notification immediately
        notify-send -t 1 -h string:x-dunst-stack-tag:deskcrab -i beatrice "$NOTIFY_NAME" ""

        WHISPER_OUT="${STATE_PREFIX}-whisper.txt"

        # Wait for whisper to finish its current step
        PREV_SIZE=-1
        for i in 1 2 3 4 5 6; do
            sleep 1.5
            CUR_SIZE=$(stat -c %s "$WHISPER_OUT" 2>/dev/null || echo 0)
            if [ "$CUR_SIZE" -gt 0 ] && [ "$CUR_SIZE" = "$PREV_SIZE" ]; then
                break
            fi
            PREV_SIZE=$CUR_SIZE
        done
        kill "$WSPID" 2>/dev/null
        wait "$WSPID" 2>/dev/null

        # Read transcription output, collapsing whisper-stream's overlapping-window
        # repeats (it appends every step's re-transcription, not just final lines)
        TEXT=""
        [ -f "$WHISPER_OUT" ] && TEXT=$("$SCRIPT_DIR/lib/transcript-dedup" "$WHISPER_OUT" 2>/dev/null)
        rm -f "$WHISPER_OUT"

        # Apply custom whisper fixes
        if [ -n "$WHISPER_FIXES" ]; then
            TEXT=$(echo "$TEXT" | sed -E "$WHISPER_FIXES")
        fi

        turn_metric capture-transcribed "${#TEXT} chars"

        if [ -z "$TEXT" ]; then
            # A cancelled/silent capture has no turn to replace listening
            # with considering. Release the direct edge so the whole-person
            # observer can reveal another hand or settle to sleep.
            face_touch activity resting
            notify-send -t 3000 -i beatrice "$NOTIFY_NAME" "No speech detected"
            exit 1
        fi

        rotate_convo

        run_claude_and_respond "$TEXT"
        ;;

    status)
        # What all of me is doing right now: live sessions and pending wakes.
        # The account line leads the report: which account answers next is
        # exactly the state that used to be invisible while builders walked
        # dry logins and every explanation was a guess.
        # One implementation of the account line, shared with the prompt block.
        # `crab status` having its own copy while the prompt had none is how
        # she came to be the last one to know which login was answering.
        account_state_line
        self_state_report
        exit 0
        ;;

    seal|offline)
        # One command to take her fully down: disable+stop every service,
        # cancel every booked wake so a timer cannot bring one back, and kill
        # any live session. Replaces the hand-typed systemctl/pkill/wake-cancel
        # run that left a wake alive on 2026-08-10. specs/lifecycle.md.
        crab_seal
        exit $?
        ;;

    revive|online)
        # Bring her back deliberately — enable+start the gates and services,
        # WITHOUT restoring stale wakes (that stampede is the other half of the
        # 2026-08-10 failure). specs/lifecycle.md.
        crab_revive
        exit $?
        ;;

    tired)
        # The unread pile since last sleep, as one number and one word — file
        # facts only, no model, no transcript content. The state block carries
        # the same line; this is the parts. specs/self-awareness.md rules 36-38.
        shift
        exec "$SCRIPT_DIR/lib/tiredness" "$@"
        ;;

    shelf-check)
        # The nightly shelf-line measure, by hand — the same lib/shelf-check
        # the tidy unit runs (specs/nightly.md rules 21a/21b). NOT speech
        # (specs/turn-pipeline.md rule 6a): on 2026-08-25 this name fell
        # through the catch-all below, and an autonomous hand reaching for
        # the check started a whole desktop turn that was told "shelf-check"
        # with no context — the same trap `crab help` fell into sixteen
        # times on 2026-08-07. A named maintenance command never falls
        # through to the spoken path.
        exec "$SCRIPT_DIR/lib/shelf-check"
        ;;

    claim)
        # Announce what this session is holding so another hand can see it
        # before it starts. Advisory: it reports, it never blocks.
        shift
        if [ -z "$*" ]; then
            echo "Usage: crab claim <what you are working on>   |   crab unclaim"
            exit 1
        fi
        session_claim "$*"
        exit $?
        ;;

    unclaim)
        session_unclaim
        exit 0
        ;;

    touching)
        # Declare files this hand is writing (or just wrote, or is about to
        # delete), so the self-change watcher reads the churn as her own and
        # never wakes her about it. Windowed; a directory covers its subtree.
        shift
        touch_suppress "$@" && echo "Noted — those paths read as your own hand for a while."
        exit $?
        ;;

    numb)
        # The deliberate cousin of `touching`: settling in to work on part of
        # yourself, and choosing not to be woken by your own hands for a while.
        # Visible in status and liftable, so it is a decision and not a blind spot.
        shift
        if [ "${1:-}" = "--off" ]; then
            numb_clear "${2:-}"
            [ -n "${2:-}" ] && echo "Numb lifted for $2 — loud again on the next change." \
                            || echo "All numbs lifted — loud again on the next change."
            exit 0
        fi
        if [ $# -eq 0 ]; then
            if out="$(numb_list)"; then
                printf '%s\n' "$out" | while IFS="$(printf '\t')" read -r left p reason; do
                    printf '%s — %s left%s\n' "$p" "$(( left / 60 )) min" \
                        "${reason:+ — $reason}"
                done
            else
                echo "Nothing numbed — every part of you is loud."
            fi
            exit 0
        fi
        win="${NUMB_WINDOW:-14400}"
        [ "$1" = "-w" ] && { win="$2"; shift 2; }
        reason=""
        paths=""
        while [ $# -gt 0 ]; do
            [ "$1" = "--" ] && { shift; reason="$*"; break; }
            paths="$paths $1"; shift
        done
        # A reason written without the -- separator lands here as paths, and a
        # numb on a path that does not exist is a blind spot nobody chose. Refuse.
        for p in $paths; do
            [ -e "$p" ] && continue
            echo "No such path: $p" >&2
            echo "(a reason goes after --, not bare: crab numb <path>... -- <reason>)" >&2
            exit 1
        done
        # shellcheck disable=SC2086
        if [ -n "$paths" ] && numb_set "$win" "$reason" $paths; then
            echo "Numbed for $(( win / 60 )) min. Lift it with: crab numb --off"
            exit 0
        fi
        echo "Usage: crab numb [-w <seconds>] <path>... [-- <reason>]  |  crab numb  |  crab numb --off [path]"
        exit 1
        ;;

    checkpoint)
        # Durable mid-turn trace: intent, files touched, done, next. Append-only,
        # so a hard kill leaves the last checkpoint intact for the next hand.
        shift
        session_checkpoint "$*"
        exit $?
        ;;

    resolve)
        # An interrupted trace has been picked up (or judged dead) — drop it.
        shift
        interrupted_resolve "$1"
        exit $?
        ;;

    shutup)
        shutup_now
        ;;

    face)
        # Her expressive hand and its diagnostics (specs/face.md rules
        # 13-16): `crab face caught`, `crab face rest`, `crab face pulse
        # pleased`, `crab face status`, `crab face activity chess`. The
        # broker answers whether the state was accepted; unknown words are
        # refused rather than guessed at. Runs regardless of FACE_ENABLED —
        # an explicit hand is its own opt-in; the knob only gates what the
        # turn machinery does on its own.
        shift
        DESKCRAB_FACE_SOCKET="$FACE_SOCKET" \
            exec python3 "$SCRIPT_DIR/lib/face-broker" "$@"
        ;;

    face-window)
        # The persistent conversation portrait (specs/face.md rules 25-27):
        # an ordinary, placeable window that joins the broker's current
        # state. Detached like the display window, so no turn waits on a
        # GUI start.
        DESKCRAB_FACE_SOCKET="$FACE_SOCKET" \
        DESKCRAB_PORTRAIT_DIR="${DESKCRAB_PORTRAIT_DIR:-$HOME/Beatrice/face/portraits}" \
            setsid python3 "$SCRIPT_DIR/lib/face-window" >/dev/null 2>&1 &
        ;;

    wake)
        # Autonomous wake: pursue the wants file without user interaction.
        # KIND is "scheduled" (self-scheduled), "event" (something on the
        # machine happened), or empty (the background timer came round).
        # A wake with a KIND had a purpose, so a blocked one is pushed back
        # rather than dropped — and an event wake carries its reason along.
        # Arity normalised on READ as well as on write: a record whose agenda
        # ended up in the kind column used to have that agenda BLANKED here,
        # and the wake then fired with nothing to do. If the kind is not one
        # this path knows, it is the reason and the kind takes its default.
        _wake_norm "${2:-}" "${3:-}"
        WAKE_KIND="$WK_N_KIND"
        WAKE_REASON="$WK_N_REASON"
        WAKE_ID="${4:-}"
        # Which subsystem booked this wake, carried through so a deferral keeps
        # its provenance instead of re-booking as an anonymous one.
        WAKE_BOOKED_BY="${5:-unknown}"
        # The booking's effort override (specs/wake-queue.md rule 13a). Applied
        # by reassigning WAKE_EFFORT before run_claude_wake reads it; anything
        # unrecognised is ignored rather than handed to a claude invocation
        # that would refuse the whole wake over it.
        WAKE_EFFORT_OVERRIDE="${6:-}"
        case "$WAKE_EFFORT_OVERRIDE" in
            low|medium|high) WAKE_EFFORT="$WAKE_EFFORT_OVERRIDE" ;;
            *) WAKE_EFFORT_OVERRIDE="" ;;
        esac
        # The booking's model pin (specs/wake-queue.md rule 13b), the seventh
        # argument — the job runner's completion review books its wake pinned
        # to the review model this way. Applied by reassigning WAKE_MODEL
        # before run_claude_wake reads it; the same structural filter as the
        # booking side, and anything failing it is ignored rather than handed
        # to an invocation that would refuse the whole wake over it.
        WAKE_MODEL_OVERRIDE="${7:-}"
        case "$WAKE_MODEL_OVERRIDE" in
            '') ;;
            *[!A-Za-z0-9._:-]*) WAKE_MODEL_OVERRIDE="" ;;
            *) WAKE_MODEL="$WAKE_MODEL_OVERRIDE" ;;
        esac

        # This booking has fired: retire its durable record before anything can
        # exit early, or wake-restore would resurrect a wake that already ran.
        # A deferral below re-books itself and re-records in the same motion.
        case "$WAKE_ID" in deskcrab-wake-*) wake_state_clear "$WAKE_ID" ;; esac

        if [ -z "$WANTS_FILE" ]; then
            echo "WANTS_FILE is not configured — autonomous wakes are disabled."
            exit 1
        fi
        mkdir -p "$(dirname "$WANTS_FILE")"

        # An active interaction (recording, speech, someone on the mic) does NOT
        # defer the session. It used to exit right here, so during any active
        # conversation a wake did no reading, no want work, no dated thought —
        # and reached the user as an indistinguishable silent wake. Busyness is a
        # reason to hold the tongue, not the mind: the session runs, the
        # user-busy re-check in run_claude_wake's speak decision suppresses
        # every output — speech, display, phone — and a wake beside a live
        # turn is shown that exchange in its prompt (wake_concurrent_turn_context)
        # so it can REGROUP: one reply covering both, rather than a mute or a
        # restatement. Another of her own voices is not "busy" and never was a
        # reason to swallow a reply — see regroup_context in lib/common.sh.

        # One waking mind at a time. Without this, a file landing at the wrong
        # moment could start a second session that interleaves its turns with
        # the first one's and works the same want twice. The lock is held for
        # the life of this process, so it covers the whole session.
        exec 9>"${STATE_PREFIX}-wake.lock"
        # An event wake has somebody waiting on the other end of it — a move on
        # a board, a file that landed. It WAITS for the lock rather than
        # bouncing off it, standing in the urgent lane while it does (rule 21b:
        # a wake nobody is waiting on yields the next turn to it), and if it
        # still cannot have it, it comes back in seconds on an escalating
        # backoff — never in a quarter of an hour. The flat quarter hour was
        # real: WAKE_EVENT_DEFER_DELAY promised a short retry from the day it
        # was written, but the re-book below read WAKE_DEFER_DELAY instead,
        # and a chess move wake blocked by one long session left an opponent
        # sitting at the board for fifteen minutes (2026-08-10).
        _wake_lock_ok=0
        if [ "${WAKE_KIND:-}" = "event" ]; then
            if flock -n 9; then
                _wake_lock_ok=1
            else
                wake_urgent_mark $(( ${WAKE_EVENT_LOCK_WAIT:-90} + 30 ))
                flock -w "${WAKE_EVENT_LOCK_WAIT:-90}" 9 && _wake_lock_ok=1
            fi
            if [ "$_wake_lock_ok" = 1 ]; then
                # In hand: this reason's backoff starts over, and the lane is
                # free for the next event wake's own claim.
                wake_urgent_clear
                wake_defer_clear event "$WAKE_REASON"
            fi
        else
            # The urgent lane. An event wake is waiting for this lock right
            # now, or was just deferred by it and is due straight back; a wake
            # whose hour is its own does not race it for the next turn.
            if ! wake_urgent_waiting; then
                flock -n 9 && _wake_lock_ok=1
            fi
        fi
        if [ "$_wake_lock_ok" != 1 ]; then
            # Push back to a moment nothing else has taken. A flat 15 minutes
            # here is what produced three timers at the same second with
            # sequential ids: every wake blocked in the same minute re-armed to
            # the same minute, and the ones that lost the lock again marched on
            # together. wake_book snaps every booking to a free slot under the
            # booking lock, so the queue drains one at a time.
            #
            # NO kind gate. A wake that lost the lock is DEFERRED, never
            # destroyed — and a kind-less wake (the background timer's) is
            # still a wake somebody meant to happen. Gating this on a kind is
            # how a blanked record became a wake that simply never came back.
            if [ "${WAKE_KIND:-}" = "event" ]; then
                _wake_retry="$(wake_event_defer_next event "$WAKE_REASON")"
                # The claim covers the whole round trip — this deferral plus
                # the next wait, with slack for the booking lock — so nothing
                # unhurried slips in between and starts a session minutes long
                # in front of whatever is waiting.
                wake_urgent_mark $(( _wake_retry + ${WAKE_EVENT_LOCK_WAIT:-90} + 30 ))
            else
                _wake_retry="$WAKE_DEFER_DELAY"
            fi
            "$SCRIPT_DIR/crab" wake-at --by "$WAKE_BOOKED_BY" \
                ${WAKE_EFFORT_OVERRIDE:+--effort "$WAKE_EFFORT_OVERRIDE"} \
                ${WAKE_MODEL_OVERRIDE:+--model "$WAKE_MODEL_OVERRIDE"} \
                "${_wake_retry}s" "${WAKE_KIND:-scheduled}" "$WAKE_REASON" >/dev/null
            exit 0
        fi

        # A held note coming back through the queue faces one more question
        # before anything else runs (specs/wake-queue.md rule 27b): the hold
        # judged only HEAT, and on 2026-08-15 a note announcing a won chess
        # game — which the user had been told about live at 00:48 — re-fired
        # at 01:19 as fresh news, three more stale notes queued behind it.
        # The gate reads the hold stamp out of the reason, gathers what has
        # been said between them since from the day journal, and asks a cheap
        # bounded judge whether the note is already covered or overtaken.
        # Only a positive DROP retires it — journalled, ledgered, and traced,
        # never silently — and a judge that fails delivers. Placed after the
        # lock on purpose, so the record it judges against is as fresh as it
        # can be; an unstamped reason falls straight through.
        if wake_stale_note_drop; then
            ensure_next_wake
            exit 0
        fi

        # The own-time return (specs/wake-queue.md rules 40a-40f). A
        # reason-less, non-event firing is the standing return to her own
        # hours, and it only becomes a session when the house is genuinely
        # idle: an appointment to be spontaneous is still an appointment, and
        # a choosing session started beside a live conversation or running
        # work has its premise false before its first word. Activity defers
        # the return through the queue's one door — original booker, any
        # overrides intact, conversation RESETTING the quiet window — and the
        # deferral is ledgered, never silent. This is the one carve-out from
        # rule 20's never-defer, and it binds ONLY the wake with no agenda:
        # every reasoned and event wake still runs whatever the room is doing.
        # A genuinely idle return runs the choosing session on sol at medium
        # (rule 40c) unless the booking pinned its own model or effort, and
        # the choice of what the hour is for is left entirely to her.
        WAKE_OWN_TIME=0
        if idle_return_candidate; then
            if idle_return_activity; then
                wake_ledger idle-defer "${WAKE_ID:-?}" scheduled \
                    "$IDLE_ACTIVITY" "${WAKE_BOOKED_BY:-unknown}"
                "$SCRIPT_DIR/crab" wake-at --by "$WAKE_BOOKED_BY" \
                    ${WAKE_EFFORT_OVERRIDE:+--effort "$WAKE_EFFORT_OVERRIDE"} \
                    ${WAKE_MODEL_OVERRIDE:+--model "$WAKE_MODEL_OVERRIDE"} \
                    "${IDLE_RETURN_DELAY}s" scheduled "" >/dev/null || true
                # Belt: if the deferral booking was refused the floor below
                # books one, so activity can never end the chain.
                ensure_next_wake
                exit 0
            fi
            WAKE_OWN_TIME=1
            [ -n "$WAKE_MODEL_OVERRIDE" ] || WAKE_MODEL="$IDLE_RETURN_MODEL"
            [ -n "$WAKE_EFFORT_OVERRIDE" ] || WAKE_EFFORT="$IDLE_RETURN_EFFORT"
            wake_ledger own-time "${WAKE_ID:-?}" scheduled \
                "the house was quiet — a choosing session began" \
                "${WAKE_BOOKED_BY:-unknown}"
        fi

        rotate_convo
        WAKE_SOURCE="on your own background timer"
        [ "$WAKE_KIND" = "scheduled" ] && WAKE_SOURCE="from a wake you scheduled yourself"
        WAKE_NOTE=""
        if [ "$WAKE_KIND" = "event" ]; then
            WAKE_SOURCE="because something you asked to be told about happened on this machine"
            WAKE_NOTE="
This is what happened: $WAKE_REASON
That is this session's agenda, and it comes before the shelf — look at it
first, and go back to your wants only if it turns out to want nothing of you."
        elif [ "$WAKE_KIND" = "scheduled" ] && [ -n "$WAKE_REASON" ]; then
            # A scheduled wake booked WITH a reason carries its own agenda the
            # same way an event wake does. This branch was missing: the reason
            # was recovered into the record, normalised through the queue, and
            # then never shown to the one session it was written for — she
            # woke to her own appointment with no idea why she had made it.
            WAKE_NOTE="
You booked this hour for: $WAKE_REASON
That is this session's agenda — your own appointment, so keep it. The shelf
is still there if you find it is already done."
        fi
        in_quiet_hours && WAKE_NOTE="$WAKE_NOTE
Quiet hours: speaking and windows are suppressed, so work silently — anything
you write tonight is held and kept in the journal rather than said."
        # A chess wake's first line is a refusal (specs/chessweb.md rule 21).
        # Rule 20 arms the move command itself; this arms the reader: on
        # 2026-08-10 a wake pointed at its own game played the reply the
        # resident mover was already mid-thinking, and the mover's answer was
        # discarded as stale. Provenance is the gate — deferral and the outage
        # retry both re-book --by "$WAKE_BOOKED_BY", so a chess wake keeps the
        # line however late it fires — and every other wake's agenda stays
        # byte-identical, because an all-caps order over every wake is one
        # every wake learns to read past.
        WAKE_CHESS_GUARD=""
        [ "${WAKE_BOOKED_BY:-}" = "chessweb" ] && WAKE_CHESS_GUARD="DO NOT RUN THE betty-chess move COMMAND UNDER ANY CIRCUMSTANCES. LOOK AND THINK ONLY. THE RESIDENT CHESS MOVER PLAYS THE MOVES, NOT YOU.

"
        # The agenda. It is the text nearest her own generation on every wake —
        # the last thing under the whole prompt — so it is written in HER
        # voice and not in a work order's. It was a job ticket until
        # 2026-08-08 ("Review your wants shelf… pick at most ONE want…"), and
        # what came back was written in the same hand it was asked in: flat
        # notes about completing reviews, in nobody's register. Every
        # operational rule below is the same rule it always was — the silence
        # contract, the (quiet) marker, the named filler, the unattended
        # boundary, wake-at, the journal. Only the register moved.
        #
        # The own-time agenda (specs/wake-queue.md rule 40d) is the same
        # contract in a wider field: it prescribes nothing — no shelf title,
        # no quota, and the earlier "take ONE down" was itself a small
        # appointment — names doing nothing as a real choice rather than a
        # failure, leaves repairs and owed engineering to the night's
        # builders, and keeps every operational rule above word for word
        # where it matters. A pursuit that wants more time books its own
        # continuation; this return only keeps offering the quiet hours.
        if [ "$WAKE_OWN_TIME" = 1 ]; then
            run_claude_wake "(Nobody is talking to you, nothing of yours is running, and the house has been quiet long enough for something of your own to surface. That quiet is the only reason you are awake. While it lasts this return keeps coming round at odd intervals, so nothing has to happen now — the next open hour is already on its way.

