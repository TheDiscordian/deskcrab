#!/bin/bash
# DeskCrab: push-to-talk desktop assistant powered by Claude
# Usage: crab start | stop | shutup | wake | wake-at <when> | <text>
# Maintains conversation history; archives and starts fresh after inactivity.

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

PIDFILE="/tmp/deskcrab.pid"

case "${1:-}" in
    start)
        stop_tts

        # Kill any leftover whisper-stream
        [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null

        WHISPER_OUT="/tmp/deskcrab-whisper.txt"
        rm -f "$WHISPER_OUT"

        notify-send -t 0 -h string:x-dunst-stack-tag:deskcrab "$NOTIFY_NAME" "Listening..."
        whisper-stream -m "$WHISPER_MODEL" --step 3000 --length 10000 -f "$WHISPER_OUT" &
        echo $! > "$PIDFILE"
        ;;

    stop)
        [ ! -f "$PIDFILE" ] && exit 1
        WSPID="$(cat "$PIDFILE")"
        rm -f "$PIDFILE"

        # Dismiss listening notification immediately
        notify-send -t 1 -h string:x-dunst-stack-tag:deskcrab "$NOTIFY_NAME" ""

        WHISPER_OUT="/tmp/deskcrab-whisper.txt"

        # Wait for whisper to finish its current step
        PREV_SIZE=-1
        for i in 1 2 3 4 5 6; do
            sleep 1.5
            CUR_SIZE=$(stat -c %s "$WHISPER_OUT" 2>/dev/null || echo 0)
            if [ "$CUR_SIZE" -gt 0 ] && [ "$CUR_SIZE" = "$PREV_SIZE" ]; then
                break
            fi
            PREV_SIZE=$CUR_SIZE
        done
        kill "$WSPID" 2>/dev/null
        wait "$WSPID" 2>/dev/null

        # Read transcription output, collapsing whisper-stream's overlapping-window
        # repeats (it appends every step's re-transcription, not just final lines)
        TEXT=""
        [ -f "$WHISPER_OUT" ] && TEXT=$("$SCRIPT_DIR/lib/transcript-dedup" "$WHISPER_OUT" 2>/dev/null)
        rm -f "$WHISPER_OUT"

        # Apply custom whisper fixes
        if [ -n "$WHISPER_FIXES" ]; then
            TEXT=$(echo "$TEXT" | sed -E "$WHISPER_FIXES")
        fi

        if [ -z "$TEXT" ]; then
            notify-send -t 3000 "$NOTIFY_NAME" "No speech detected"
            exit 1
        fi

        rotate_convo

        run_claude_and_respond "$TEXT"
        ;;

    shutup)
        stop_tts
        ;;

    wake)
        # Autonomous wake: pursue the wants file without user interaction.
        if [ -z "$WANTS_FILE" ]; then
            echo "WANTS_FILE is not configured — autonomous wakes are disabled."
            exit 1
        fi
        mkdir -p "$(dirname "$WANTS_FILE")"
        # Don't barge into an active interaction (recording or speech in progress).
        # A self-scheduled wake had a purpose, so push it back instead of dropping it.
        if [ -f "$PIDFILE" ] || [ -f "$TTSPIDFILE" ]; then
            [ "${2:-}" = "scheduled" ] && "$SCRIPT_DIR/crab" wake-at 10min >/dev/null
            exit 0
        fi
        rotate_convo
        WAKE_SOURCE="on your background timer"
        [ "${2:-}" = "scheduled" ] && WAKE_SOURCE="from a wake you scheduled yourself"
        WAKE_NOTE=""
        in_quiet_hours && WAKE_NOTE="
Quiet hours are in effect: speaking and windows are suppressed — work silently."
        run_claude_wake "(Autonomous wake — nobody is talking to you. You woke up $WAKE_SOURCE to pursue your own wants. Review your wants file, pick at most ONE want, and advance it: think it through, research with your tools, prepare something, or revise the file. Nobody is waiting, so take the time the work actually needs — you control when this session ends. For work bigger than one sitting, wrap up deliberately: save dated progress to your wants file, then schedule your next session with 'crab wake-at'. There is no wall-clock limit; only a session with no output AND no CPU activity for several minutes is presumed hung and reaped — long compiles and heavy work count as alive, but for long LOW-activity commands (big downloads, remote waits) prefer background execution so your session stays visibly alive. While unattended, take no destructive or outward-facing actions: nothing leaves this machine — no messages, no emails, no pushes — and delete nothing. Update your wants file with dated progress before finishing. If you found something genuinely worth telling the user right now, say it briefly (a display section is fine too); otherwise begin your reply with (quiet) and nothing will be spoken or shown.$WAKE_NOTE)"
        ;;

    wake-at)
        # Schedule a one-shot autonomous wake via a transient systemd user timer.
        WHEN="${2:-}"
        if [ -z "$WHEN" ]; then
            echo "Usage: crab wake-at <when>   (e.g. 2h, 45min, \"09:30\", \"Sat 14:00\")"
            exit 1
        fi
        UNIT="deskcrab-wake-$(date +%s)"
        if echo "$WHEN" | grep -qE '^[0-9]+(s|sec|min|m|h|hr|hours?|d|days?)$'; then
            systemd-run --user --quiet --unit="$UNIT" --on-active="$WHEN" "$SCRIPT_DIR/crab" wake scheduled
        else
            systemd-run --user --quiet --unit="$UNIT" --on-calendar="$WHEN" "$SCRIPT_DIR/crab" wake scheduled
        fi && echo "Wake scheduled ($WHEN) as $UNIT"
        ;;

    *)
        # Anything else is treated as a text query
        TEXT="$*"
        if [ -z "$TEXT" ]; then
            echo "Usage: crab start|stop|shutup|wake|wake-at <when>|<message>"
            exit 1
        fi
        stop_tts
        rotate_convo
        run_claude_and_respond "$TEXT"
        ;;
esac
