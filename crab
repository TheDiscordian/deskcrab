#!/bin/bash
# DeskCrab: push-to-talk desktop assistant powered by Claude
# Usage: crab start | stop | status | shutup | job <desc> | jobs | wake | wake-at <when> | serve | remote <text> | <text>
# Maintains conversation history; archives and starts fresh after inactivity.

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

PIDFILE="/tmp/deskcrab.pid"

case "${1:-}" in
    start)
        stop_tts

        # Kill any leftover whisper-stream
        [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null

        WHISPER_OUT="/tmp/deskcrab-whisper.txt"
        rm -f "$WHISPER_OUT"

        notify-send -t 0 -h string:x-dunst-stack-tag:deskcrab "$NOTIFY_NAME" "Listening..."
        whisper-stream -m "$WHISPER_MODEL" --step 3000 --length 10000 -f "$WHISPER_OUT" &
        echo $! > "$PIDFILE"
        ;;

    stop)
        [ ! -f "$PIDFILE" ] && exit 1
        WSPID="$(cat "$PIDFILE")"
        rm -f "$PIDFILE"

        # Dismiss listening notification immediately
        notify-send -t 1 -h string:x-dunst-stack-tag:deskcrab "$NOTIFY_NAME" ""

        WHISPER_OUT="/tmp/deskcrab-whisper.txt"

        # Wait for whisper to finish its current step
        PREV_SIZE=-1
        for i in 1 2 3 4 5 6; do
            sleep 1.5
            CUR_SIZE=$(stat -c %s "$WHISPER_OUT" 2>/dev/null || echo 0)
            if [ "$CUR_SIZE" -gt 0 ] && [ "$CUR_SIZE" = "$PREV_SIZE" ]; then
                break
            fi
            PREV_SIZE=$CUR_SIZE
        done
        kill "$WSPID" 2>/dev/null
        wait "$WSPID" 2>/dev/null

        # Read transcription output, collapsing whisper-stream's overlapping-window
        # repeats (it appends every step's re-transcription, not just final lines)
        TEXT=""
        [ -f "$WHISPER_OUT" ] && TEXT=$("$SCRIPT_DIR/lib/transcript-dedup" "$WHISPER_OUT" 2>/dev/null)
        rm -f "$WHISPER_OUT"

        # Apply custom whisper fixes
        if [ -n "$WHISPER_FIXES" ]; then
            TEXT=$(echo "$TEXT" | sed -E "$WHISPER_FIXES")
        fi

        if [ -z "$TEXT" ]; then
            notify-send -t 3000 "$NOTIFY_NAME" "No speech detected"
            exit 1
        fi

        rotate_convo

        run_claude_and_respond "$TEXT"
        ;;

    status)
        # What all of me is doing right now: live sessions and pending wakes.
        self_state_report
        exit 0
        ;;

    claim)
        # Announce what this session is holding so another hand can see it
        # before it starts. Advisory: it reports, it never blocks.
        shift
        if [ -z "$*" ]; then
            echo "Usage: crab claim <what you are working on>   |   crab unclaim"
            exit 1
        fi
        session_claim "$*"
        exit $?
        ;;

    unclaim)
        session_unclaim
        exit 0
        ;;

    checkpoint)
        # Durable mid-turn trace: intent, files touched, done, next. Append-only,
        # so a hard kill leaves the last checkpoint intact for the next hand.
        shift
        session_checkpoint "$*"
        exit $?
        ;;

    resolve)
        # An interrupted trace has been picked up (or judged dead) — drop it.
        shift
        interrupted_resolve "$1"
        exit $?
        ;;

    shutup)
        stop_tts
        ;;

    wake)
        # Autonomous wake: pursue the wants file without user interaction.
        if [ -z "$WANTS_FILE" ]; then
            echo "WANTS_FILE is not configured — autonomous wakes are disabled."
            exit 1
        fi
        mkdir -p "$(dirname "$WANTS_FILE")"

        # KIND is "scheduled" (self-scheduled), "event" (something on the
        # machine happened), or empty (the background timer came round).
        # A wake with a KIND had a purpose, so a blocked one is pushed back
        # rather than dropped — and an event wake carries its reason along.
        WAKE_KIND="${2:-}"
        WAKE_REASON="${3:-}"
        [ "$WAKE_KIND" = "scheduled" ] || [ "$WAKE_KIND" = "event" ] || WAKE_KIND=""

        # Don't barge into an active interaction (recording or speech in progress).
        # A wake with a purpose is pushed back instead of dropped, reason intact.
        if user_busy; then
            [ -n "$WAKE_KIND" ] && "$SCRIPT_DIR/crab" wake-at 10min "$WAKE_KIND" "$WAKE_REASON" >/dev/null
            exit 0
        fi

        # One waking mind at a time. Without this, a file landing at the wrong
        # moment could start a second session that interleaves its turns with
        # the first one's and works the same want twice. The lock is held for
        # the life of this process, so it covers the whole session.
        exec 9>"${STATE_PREFIX}-wake.lock"
        if ! flock -n 9; then
            [ -n "$WAKE_KIND" ] && "$SCRIPT_DIR/crab" wake-at 15min "$WAKE_KIND" "$WAKE_REASON" >/dev/null
            exit 0
        fi

        rotate_convo
        WAKE_SOURCE="on your background timer"
        [ "$WAKE_KIND" = "scheduled" ] && WAKE_SOURCE="from a wake you scheduled yourself"
        WAKE_NOTE=""
        if [ "$WAKE_KIND" = "event" ]; then
            WAKE_SOURCE="because something you asked to be told about happened on this machine"
            WAKE_NOTE="
What happened: $WAKE_REASON
That is this session's agenda — look into it first. Only fall back to your
wants shelf if it turns out to need nothing from you."
        fi
        in_quiet_hours && WAKE_NOTE="$WAKE_NOTE
Quiet hours are in effect: speaking and windows are suppressed — work silently."
        run_claude_wake "(Autonomous wake — nobody is talking to you. You woke up $WAKE_SOURCE to pursue your own wants. Review your wants shelf (one line per want; each want's living document is under wants/), pick at most ONE want, and advance it: think it through, research with your tools, prepare something, or revise its document. Nobody is waiting, so take the time the work actually needs — you control when this session ends. For work bigger than one sitting, wrap up deliberately: save dated progress to that want's document, then schedule your next session with 'crab wake-at'. There is no wall-clock limit; only a session with no output AND no CPU activity for several minutes is presumed hung and reaped — long compiles and heavy work count as alive, but for long LOW-activity commands (big downloads, remote waits) prefer background execution so your session stays visibly alive. While unattended, take no destructive or outward-facing actions: nothing leaves this machine — no messages, no emails, no pushes — and delete nothing. Record dated progress in the want's document (and update its shelf line if the status changed) before finishing. If you found something genuinely worth telling the user right now, say it briefly (a display section is fine too); otherwise begin your reply with (quiet) and nothing will be spoken or shown.$WAKE_NOTE)"
        # Never let the chain of self-scheduled wakes end. A wake that finished
        # without booking its own follow-up leaves open wants with nothing
        # coming back to them.
        ensure_next_wake
        ;;

    remote)
        # One turn from a remote client (crab serve). Prints a JSON object
        # {spoken, display, audio} on stdout and touches no desktop output
        # except a courtesy notification. --voice applies WHISPER_FIXES first,
        # because the text came from speech recognition on the phone.
        shift
        if [ "${1:-}" = "--voice" ]; then
            shift
            [ -n "$WHISPER_FIXES" ] && set -- "$(printf '%s' "$*" | sed -E "$WHISPER_FIXES")"
        fi
        TEXT="$*"
        if [ -z "$(printf '%s' "$TEXT" | tr -d '[:space:]')" ]; then
            echo '{"spoken":"","display":"","audio":"","error":"empty query"}'
            exit 1
        fi
        run_claude_remote "$TEXT"
        ;;

    synth)
        # Speak one line of text into an opus file, for crab serve's streaming
        # voice. Prints the path on success, nothing on failure.
        shift
        OUT="$1"; shift
        synth_opus "$*" "$OUT" && printf '%s\n' "$OUT"
        ;;

    serve)
        # Serve the phone client. The listener stays on loopback by default;
        # exposing it to a phone is a separate, deliberate step (Tailscale:
        #   tailscale serve --bg https / http://127.0.0.1:$SERVE_PORT
        # ) so nothing is ever published just by starting the server.
        [ -n "${2:-}" ] && SERVE_PORT="$2"
        if [ -z "$SERVE_SECRET" ]; then
            echo "SERVE_SECRET is not set in $CONF_FILE — refusing to serve."
            echo "Add a shared secret, e.g.:"
            echo "  SERVE_SECRET=\"$(head -c 18 /dev/urandom | base64 | tr -d '/+=')\""
            exit 1
        fi
        if [ -z "$SERVE_CERT" ] && [ "$SERVE_TLS" = "self" ]; then
            SERVE_CERT="$TLS_DIR/cert.pem"
            SERVE_KEY="$TLS_DIR/key.pem"
            "$SCRIPT_DIR/lib/gen-cert" "$TLS_DIR" || exit 1
        fi
        export DESKCRAB_SERVE_CERT="$SERVE_CERT" DESKCRAB_SERVE_KEY="$SERVE_KEY"
        export DESKCRAB_SERVE_PORT="$SERVE_PORT" DESKCRAB_SERVE_BIND="$SERVE_BIND" \
               DESKCRAB_SERVE_SECRET="$SERVE_SECRET" DESKCRAB_WHISPER_MODEL="$WHISPER_MODEL" \
               DESKCRAB_NOTIFY_NAME="$NOTIFY_NAME" DESKCRAB_ASSISTANT_NAME="$ASSISTANT_NAME" \
               DESKCRAB_SERVE_TIMEOUT="$SERVE_TIMEOUT" DESKCRAB_CRAB_BIN="$SCRIPT_DIR/crab" \
               DESKCRAB_STATE_PREFIX="$STATE_PREFIX" DESKCRAB_WHISPER_FIXES="$WHISPER_FIXES"
        exec python3 "$SCRIPT_DIR/lib/serve.py"
        ;;

    job)
        # Detached work: dispatched to systemd, it survives the end of this
        # turn and never holds the conversation open. `crab job` returns
        # instantly; the worker wakes the assistant with an event when it
        # finishes. `crab job log <id>` shows a job's output; anything else
        # after `job` is the description of the work itself.
        shift
        if [ "${1:-}" = "log" ] && [ -n "${2:-}" ] && [ -e "$JOBS_DIR/$2.json" ]; then
            if [ -f "$JOBS_DIR/$2.log" ]; then cat "$JOBS_DIR/$2.log"; else echo "Job $2 has produced no output yet."; fi
            exit 0
        fi
        job_start "$@"
        exit $?
        ;;

    jobs)
        # What is running detached right now and what finished while nobody
        # was looking.
        echo "Detached jobs (logs in $JOBS_DIR):"
        jobs_report
        exit 0
        ;;

    wake-at)
        # Schedule a one-shot autonomous wake via a transient systemd user timer.
        WHEN="${2:-}"
        if [ -z "$WHEN" ]; then
            echo "Usage: crab wake-at <when> [kind] [reason]   (e.g. 2h, 45min, \"09:30\", \"Sat 14:00\")"
            exit 1
        fi
        # A deferred wake keeps whatever kind and reason it started with, so an
        # event wake pushed back past a recording still arrives knowing why.
        KIND="${3:-scheduled}"
        REASON="${4:-}"
        # $$ as well as the timestamp: two deferrals in the same second would
        # otherwise collide on the unit name and the second one would vanish.
        UNIT="deskcrab-wake-$(date +%s)-$$"
        if echo "$WHEN" | grep -qE '^[0-9]+(s|sec|min|m|h|hr|hours?|d|days?)$'; then
            systemd-run --user --quiet --unit="$UNIT" --on-active="$WHEN" "$SCRIPT_DIR/crab" wake "$KIND" "$REASON"
        else
            systemd-run --user --quiet --unit="$UNIT" --on-calendar="$WHEN" "$SCRIPT_DIR/crab" wake "$KIND" "$REASON"
        fi && echo "Wake scheduled ($WHEN) as $UNIT"
        ;;

    *)
        # Anything else is treated as a text query
        TEXT="$*"
        if [ -z "$TEXT" ]; then
            echo "Usage: crab start|stop|status|shutup|claim <what>|unclaim|checkpoint <note>|resolve <name>|job [-C <dir>] <desc>|job log <id>|jobs|wake|wake-at <when>|serve [port]|remote <text>|<message>"
            exit 1
        fi
        stop_tts
        rotate_convo
        run_claude_and_respond "$TEXT"
        ;;
esac
